<!doctype html>
<!-- Classic Tabby Task 14 (2026-11-10): Help audit against tabby-v04.1: strings that named removed pages, modes or actions (step editing, REC, SEQ pages, the sampler, "Enable force flash and reconnect") rewritten or deleted, in both languages; new chapter 00 "What changed in tabby-v04"; tests/workbench/help-banned.mjs guards it. Second pass: factory-restore sectors (70-79 of 80), the TRS jack is output only (CLK IN DIN), demo-sample line. English only (SPEC 17.7): the Chinese text is replaced by English at the source, the translation table and the language selector are gone. -->
<!-- Classic Tabby Task 13 Step 4 (2026-11-10): panel wording: knobs K1-K8 by their printed numbers (firmware SELECT = K5, PAGE = K6, PRESETS = K7, MASTER = K8); the firmware's SAVE button named by position (the 4th button in the left group, after SHIFT, FADER BANK, HOME); SPEC 17.4 has the table. -->
<!-- SPDX-License-Identifier: GPL-3.0-only WITH GPL-3.0-linking-exception -->
<html lang="en">
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="referrer" content="no-referrer">
<link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='6' fill='%2307060D'/%3E%3Cpath d='M4 16h4l3-9 5 18 5-18 3 9h4' fill='none' stroke='%237C3AED' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E">
<title>SMK37 OPEN Workbench</title>
<style>
/* Palette from https://www.m-vave.com/ (2026-10-17).
 * System fonts and inline CSS keep the downloaded workbench self-contained. */
:root{
 --bg-primary:#07060D;--bg-secondary:#0E0C1A;--bg-card:#12101F;--bg-card-hover:#1A1730;
 --text-primary:#F0EDF6;--text-secondary:#B0AAC0;--text-muted:#998FAE;
 --accent-purple:#7C3AED;--accent-purple-hover:#6D28D9;--accent-cyan:#06D6E0;
 --accent-orange:#F97316;--accent-green:#22C55E;--accent-pink:#EC4899;
 --purple-soft:#D6BCFA;--purple-wash:#201335;
 --line:#393148;--control-line:#62566F;--panel-raised:#292538;
 --accent:var(--accent-cyan);--muted:var(--text-muted);
}

:root{color-scheme:dark;font:15px/1.65 system-ui,-apple-system,"Segoe UI",sans-serif;background:var(--bg-primary);color:var(--text-primary);}
*{box-sizing:border-box}body{margin:0;background:radial-gradient(ellipse at 50% 25%,#28252c80,transparent 65%);min-height:100vh}main{max-width:1160px;margin:auto;padding:34px 36px 24px}header{display:flex;align-items:center;justify-content:space-between;gap:16px;font-size:11px;letter-spacing:.16em;color:var(--muted)}header b{color:var(--text-primary);letter-spacing:.2em}.version-tag{font:10px/1.4 Consolas,"Liberation Mono",monospace;letter-spacing:.08em}h1{font-size:32px;letter-spacing:-.04em;margin:20px 0 2px;font-weight:600}h2{font-size:22px;margin:0 0 10px}h3{font-size:18px}p{color:var(--text-secondary)}main>p{margin:4px 0 22px;font-size:13px}a{color:var(--accent)}button,input,select{font:inherit}button{border:1px solid var(--line);border-radius:7px;padding:9px 15px;cursor:pointer;background:var(--panel-raised);color:var(--text-primary);margin:5px 6px 5px 0;transition:background .12s,border-color .12s}button:hover{background:var(--line);border-color:var(--text-muted)}button.primary{font-weight:650;background:var(--accent-purple);color:#fff;border-color:var(--accent-purple);}button.primary:hover{background:var(--accent-purple-hover);border-color:var(--accent-purple-hover);}button:disabled{opacity:.4;cursor:default}button:focus-visible,input:focus-visible,select:focus-visible,summary:focus-visible{outline:2px solid var(--accent);outline-offset:4px}[hidden]{display:none!important}nav{display:flex;gap:3px;border-bottom:1px solid var(--line);margin-bottom:22px}nav button{background:transparent;border:0;border-radius:0;margin:0 22px 0 0;padding:10px 1px 13px;font-size:13px;color:var(--text-secondary);border-bottom:2px solid transparent}nav button[aria-selected=true]{color:var(--text-primary);border-bottom-color:var(--accent)}section{padding:22px;border:1px solid var(--line);border-radius:12px;background:var(--bg-card);margin:20px 0}#tab-sim{border:0;background:none;padding:0;margin:0}#tab-library,#tab-update{max-width:720px;margin:28px auto}.sim-toolbar{display:flex;gap:10px;align-items:center;margin:0 0 18px;flex-wrap:wrap}.sim-toolbar button{margin:0;font-size:12px;padding:8px 14px}.sim-health{display:flex;align-items:center;gap:9px;font-size:11px;color:var(--text-secondary)}.sim-health:before{content:"";width:6px;height:6px;background:var(--accent);border-radius:50%;box-shadow:0 0 8px #c5bad444}.sim-health span+span{border-left:1px solid var(--control-line);padding-left:9px;color:var(--text-muted)}.sim-toolbar label{margin:0 0 0 auto;display:flex;gap:8px;align-items:center;font-size:11px;color:var(--text-secondary)}.sim-toolbar input{width:85px;accent-color:var(--accent)}
.device-scroll{overflow:auto;padding:10px 18px 28px;margin:0 -18px;scrollbar-color:var(--control-line) transparent}.sim-device{container-type:inline-size;position:relative;width:100%;min-width:720px;aspect-ratio:1000/624;border:1px solid var(--control-line);border-radius:2.5%;box-shadow:inset 0 1px 1px #97949b80,inset 0 -5px 0 var(--bg-card),0 4px 0 var(--bg-secondary),0 12px 24px #0007,0 30px 60px #0004;user-select:none;-webkit-user-select:none;background:linear-gradient(125deg,#282532 0%,#1c1926 50%,#16141f 100%);border-color:#51495F;}.sim-device:after{pointer-events:none;content:"";position:absolute;inset:0;border-radius:inherit;background:linear-gradient(100deg,#ffffff04,transparent 55%)}.device-brand{position:absolute;left:5.2%;top:3%;font:700 1.3cqw/1 Consolas,"Liberation Mono",monospace;letter-spacing:.15em;color:var(--text-secondary)}.device-brand span{font-size:.8cqw;font-weight:400;color:var(--text-muted);margin-left:1cqw;letter-spacing:.08em}.case-mark{position:absolute;right:4.8%;top:3%;font:.8cqw Consolas,"Liberation Mono",monospace;letter-spacing:.18em;color:var(--text-muted)}.screw{position:absolute;width:.7%;height:1.12%;border-radius:50%;background:linear-gradient(45deg,var(--bg-card) 45%,#78747d55 48%,var(--bg-card) 55%);box-shadow:0 1px 1px #6e697450}.screw.tl{left:2%;top:3%}.screw.tr{right:2%;top:3%}.screw.bl{left:2%;bottom:3%}.screw.br{right:2%;bottom:3%}.screen-bezel{position:absolute;left:29.2%;top:7.05%;width:25.6%;height:41.03%;padding:.8%;border:1px solid var(--bg-secondary);background:var(--bg-secondary);border-radius:2%;box-shadow:0 1px 1px #78738060,inset 0 2px 5px #0008}#sim-screen{display:block;width:100%;height:100%;image-rendering:pixelated;background:#000;border:1px solid var(--bg-secondary)}.screen-placeholder{position:absolute;inset:8%;display:grid;place-content:center;text-align:center;color:var(--text-secondary);font:1.1cqw/1.8 system-ui}.screen-placeholder strong{color:var(--accent);font-size:3cqw;letter-spacing:.16em}.screen-caption{position:absolute;top:48.9%;left:29.2%;width:25.6%;display:flex;justify-content:space-between;font:.67cqw Consolas,"Liberation Mono",monospace;letter-spacing:.15em;color:var(--text-muted)}.encoder{position:absolute;width:8%;height:7.7%;transform:translate(-50%,-50%);text-align:center;z-index:2}.encoder>span{position:absolute;bottom:calc(100% + 1.1cqw);left:-12%;right:-12%;font:600 1cqw/1 Consolas,"Liberation Mono",monospace;color:var(--text-secondary);letter-spacing:.04em}.encoder .dial{display:block;position:relative;width:60%;height:100%;margin:0 auto;padding:0;border:2px solid var(--bg-secondary);border-radius:50%;box-shadow:0 .35cqw .45cqw #0009,inset 0 .1cqw .15cqw #9d97a590;touch-action:none;background:radial-gradient(circle at 37% 25%,#68616F 0%,#423C4D 40%,#272330 76%,#17141F 94%);border-color:#0E0C1A;}.encoder .dial:hover{border-color:var(--text-secondary)}.dial i{position:absolute;left:calc(50% - 1px);top:8%;width:2px;height:27%;border-radius:1px;transform-origin:50% 154%;transform:rotate(var(--angle,0deg));background:var(--accent-cyan);box-shadow:0 0 .3cqw #06d6e033;}.detents{position:absolute;left:0;right:0;top:calc(100% + .55cqw);display:flex;justify-content:center;gap:.5cqw;opacity:0;transition:opacity .1s}.encoder:hover .detents,.encoder:focus-within .detents{opacity:1}.detents button{width:2.8cqw;height:1.9cqw;margin:0;padding:0;font:1.3cqw/1 system-ui;border:1px solid var(--control-line);border-radius:.3cqw;background:var(--panel-raised);color:var(--text-primary)}.panel-button{position:absolute;z-index:2;display:flex;flex-direction:column;align-items:center;justify-content:center;margin:0;padding:0;border:1px solid var(--bg-card);border-top-color:#88819360;border-radius:.7cqw;box-shadow:0 .3cqw 0 var(--bg-card),0 .45cqw .5cqw #0006,inset 0 .12cqw .12cqw #bfb4ce22;font:600 1cqw/1.35 Consolas,"Liberation Mono",monospace;letter-spacing:.025em;touch-action:none;background:linear-gradient(#3B354A,#292538);color:var(--text-primary);border-color:var(--control-line);}.panel-button:hover{background:linear-gradient(#514466,#382B4D);border-color:var(--purple-soft);}.panel-button small{font:.58cqw/1.2 Consolas,"Liberation Mono",monospace;color:var(--text-secondary)}.panel-button[data-button="13"]{color:var(--text-primary);}.panel-button.lit{background:linear-gradient(#6030AA,#442075);color:#fff;border-top-color:var(--purple-soft);border-color:var(--accent-purple);}.panel-button.held{box-shadow:0 .1cqw 0 var(--bg-card),inset 0 .2cqw .4cqw #0d0b1199;transform:translateY(.2cqw);background:var(--accent-purple);color:#fff;}.panel-button.latched{outline:1px solid var(--accent-cyan);outline-offset:2px}.panel-button.latched:after{position:absolute;right:.4cqw;top:.35cqw;width:.35cqw;height:.35cqw;border-radius:50%;background:var(--accent-cyan);content:""}
.keyboard{position:absolute;left:3.6%;top:53.2%;width:92.8%;height:41%;border-radius:1cqw;border:1px solid var(--bg-secondary);background:linear-gradient(var(--bg-card),var(--bg-card-hover));box-shadow:inset 0 .35cqw .5cqw #0006,0 .1cqw 0 #6d667740}.piano-key{position:absolute;transform:translateX(-50%);margin:0;padding:0;border:1px solid var(--bg-secondary);width:4.35%;background:linear-gradient(110deg,var(--line),var(--panel-raised) 55%,var(--panel-raised));box-shadow:inset .15cqw 0 .25cqw #988ea744,0 .4cqw .4cqw #0009;touch-action:none;opacity:1!important;color:var(--text-secondary);border-radius:0 0 .45cqw .45cqw;border-color:#0E0C1A;}.piano-key.white{top:5%;height:90%;background:linear-gradient(110deg,#F0EDF6,#D9D4E3);color:#342B45;z-index:1;}.piano-key.black{width:4.1%;top:5%;height:58%;background:linear-gradient(110deg,#494052,#191520 70%);color:#F0EDF6;z-index:2;}.piano-key>i{position:absolute;left:calc(50% - 1px);width:2px;border-radius:1px;box-shadow:inset 0 0 1px var(--bg-secondary);background:#B0AAC0;height:5%;top:82%;}.piano-key span{position:absolute;bottom:10%;left:-10%;right:-10%;font:.75cqw/1 Consolas,"Liberation Mono",monospace;letter-spacing:.025em}.piano-key.black span{font-size:.65cqw;bottom:11%}.keyboard .piano-key:hover{border-color:var(--accent-cyan)}.keyboard .piano-key.held{transform:translate(-50%,.22cqw);box-shadow:inset 0 .25cqw .35cqw #1f182890,0 .1cqw .2cqw #0007;background:linear-gradient(#06D6E0,#0895AA);color:#07060D;}.piano-key.lit>i,.piano-key.held>i{background:var(--accent-cyan);box-shadow:0 0 .65cqw #06d6e066}.piano-key.white.lit span,.piano-key.held span{color:#07060D;}.panel-caption{display:flex;justify-content:space-between;gap:16px;margin:-8px 0 0;font-size:11px;color:var(--text-muted)}.sim-status{font-size:12px;min-height:24px;color:var(--text-primary);margin:15px 0 18px;padding:10px 14px;background:#201b2680;border-left:2px solid var(--control-line);border-radius:0 4px 4px 0}.sim-details{border-top:1px solid var(--line);padding-top:14px;margin-top:14px}.sim-details summary{cursor:pointer;font-size:13px;color:var(--text-secondary);list-style-position:inside}.sim-details summary:hover{color:var(--text-primary)}.sim-help{font-size:12px;color:var(--text-secondary)}.sim-help li{margin:8px 0}.sim-file-row{display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-top:13px}.sim-file-row button{font-size:12px;margin:0;padding:8px 12px}.sim-file-row input,.sim-file-row select{font-size:12px}.sim-selectors{display:flex;gap:12px;margin:16px 0}.sim-selectors label{flex:1;margin:0;font-size:11px;color:var(--text-secondary)}.sim-selectors select{display:block;width:100%;margin-top:5px}.track-grid{display:grid;grid-template-columns:repeat(8,minmax(0,1fr));gap:7px}.track-tile{text-align:left;margin:0;padding:8px 10px;min-width:0;font-size:12px;background:var(--bg-card-hover);border-color:var(--line)}.track-tile.selected{border-color:var(--accent-purple);background:var(--purple-wash);}.track-number{color:var(--text-secondary);font-size:10px;margin-right:6px}.track-source{font-weight:650}.track-level{display:block;height:2px;margin:7px 0;background:linear-gradient(to right,var(--accent-cyan) var(--level,0%),var(--line) var(--level,0%))}.track-steps{display:grid;grid-template-columns:repeat(16,1fr);gap:2px}.track-steps i{height:3px;background:var(--line)}.track-steps i.on{background:var(--accent-purple)}.track-steps i.play{background:var(--accent-orange)}.track-steps i.outside{visibility:hidden}.quiet-note{margin:18px 0 0;font-size:11px;color:var(--text-muted)}label{display:block;margin:18px 0 10px;font-size:13px}select,input[type=text],input[type=file]{font:inherit;max-width:100%;padding:8px;background:var(--bg-secondary);color:var(--text-primary);border:1px solid var(--control-line);border-radius:6px}dl{display:grid;grid-template-columns:88px 1fr;gap:10px;margin:0;font-size:13px}dt{color:var(--text-secondary)}dd{margin:0;overflow-wrap:anywhere}code{font-size:12px}progress{width:100%;height:8px;accent-color:var(--accent)}#status{min-height:48px;color:var(--text-primary)}small{display:block;color:var(--text-secondary);font-size:11px}#error{color:#FDA4AF;white-space:pre-wrap}.library-message{white-space:pre-wrap;min-height:28px}#song-steps input.nudged{border-left:3px solid var(--accent-orange)}.song-inspector{margin-top:12px;font-size:12px}.song-inspector table{border-collapse:collapse;width:100%}.song-inspector td,.song-inspector th{padding:4px 6px;text-align:left;border-bottom:1px solid var(--line)}.song-inspector input[type=number]{width:5.5em;font-size:12px;padding:4px}.song-inspector .readout{color:var(--text-secondary);white-space:nowrap}.boot-warning{padding:14px;background:#573826;color:#ffe7b5}.boot-warning p{color:inherit}
@media(max-width:850px){main{padding:24px 20px}.track-grid{grid-template-columns:repeat(4,minmax(0,1fr))}.panel-caption{flex-wrap:wrap;gap:4px}.sim-toolbar label{display:none}.version-tag{font-size:9px}.sim-health{margin-left:auto}}
@media(max-width:480px){main{padding:18px 16px}h1{font-size:27px}.version-tag{display:none}nav button{margin-right:20px;font-size:12px}.sim-toolbar{gap:8px}.sim-toolbar button{padding:8px 11px}.sim-health{width:100%;margin:0}.device-scroll{margin:0 -6px;padding:8px 6px 24px}.track-grid{grid-template-columns:repeat(2,minmax(0,1fr))}section{padding:18px}.sim-file-row input{width:100%}}
@media(hover:none){.detents{opacity:1}}
#tab-manual{padding:0;border:0;background:none;margin:28px 0}.manual-heading{display:flex;align-items:start;justify-content:space-between;gap:20px}.manual-heading h2{font-size:28px}.manual-heading p{margin:4px 0 18px;font-size:13px}.manual-heading button{white-space:nowrap;font-size:12px}.manual-layout{display:grid;grid-template-columns:200px minmax(0,1fr);gap:28px;align-items:start}.manual-index{position:sticky;top:20px;padding:18px;border:1px solid var(--line);border-radius:10px;background:var(--bg-card)}.manual-index label{margin:0 0 8px;color:var(--text-primary)}.manual-index input{width:100%;min-width:0;background:var(--bg-secondary);border:1px solid var(--control-line);border-radius:6px;color:var(--text-primary);padding:9px;font-size:12px}.manual-index ol{padding:0;list-style:none;margin:16px 0 0}.manual-index li{margin:8px 0}.manual-index a{display:block;font-size:12px;text-decoration:none}.manual-index a:hover{text-decoration:underline}.manual-index button{font-size:11px;padding:5px 9px}.manual-count{font-size:11px;color:var(--muted);margin:8px 0}.manual-body{min-width:0}.manual-chapter{padding:24px;border:1px solid var(--line);border-radius:10px;background:var(--bg-card);margin:0 0 18px;scroll-margin-top:20px}.manual-chapter h3{font-size:19px;color:var(--text-primary);margin:0 0 16px}.manual-chapter h4{margin:22px 0 8px;font-size:14px;color:var(--text-primary)}.manual-chapter p,.manual-chapter li{color:var(--text-secondary);font-size:13px}.manual-chapter p{margin:10px 0}.manual-chapter li{margin:8px 0}.manual-chapter ol,.manual-chapter ul{padding-left:22px}.manual-chapter strong{color:var(--text-primary)}.manual-chapter kbd{font:11px/1.7 Consolas,monospace;padding:2px 5px;border:1px solid var(--control-line);border-radius:4px;color:var(--text-primary);white-space:nowrap}.manual-note{border-left:2px solid var(--accent);background:var(--panel-raised);padding:10px 14px;border-radius:0 5px 5px 0}.manual-table{overflow-x:auto}.manual-table table{width:100%;border-collapse:collapse;font-size:12px;line-height:1.8;color:var(--text-secondary)}.manual-table th,.manual-table td{padding:10px;text-align:left;vertical-align:top;border-bottom:1px solid var(--line)}.manual-table th{color:var(--text-primary);background:var(--panel-raised);white-space:nowrap}.manual-table td:first-child{color:var(--text-primary);min-width:90px}.manual-empty{padding:24px;border:1px dashed var(--control-line);border-radius:10px;color:var(--text-secondary)}.manual-quickref td,.manual-quickref th{padding:4px 7px;font-size:11px;line-height:1.5}a:focus-visible{outline:2px solid var(--accent);outline-offset:4px}nav{overflow-x:auto}nav button{flex-shrink:0;white-space:nowrap}
@media(max-width:700px){.manual-layout{grid-template-columns:1fr;gap:18px}.manual-index{position:static}.manual-index ol{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0 12px}.manual-chapter{padding:18px}.manual-heading{gap:10px}.manual-heading h2{font-size:24px}nav button{margin-right:16px}}
@media print{:root{color-scheme:light;background:white;color:#111}body,main{background:white}main{max-width:none;padding:0}main>*:not(#tab-manual){display:none!important}#tab-manual{display:block!important;margin:0}.manual-heading button,.manual-index,.manual-empty{display:none!important}.manual-layout{display:block}.manual-chapter,.manual-chapter[hidden]{display:block!important;background:white;border:0;border-top:1px solid #aaa;border-radius:0;padding:18px 0;margin:0;break-inside:auto}.manual-heading h2,.manual-chapter h3,.manual-chapter h4,.manual-chapter strong,.manual-chapter p,.manual-chapter li,.manual-table td,.manual-table th{color:#111}.manual-chapter h3,.manual-chapter h4{break-after:avoid}.manual-chapter kbd{color:#111;border-color:#aaa}.manual-table{overflow:visible}.manual-table th{background:#eee}.manual-table tr{break-inside:avoid}.manual-quickref{break-before:page}.manual-quickref td,.manual-quickref th{font-size:9px;padding:2px 5px}.manual-note{background:#f2f2f2;border-color:#666}a{color:#111;text-decoration:none}}
.preset-home{padding:18px 20px;margin:0 0 18px;border:1px solid var(--control-line);border-radius:10px;background:var(--bg-card-hover)}.preset-home-head{display:flex;align-items:center;gap:12px;flex-wrap:wrap}.preset-home-head small{font-size:11px;color:var(--text-secondary)}.preset-home-head strong{font-size:21px;color:var(--text-primary);letter-spacing:.04em}.preset-home-head>span{font-size:11px;color:var(--text-secondary)}.preset-home label{margin:0;font-size:12px;color:var(--text-secondary)}.preset-home .sim-file-row{margin-top:10px}.preset-home select{min-width:175px;max-width:100%}.preset-home .preset-main{flex:1;display:flex;gap:8px;align-items:center}.preset-home .preset-main select{flex:1}.preset-home .sim-selectors{margin:14px 0 0;padding-top:12px;border-top:1px solid var(--line)}.preset-home .sim-selectors label{display:flex;align-items:center;gap:8px}.preset-home .sim-selectors select{width:auto;flex:1;margin:0;min-width:0}.preset-home .sim-help{margin:9px 0 0}.preset-home .primary{font-size:13px}.preset-home .sim-file-row button{white-space:nowrap}@media(max-width:700px){.preset-home{padding:14px}.preset-home .preset-main{flex-basis:100%}.preset-home .sim-selectors{flex-wrap:wrap}.preset-home .sim-selectors label{flex-basis:100%}.preset-home-head strong{font-size:18px}}
.update-choice{display:flex;align-items:center;gap:12px;min-height:48px;padding:10px 12px;border:1px solid var(--control-line);border-radius:8px;cursor:pointer;line-height:1.6}.update-choice input{width:22px;height:22px;flex:0 0 22px;accent-color:var(--accent-cyan);cursor:pointer}.update-choice:has(input:checked){border-color:var(--accent-cyan);background:var(--purple-wash)}#tab-update #force-warning{padding:14px;border:1px solid var(--accent-orange);border-radius:8px;background:#3b2d1e;color:#FED7AA}#force-activate{border-color:var(--accent-orange);color:#FED7AA}#update-next{font-weight:600}#sim-lcd-value{border-radius:8px;padding:8px;background:var(--bg-card);cursor:ns-resize}
.device-status{display:flex;flex-wrap:wrap;align-items:center;gap:8px 20px;margin:0 0 18px;padding:12px 16px;border:1px solid var(--control-line);border-radius:10px;background:var(--bg-card-hover);font-size:12px}.device-status strong{color:var(--text-primary)}.device-status span{color:var(--text-secondary);line-height:1.6}.device-status[data-state="pending"]{border-color:#95753c}.device-status[data-state="pending"] strong{color:#FDBA74}.device-status[data-state="verified"]{border-color:var(--accent-green)}.device-status[data-state="verified"] strong{color:#86EFAC}.preset-picker #sim-read-device{grid-column:1/-1}.sim-record-state{margin:8px 0;font-size:12px;color:var(--text-secondary)}

/* Pro/Elite controls use one portable event mapping. */
.panel-button[data-button="16"].lit{background:var(--accent-cyan);color:var(--bg-primary);border-color:var(--accent-cyan)}
.panel-button[data-button="17"].lit{background:linear-gradient(#923056,#6B2344);color:#fff;border-color:var(--accent-pink)}


.encoder{height:6.7%}.panel-button{font-size:.72cqw;background:linear-gradient(#3B354A,#292538);color:var(--text-primary);border-color:var(--control-line);}.piano-key.white{width:calc(100% / 22 - .15%);top:5%;height:90%;background:linear-gradient(110deg,#F0EDF6,#D9D4E3);color:#342B45;z-index:1;}.piano-key.black{width:2.9%;top:5%;height:58%;background:linear-gradient(110deg,#494052,#191520 70%);color:#F0EDF6;z-index:2;}
.smk-pad{position:absolute;width:4.8%;height:4.9%;margin:0;padding:0;border:1px solid var(--text-secondary);border-radius:.7cqw;font:1cqw monospace;touch-action:none;background:linear-gradient(145deg,#302440,#1E192C);border-color:#88749F;color:var(--text-primary);box-shadow:inset 0 0 1cqw #7c3aed18;}
.smk-pad.select-track{border-color:var(--accent-cyan);box-shadow:0 0 .8cqw #06d6e080}.smk-pad.muted-track{border-color:#ffae52;color:#ffae52}.smk-pad.off-track{border-color:var(--text-muted);color:var(--text-muted)}
.smk-pad.held{background:var(--accent-cyan);color:var(--bg-primary);border-color:var(--accent-cyan);box-shadow:0 0 1cqw #06d6e044;}




.save-dialog{width:min(460px,90vw);padding:24px;color:var(--text-primary);background:var(--bg-card-hover);border:1px solid var(--text-muted);border-radius:12px}.save-dialog::backdrop{background:#000b}.save-dialog select{width:100%}.save-dialog p{font-size:13px}.save-dialog h2{margin-top:0}.save-dialog button{margin:8px 8px 0 0}.save-dialog [role=status]{min-height:22px;color:var(--text-primary)}
@media(max-width:700px){header{flex-wrap:wrap}.version-tag{display:none}}


/* Workbench shell. Physical controls retain their hardware geometry. */
@media screen {
:root{background:var(--bg-primary);color:var(--text-primary);font:14px/1.6 system-ui,-apple-system,"Segoe UI",sans-serif}
body{background:var(--bg-primary)}main{max-width:1320px;padding:22px 28px 30px}
.site-header{min-height:40px;gap:14px;letter-spacing:0;margin-bottom:18px;flex-wrap:wrap}.brand{display:flex;gap:9px;align-items:center;color:var(--accent-purple);}.brand svg{width:30px;height:30px}.brand b{font-size:23px;line-height:1;letter-spacing:-.05em;color:var(--text-primary)}.brand b span{display:block;margin-top:4px;font:8px/1 Consolas,monospace;letter-spacing:.15em;color:var(--muted)}.site-header h1{font-size:17px;font-weight:500;letter-spacing:0;margin:0;color:var(--text-secondary)}.release-badge{font:11px/1.4 Consolas,monospace;color:var(--text-secondary);padding:3px 7px;border:1px solid var(--line);border-radius:5px}.about-button{padding:5px 9px;margin:0;font-size:12px;background:transparent;border-color:transparent;color:var(--text-secondary)}
button{border-radius:7px;background:var(--panel-raised);border-color:var(--line);color:var(--text-primary);font-size:13px}button:hover{background:var(--line);border-color:var(--text-muted)}button.primary{background:var(--accent-purple);color:#fff;border-color:var(--accent-purple);}button.primary:hover{background:var(--accent-purple-hover);border-color:var(--accent-purple-hover);}
.navigation-row{display:flex;align-items:center;gap:16px;border-bottom:1px solid var(--line);padding-bottom:10px}.app-nav{flex:1;gap:4px;margin:0;padding:0;border:0;overflow-x:auto}.app-nav button{padding:8px 14px;margin:0;border:0;border-radius:7px;font-size:13px;color:var(--text-secondary);background:transparent;white-space:nowrap}.app-nav button[aria-selected=true]{background:var(--purple-wash);color:var(--purple-soft);box-shadow:inset 0 -2px var(--accent-purple);}.app-nav button:hover{background:#ffffff08;color:var(--text-primary)}#quick-connect{flex-shrink:0;margin:0;font-size:12px;padding:7px 12px;color:var(--purple-soft);border-color:var(--accent-purple);background:#7c3aed15}
.device-status{padding:10px 1px;margin:0 0 12px;gap:4px 14px;min-height:36px;border:0;border-radius:0;background:none;font-size:11px}.device-status strong{font-weight:500;color:var(--text-secondary)}.device-status span{color:var(--text-secondary)}.device-status[data-state=pending] strong{color:#FDBA74}.device-status[data-state=verified] strong{color:#86EFAC}
.workspace{display:grid;grid-template-columns:244px minmax(0,1fr);gap:24px;align-items:start}.preset-home{display:block;margin:0;padding:18px;border:1px solid var(--line);border-radius:10px;background:var(--bg-card);min-width:0;box-shadow:none}.preset-home-head{display:flex;align-items:flex-start;flex-direction:column;gap:4px;margin:0 0 15px}.preset-home-head small{font-size:10px;color:var(--text-secondary);letter-spacing:.06em}.preset-home-head strong{font-size:21px;line-height:1.25;color:var(--text-primary);overflow-wrap:anywhere}.preset-home-head>span{font-size:10px;color:var(--text-secondary)}.preset-picker{display:grid;grid-template-columns:1fr 1fr;gap:8px}.preset-home .preset-main{grid-column:1/-1;display:block;font-size:11px;color:var(--text-secondary)}.preset-home .preset-main select{display:block;width:100%;min-width:0;margin-top:5px;font-size:12px;padding:8px;background:var(--bg-secondary);border-color:var(--control-line)}.preset-navigation{display:flex;grid-column:1/-1;gap:8px}.preset-navigation button{flex:1;margin:0;padding:5px;font-size:12px;min-height:30px}.preset-picker>button{width:100%;margin:0;padding:9px 5px;font-size:11px;min-height:39px}.preset-picker #sim-play-control{font-size:13px;font-weight:650}.preset-picker #sim-save-device{background:var(--purple-wash);border-color:var(--accent-purple);color:var(--purple-soft)}.save-options{grid-column:1/-1;margin-top:2px}.save-options summary{font-size:11px;color:var(--text-secondary);cursor:pointer;padding:4px 0}.save-options .sim-file-row{display:grid;gap:6px;margin-top:7px}.save-options button{width:100%;font-size:11px;padding:7px}.preset-home .preset-hint{font-size:10px;color:var(--text-secondary);margin:8px 0 0;line-height:1.6}.preset-home .sim-selectors{display:grid;grid-template-columns:1fr;gap:10px;margin-top:15px;padding-top:15px;border-top:1px solid var(--line)}.preset-home .sim-selectors label{display:block;margin:0;font-size:11px;color:var(--text-secondary)}.preset-home .sim-selectors select{display:block;margin:5px 0 0;width:100%;min-width:0;padding:6px;font-size:12px;background:var(--bg-secondary);border-color:var(--control-line)}.edit-shortcuts{display:grid;grid-template-columns:1fr 1fr;gap:7px;margin-top:14px}.edit-shortcuts button{margin:0;padding:9px 5px;min-height:38px;font-size:11px;white-space:normal}.edit-shortcuts button[aria-pressed=true]{color:var(--purple-soft);border-color:var(--accent-purple);background:var(--purple-wash)}.editor-more{margin-top:14px;border-top:1px solid var(--line);padding-top:11px}.editor-more summary{cursor:pointer;font-size:11px;color:var(--text-secondary)}.editor-more .edit-shortcuts{margin-top:10px}#sim-context{font-size:10px;color:var(--text-secondary);margin:10px 0 0;line-height:1.6}
.performance-stage{min-width:0}.sim-toolbar{gap:8px;margin:0 0 4px;padding:0 0 7px;background:none;border:0;border-radius:0;flex-wrap:wrap}.sim-toolbar button{font-size:11px;padding:6px 10px;border-radius:6px}.sim-health{font-size:10px;gap:7px}.sim-health:before{width:5px;height:5px;background:var(--text-secondary);box-shadow:none}.sim-health span+span{color:var(--text-secondary);border:0;padding:0}.sim-toolbar label{font-size:10px;color:var(--text-secondary)}.sim-toolbar input{width:68px}.device-scroll{padding:9px 10px 20px;margin:0 -10px;scrollbar-width:thin;scrollbar-color:var(--control-line) var(--bg-card-hover)}
.sim-device{box-shadow:inset 0 1px 1px #c1baca66,inset 0 -4px 0 var(--bg-card-hover),0 4px 0 var(--bg-secondary),0 22px 40px #0006;border-radius:2.3%;background:linear-gradient(125deg,#282532 0%,#1c1926 50%,#16141f 100%);border-color:#51495F;}.device-brand{color:var(--text-primary)}.case-mark,.screen-caption{color:var(--text-secondary)}.encoder>span{color:var(--text-primary);font-size:1.05cqw}.encoder .dial{box-shadow:0 .4cqw .5cqw #0008,inset 0 .12cqw .16cqw #d0c9d988;background:radial-gradient(circle at 37% 25%,#68616F 0%,#423C4D 40%,#272330 76%,#17141F 94%);border-color:#0E0C1A;}.detents button{background:var(--bg-card-hover);border-color:var(--text-muted);color:var(--text-primary)}.panel-button{border-top-color:#b1a8bd55;border-radius:.6cqw;font-size:1.02cqw;background:linear-gradient(#3B354A,#292538);color:var(--text-primary);border-color:var(--control-line);}.panel-button:hover{background:linear-gradient(#514466,#382B4D);border-color:var(--purple-soft);}.panel-button[data-button="13"]{color:var(--text-primary);}.keyboard{background:linear-gradient(var(--bg-card-hover),var(--bg-card-hover));border-color:var(--bg-card);box-shadow:inset 0 .35cqw .6cqw #0007,0 .1cqw 0 #8e859b44}.piano-key.white{top:5%;height:90%;background:linear-gradient(110deg,#F0EDF6,#D9D4E3);color:#342B45;z-index:1;}.piano-key.black{top:5%;height:58%;background:linear-gradient(110deg,#494052,#191520 70%);color:#F0EDF6;z-index:2;}.piano-key>i{background:#B0AAC0;height:5%;top:82%;}.piano-key.black>i{background:#7A7290;}
.panel-caption{font-size:11px;line-height:1.7;color:var(--text-secondary);flex-wrap:wrap;gap:3px}.panel-caption a{color:var(--text-secondary);text-decoration:none}.panel-caption a:hover{text-decoration:underline}.sim-status{border:0;border-radius:0;border-top:1px solid var(--line);background:none;color:var(--text-secondary);padding:9px 0 0;font-size:11px;margin:10px 0 0;min-height:0;line-height:1.7}.sim-status:empty{display:none}.sim-record-state{font-size:11px;color:var(--text-secondary);margin:7px 0}.sim-record-state:empty{display:none}
.workspace-extras{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:18px;align-items:start}.sim-details,.library-group{border:1px solid var(--line);background:var(--bg-card);border-radius:8px;margin:0;padding:13px 16px;min-width:0}.sim-details summary,.library-group>summary{font-size:12px;color:var(--text-secondary);cursor:pointer}.sim-details[open],.library-group[open]{border-color:var(--control-line)}.sim-details .sim-help{font-size:12px}.sim-details .sim-file-row{gap:7px}.sim-details .sim-file-row button{font-size:11px;padding:8px 10px}
#tab-library,#tab-update{max-width:880px;background:var(--bg-card);border-color:var(--line);border-radius:10px;padding:24px;margin:0 auto}#tab-library>h2,#tab-update>h2{font-size:22px;color:var(--text-primary)}#tab-library p,#tab-update p{color:var(--text-secondary)}.library-group{margin-top:12px;background:var(--bg-secondary)}.library-group[open]>summary{margin-bottom:16px}.field-row{display:grid;grid-template-columns:1fr 1fr;gap:16px}.field-row label{min-width:0}.field-row input,.field-row select{width:100%}.library-message:empty{display:none}select,input[type=text],input[type=file],input[type=number]{background:var(--bg-secondary);border:1px solid var(--control-line);border-radius:7px;color:var(--text-primary);max-width:100%;padding:8px}.technical-details{margin-top:14px;font-size:12px}.technical-details summary{cursor:pointer;color:var(--text-secondary)}.technical-details[open]>summary{margin-bottom:10px}
#tab-manual{margin:0}.manual-heading h2{font-size:25px}.manual-index,.manual-chapter{background:var(--bg-card);border-color:var(--line);border-radius:10px}.manual-chapter p,.manual-chapter li{color:var(--text-secondary)}.manual-table th{background:var(--panel-raised);color:var(--text-primary)}.manual-note{background:var(--purple-wash)}.save-dialog{background:var(--bg-card-hover);border-color:var(--text-muted);box-shadow:0 24px 90px #0007;border-radius:12px}.save-dialog p{color:var(--text-secondary)}.save-dialog::backdrop{background:#0d0b11bf}.about-dialog{width:min(720px,92vw);max-height:82vh;overflow:auto}.about-dialog h2{font-size:21px}.about-dialog summary{cursor:pointer;font-size:12px;color:var(--text-secondary)}.about-dialog pre{white-space:pre-wrap;overflow-wrap:anywhere;font-size:11px;color:var(--text-secondary)}.about-dialog form{text-align:right;margin-top:15px}
@media(max-width:1099px){.workspace{grid-template-columns:1fr;gap:20px}.preset-home{display:grid;grid-template-columns:1fr 1fr;gap:0 24px;padding:18px}.preset-home-head{grid-column:1;grid-row:1}.preset-picker{grid-column:1;grid-row:2/5}.preset-home .preset-hint{grid-column:1;grid-row:5}.preset-home .sim-selectors{grid-column:2;grid-row:1/3;margin:0;padding:0;border:0;align-self:start}.edit-shortcuts{grid-column:2;grid-row:3;margin-top:10px;align-self:start}.editor-more{grid-column:2;grid-row:4/6;align-self:start}.manual-layout{gap:20px}}
@media(max-width:700px){main{padding:16px}.site-header{gap:9px;margin-bottom:15px}.brand b{font-size:21px}.brand svg{width:27px;height:27px}.site-header h1{font-size:15px}.about-button{font-size:11px;padding:5px}.navigation-row{align-items:stretch;gap:8px}.app-nav{display:flex;gap:0;overflow-x:auto}.app-nav button{font-size:12px;padding:8px 10px}.device-status{font-size:10px;margin-bottom:10px}.device-status span{flex-basis:100%}.preset-home{display:block;padding:16px}.preset-home .preset-main,.preset-navigation,.save-options{grid-column:1/-1}.preset-home .sim-selectors{display:grid;grid-template-columns:1fr 1fr;margin-top:14px;padding-top:14px;border-top:1px solid var(--line)}.edit-shortcuts{grid-template-columns:repeat(4,minmax(0,1fr));margin-top:12px;padding:0;border:0}.editor-more .edit-shortcuts{grid-template-columns:repeat(2,minmax(0,1fr))}.edit-shortcuts button{font-size:11px;padding:8px 4px;min-height:38px}.editor-more{margin-top:12px}.sim-toolbar label:not(.output-level){display:none}.sim-health{margin-left:auto}.sim-health span+span{display:inline}.sim-toolbar{gap:7px}.device-scroll{margin:0 -5px;padding:8px 5px 18px}.workspace-extras{grid-template-columns:1fr;gap:10px;margin-top:14px}.sim-details{padding:12px 14px}#tab-library,#tab-update{padding:18px}.manual-chapter{padding:18px}.manual-heading h2{font-size:23px}.field-row{grid-template-columns:1fr;gap:0}}
@media(max-width:480px){.navigation-row{flex-wrap:wrap}.app-nav{flex-basis:100%;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));overflow:visible}.app-nav button{padding:8px 2px;font-size:11px;white-space:normal;line-height:1.25;min-height:40px}#quick-connect{margin-left:auto;padding:5px 10px;font-size:11px}.site-header h1{display:none}.sim-health{width:auto;margin-left:auto}.sim-toolbar .output-level{margin-left:0}.release-badge{font-size:10px}.sim-toolbar{gap:6px}}
@media(prefers-reduced-motion:reduce){*,*:before,*:after{scroll-behavior:auto!important;transition:none!important}}
}

.quick-start{margin:10px 0 0;padding:8px 12px;border:1px solid var(--line);border-radius:7px;background:var(--bg-card);font-size:12px;color:var(--text-secondary)}.quick-start summary{cursor:pointer;color:var(--purple-soft)}.quick-start ol{padding-left:20px;margin:8px 0}.quick-start li{margin:5px 0}.quick-start p{margin:8px 0 0;font-size:11px}
.output-level{display:flex;align-items:center;gap:6px;white-space:nowrap}.output-level meter{width:64px;height:10px}.sim-toolbar label.output-level{display:flex;font-size:10px}
.lcd-surface{position:relative;width:100%;height:100%}#sim-lcd-targets{position:absolute;inset:0}.lcd-target{position:absolute;margin:0;padding:0;min-width:0;border:0;border-radius:0;background:transparent;color:transparent;opacity:1}.lcd-target:hover,.lcd-target:focus-visible{background:#06d6e022;outline:1px solid var(--accent-cyan);outline-offset:-1px}.lcd-target:disabled{pointer-events:none;background:transparent;opacity:0}.lcd-editor{text-align:center;max-width:360px;width:calc(100% - 32px)}.lcd-editor h3{font-size:24px;margin:6px 0}.lcd-value{font:32px/1.4 Consolas,monospace;color:var(--accent-cyan);margin:12px}.lcd-adjust{display:flex;gap:12px;justify-content:center}.lcd-adjust button{font-size:24px;width:90px;margin:0}
/* SMK37 front panel control order follows the physical case.
 * Wheels and LCD on the left, 8 encoders / 2 x 8 pads, faders on the right. */
.sim-device{aspect-ratio:458/181;min-width:720px;border-radius:1.2%}
.device-brand{left:2.7%;top:41%;font-size:1.2cqw;letter-spacing:.03em}.device-brand span{display:none}
.case-mark{right:3%;top:49%;font-size:.65cqw}.screw{width:.6%;height:1.52%}.screw.tl,.screw.tr{top:3%}.screw.bl,.screw.br{bottom:2%}
.screen-placeholder{inset:5%;font:9px/1.4 system-ui;overflow:auto}.screen-placeholder strong{font-size:12px;letter-spacing:0}
.encoder{width:5.4%;height:8.86%}.encoder .dial{width:65%;height:100%}.encoder>span{bottom:calc(100% + .6cqw);font-size:.85cqw}
.detents{top:calc(100% + .1cqw);gap:.25cqw}.detents button{width:2.2cqw;height:1.5cqw;font-size:1.1cqw}
.panel-button{font-size:.7cqw;line-height:1.1;border-radius:.3cqw;letter-spacing:0;box-shadow:0 .15cqw 0 var(--bg-card)}
.smk-pad{width:5.2%;height:9.6%;font:1cqw monospace;border-radius:.4cqw}.smk-pad:before{content:'';position:absolute;left:20%;right:20%;top:10%;height:2px;background:var(--accent-purple)}.smk-pad.held:before{background:var(--bg-primary)}
.smk-fader{position:absolute;top:6%;width:3.7%;height:23%;margin:0;text-align:center;font:.8cqw/1 monospace}
.smk-wheel{position:absolute;top:10%;width:3.2%;height:24%;margin:0;text-align:center;font:.8cqw/1 monospace}
.smk-fader input,.smk-wheel input{display:block;writing-mode:vertical-lr;direction:rtl;width:100%;height:90%;margin:.5cqw 0 0;accent-color:var(--accent-cyan);touch-action:none}
.keyboard{left:2.6%;top:53%;width:94.8%;height:44%;border-radius:0 0 .5cqw .5cqw}
.piano-key.white{top:0;height:98%;width:4.49%}.piano-key.black{top:0;height:62%;width:2.8%}.piano-key>i{display:none}.piano-key span{bottom:7%}
/* Keep the entire instrument visible on a typical laptop display. */
@media screen and (min-width:1100px){
 main{max-width:1280px;padding:16px 24px 20px}.site-header{min-height:32px;margin-bottom:12px}.navigation-row{padding-bottom:7px}.device-status{margin-bottom:8px;min-height:30px;padding:6px 1px}
 .workspace{grid-template-columns:208px minmax(0,1fr);gap:18px}.preset-home{padding:14px}.preset-home-head{margin-bottom:10px}.preset-home-head strong{font-size:18px}
 .preset-picker{gap:6px}.preset-picker>button{padding:6px 3px;min-height:32px}.preset-home .preset-main select{padding:6px}.preset-navigation button{font-size:10px;min-height:27px}
 .preset-home .sim-selectors{margin-top:10px;padding-top:10px;gap:6px}.edit-shortcuts{margin-top:10px;gap:6px}.edit-shortcuts button{min-height:32px;padding:6px 3px}.editor-more{margin-top:10px;padding-top:8px}
 .workspace-extras{margin-top:12px}.device-scroll{padding-bottom:14px}.quiet-note{margin:6px 0 10px;font-size:10px}.panel-caption{font-size:10px;margin-top:0}.sim-status{margin:8px 0 0;padding:6px 9px}
}
.boot-error{margin:0 0 14px;padding:12px 16px;border:1px solid var(--accent-orange);border-radius:8px;background:var(--bg-card);font-size:12px}.boot-error strong{color:#FDBA74}.boot-error p{margin:5px 0;overflow-wrap:anywhere}.boot-error button{font-size:12px;padding:5px 10px}
@media screen and (max-width:1099px){.performance-stage{grid-row:1}.preset-home{grid-row:2}.quiet-note{margin:6px 0 10px}.panel-caption{margin:0}.sim-status{margin:8px 0 0;padding:6px 9px}}
.smk-pad.note-root{border-color:var(--accent-cyan);color:var(--accent-cyan)}
.piano-key.sample-key span{color:#075985;font-weight:700}.piano-key.sample-inactive{opacity:.55}
#sim-instruments{font-family:Consolas,"Liberation Mono",monospace;line-height:1.7}
@media screen and (min-width:1000px) and (max-width:1099px){
 main{padding:16px 24px 20px}.site-header{min-height:32px;margin-bottom:12px}.navigation-row{padding-bottom:7px}.device-status{margin-bottom:8px;min-height:30px;padding:6px 1px}
}
/* Full-width instrument. The LCD keeps its native reading size while
 * the surrounding controls share aligned columns and consistent dimensions. */
main{max-width:1440px}
.workspace{grid-template-columns:1fr;gap:14px}.performance-stage{grid-row:1}
.preset-home{grid-row:2;display:grid;grid-template-columns:minmax(180px,.8fr) minmax(260px,1.4fr) minmax(260px,1.4fr);gap:0 20px;padding:16px}
.preset-home-head{grid-column:1;grid-row:1;margin-bottom:8px}.preset-picker{grid-column:2;grid-row:1/4}
.preset-home .preset-hint{grid-column:1;grid-row:2;margin:0}.preset-home .sim-selectors{grid-column:3;grid-row:1;grid-template-columns:1fr 1fr;margin:0;padding:0;border:0}
.preset-home>.edit-shortcuts{grid-column:3;grid-row:2;margin-top:10px}.preset-home>.editor-more{grid-column:3;grid-row:3;align-self:start}
.sim-device{aspect-ratio:auto;height:584px;min-width:960px;border-radius:12px;--lcd:258px;--control-start:calc(8cqw + var(--lcd) + 20px)}
.screen-bezel{position:absolute;left:8cqw;top:16px;width:var(--lcd);height:var(--lcd);padding:8px;border-radius:8px;z-index:1;box-shadow:0 1px 1px #78738060,inset 0 2px 5px #0008}
.screen-placeholder{font-size:12px}.screen-placeholder strong{font-size:20px}
.panel-encoders,.panel-pads{position:absolute;left:var(--control-start);right:21%;display:grid;grid-template-columns:repeat(8,minmax(0,1fr));column-gap:10px;align-items:center}
.panel-encoders{top:44px}.encoder{position:relative;width:auto;height:40px;transform:none}.encoder .dial{width:40px;height:40px}.encoder>span{bottom:calc(100% + 8px);font-size:10px;letter-spacing:0}
.detents{top:calc(100% + 4px);gap:4px}.detents button{width:24px;height:20px;font-size:15px}
.panel-pads{top:114px;row-gap:12px}.smk-pad{position:relative;width:min(100%,64px);height:46px;justify-self:center;font-size:12px;border-radius:5px}.smk-pad.held{transform:translateY(2px)}
.panel-faders{position:absolute;left:82%;right:3%;top:42px;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px}
.smk-fader{position:relative;top:auto;width:100%;height:132px;font-size:10px}
.panel-wheels{position:absolute;left:1.8%;top:66px;width:5%;display:flex;justify-content:space-between;gap:10px}
.smk-wheel{position:relative;top:auto;width:24px;flex-shrink:0;height:110px;font-size:9px}
.smk-fader input,.smk-wheel input{appearance:none;-webkit-appearance:none;background:transparent;accent-color:auto;cursor:ns-resize}
.smk-fader input::-webkit-slider-runnable-track{width:5px;height:100%;border-radius:3px;background:#0d0b14;box-shadow:inset 0 0 0 1px #62576e}
.smk-fader input::-webkit-slider-thumb{appearance:none;-webkit-appearance:none;width:30px;height:15px;margin-left:-12.5px;border:1px solid #100d19;border-radius:3px;background:linear-gradient(#81738f,#4b415b 42%,#bba9cd 46%,#bba9cd 54%,#40354e 58%);box-shadow:0 2px 3px #0009}
.smk-wheel input{border:1px solid #0c0a12;border-radius:8px;background:repeating-linear-gradient(0deg,#25202e 0 3px,#463c53 4px,#25202e 5px);box-shadow:inset 3px 0 6px #0009,inset -3px 0 6px #0009}
.smk-wheel input::-webkit-slider-runnable-track{width:100%;height:100%;background:transparent}
.smk-wheel input::-webkit-slider-thumb{appearance:none;-webkit-appearance:none;width:22px;height:26px;border:1px solid #17121f;border-radius:5px;background:linear-gradient(#70617e,#4d405d 42%,#afa0bd 48%,#afa0bd 52%,#3a3049 58%);box-shadow:0 2px 4px #0009}
.panel-left-buttons,.panel-right-buttons{position:absolute;display:grid;gap:5px 6px}
.panel-left-buttons{left:calc(8cqw + var(--lcd)/2 - 71px);top:282px;grid-template-columns:repeat(2,68px)}
.panel-right-buttons{right:3%;top:236px;grid-template-columns:repeat(6,44px)}
.panel-button{position:relative;width:100%;height:20px;font-size:9px;white-space:normal}.panel-right-buttons .panel-button{height:25px;font-size:8px}
.device-brand{left:1.8%;top:199px;font-size:12px}.device-brand span{display:none}.case-mark{top:328px;font-size:9px}
#sim-instruments{position:absolute;left:var(--control-start);right:24%;top:272px;margin:0;color:var(--text-secondary);font-size:11px;line-height:1.6}
.keyboard{top:364px;height:208px}
@media screen and (min-width:1000px){
 main{padding:12px 24px 20px}.site-header{min-height:32px;margin-bottom:8px}.navigation-row{padding-bottom:4px}.app-nav button{padding:7px 12px}.device-status{min-height:20px;padding:2px 1px;margin-bottom:6px}.sim-toolbar{padding-bottom:4px}
}
@media screen and (max-width:900px){
 .preset-home{display:grid;grid-template-columns:1fr 1fr;gap:0 20px}.preset-home-head{grid-column:1;grid-row:1}.preset-picker{grid-column:1;grid-row:2/5}.preset-home .preset-hint{grid-column:1;grid-row:5;margin-top:8px}.preset-home .sim-selectors{grid-column:2;grid-row:1/3}.preset-home>.edit-shortcuts{grid-column:2;grid-row:3}.preset-home>.editor-more{grid-column:2;grid-row:4/6}
}
@media screen and (max-width:620px){.preset-home{display:block}.preset-home .sim-selectors{margin-top:14px}.preset-home-head{margin-bottom:12px}}
</style>
<main>
<header class="site-header"><div class="brand"><svg viewBox="0 0 32 32" width="32" height="32" aria-hidden="true"><path d="M4 16h4l3-9 5 18 5-18 3 9h4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg><b>SMK37 OPEN<span>M-VAVE</span></b></div><h1>Workbench</h1><span id="release-version" class="release-badge"></span><button id="about-open" class="about-button" aria-haspopup="dialog" aria-controls="about-dialog">About</button></header>
<dialog id="sim-lcd-dialog" class="save-dialog lcd-editor" aria-labelledby="sim-lcd-title">
<h2 id="sim-lcd-title">LCD parameter editor</h2><h3 id="sim-lcd-label"></h3><div id="sim-lcd-value" class="lcd-value"></div>
<div class="lcd-adjust"><button id="sim-lcd-minus" aria-label="Decrease parameter">−</button><button id="sim-lcd-plus" aria-label="Increase parameter">+</button></div>
<p>Use the wheel, + / − or arrow keys for the smallest adjustment step. Changes apply to the browser preview immediately. Save to device writes project parameters; configure MIDI routing and clock sources on the instrument.</p><button id="sim-lcd-close">Done</button></dialog>
<dialog id="device-save-dialog" class="save-dialog" aria-labelledby="device-save-title"><h2 id="device-save-title">Save to device</h2><p id="device-save-source"></p><label>Save location<select id="device-save-slot" disabled aria-label="Device project slot to save into"></select></label><p>Saving replaces the selected slot and loads the project to verify it. The saved project survives a device restart.</p><p id="device-save-status" role="status" aria-live="polite"></p><button id="device-save-confirm" class="primary" disabled>Save and verify</button><button id="device-save-cancel">Cancel</button></dialog>
<p id="layout-warning" role="alert" hidden style="margin:8px 0;padding:10px 14px;border:2px solid #c0392b;border-radius:6px;font-weight:600"></p>
<div class="navigation-row"><nav class="app-nav" role="tablist" aria-label="Workbench sections"><button id="mode-sim" role="tab" aria-selected="true" aria-controls="tab-sim">Play &amp; edit</button><button id="mode-library" role="tab" aria-selected="false" aria-controls="tab-library" tabindex="-1">Projects &amp; sounds</button><button id="mode-update" role="tab" aria-selected="false" aria-controls="tab-update" tabindex="-1">Device update</button><button id="mode-manual" role="tab" aria-selected="false" aria-controls="tab-manual" tabindex="-1">Help</button></nav><button id="quick-connect">Connect device</button></div>
<div class="device-status" id="device-sync-status" role="status" aria-live="polite" data-state="preview"><strong id="device-sync-title">Browser preview · no device</strong><span id="device-sync-detail"></span></div>
<noscript><div class="boot-warning">JavaScript is required. Open this page in desktop Chrome or Edge.</div></noscript>
<div id="boot-error" class="boot-error" role="alert" hidden><strong>Workbench could not start</strong><p id="boot-error-detail"></p><button id="boot-reload">Reload</button></div>
<script data-smk37-boot>
// This tiny entry monitor runs independently of the engine scripts. A failed
// script or WASM load must not leave a disabled panel saying "Loading" forever.
(function(){
  var notice=document.getElementById('boot-error'),done=false,timer;
  function fail(message){
    if(done)return;
    clearTimeout(timer);notice.hidden=false;
    document.getElementById('boot-error-detail').textContent=message;
    var state=document.getElementById('sim-engine-state');state.hidden=false;state.textContent='Not loaded';
  }
  document.getElementById('boot-reload').onclick=function(){location.reload();};
  window.addEventListener('error',function(event){
    if(event.target.tagName==='SCRIPT'){
      // Engine readiness cannot repair a missing updater or sample script.
      // Keep this failure visible even when the remaining engine starts.
      window.SMK37Boot.blocked=true;done=false;
      fail('A script could not be loaded. Download the complete workbench again.');
      document.dispatchEvent(new Event('smk37-script-error'));
    }else if(event.message)fail(event.message);
  },true);
  window.addEventListener('unhandledrejection',function(event){fail(String(event.reason&&event.reason.message||event.reason));});
  timer=setTimeout(function(){fail('Loading took too long. Check the network or open SMK37-Open-Source.html from the download.');},15000);
  window.SMK37Boot={blocked:false,fail:fail,ready:function(){if(this.blocked)return;done=true;clearTimeout(timer);notice.hidden=true;}};
})();
</script>
<section id="tab-sim" role="tabpanel" aria-labelledby="mode-sim">
<div class="workspace">
<aside class="preset-home" aria-label="Presets &amp; common actions">
<div class="preset-home-head"><small>Current project</small><strong id="sim-current-project" aria-live="polite">Loading…</strong><span id="sim-project-note"></span></div>
<div class="preset-picker"><div class="preset-navigation"><button id="sim-preset-prev" data-sim disabled aria-label="Previous user project">← Previous</button><button id="sim-preset-next" data-sim disabled aria-label="Next user project">Next →</button></div><button id="sim-play-control" class="primary" data-sim disabled aria-pressed="false">Play</button><button id="sim-save-device" class="primary" data-sim disabled>Save to device</button><details class="save-options"><summary>Read &amp; save</summary><div class="sim-file-row"><button id="sim-read-device" data-sim disabled>Read device project</button><button id="sim-save-control" data-sim disabled>Save in this browser</button></div></details></div>
<p class="sim-help preset-hint">Save your edits before changing presets.</p>
<div class="sim-selectors"><label>Current track<select id="sim-track" data-sim disabled aria-label="Simulator track"></select></label><label>Sound engine<select id="sim-source" data-sim disabled aria-label="Simulator sound engine"></select></label></div>

<div class="edit-shortcuts"><button data-sim data-sim-page="15" disabled>Track sound</button><button data-sim data-sim-page="1" disabled>SYNC / MIDI</button><button data-sim data-sim-page="6" disabled>Mixer</button><button data-sim data-sim-page="10" disabled>Track effects</button></div>
<details class="editor-more"><summary>More editing</summary><div class="edit-shortcuts"><button data-sim data-sim-page="0" disabled>Overview</button><button data-sim data-sim-page="17" disabled>Arpeggiator settings</button><button data-sim data-sim-page="12" disabled>Copy &amp; more</button><button data-sim data-sim-page="16" disabled>User projects</button><button data-sim data-sim-page="19" disabled>Song mode</button><button data-sim data-sim-page="20" disabled>Track launch</button></div><p id="sim-context" class="sim-help">Panel K7 knob: change the whole project preset.</p></details>
</aside>
<div class="performance-stage">
<div class="sim-toolbar"><button id="sim-start" class="primary" disabled>Mute</button><button id="sim-tap-tempo" data-sim disabled title="Tap to set BPM">TAP</button><button id="sim-panic" data-sim disabled>Panic / Stop all</button><div class="sim-health" role="status"><span id="sim-engine-state">Loading</span><span id="sim-audio-state" hidden>Silent editing</span></div><label class="output-level">Output level <meter id="sim-output-meter" min="0" max="100" value="0" aria-label="Audio output level"></meter></label><label>Monitor volume <input id="sim-volume" type="range" min="0" max="100" value="35" aria-label="Monitor volume"></label></div>
<div class="device-scroll" tabindex="0" aria-label="SMK37 OPEN panel; scroll sideways on narrow screens">
<div id="sim-device" class="sim-device" aria-label="SMK37 OPEN hardware layout">
<div class="device-brand">SMK37 <span>WORKBENCH</span></div><span class="case-mark">POLYPHONIC SYNTHESIZER</span>
<i class="screw tl"></i><i class="screw tr"></i><i class="screw bl"></i><i class="screw br"></i>
<div class="screen-bezel"><div class="lcd-surface"><canvas id="sim-screen" width="240" height="240" aria-label="SMK37 OPEN device display simulation"></canvas><div id="sim-lcd-targets" aria-label="Click to edit the LCD"></div></div><div id="sim-placeholder" class="screen-placeholder"><strong>SMK37 OPEN</strong>Loading the panel…<br>If this message stays here, save the HTML and<br>open it in desktop Chrome or Edge.</div></div>
<div id="sim-encoders" class="panel-encoders"></div><div id="sim-pads" class="panel-pads"></div>
<div id="sim-faders" class="panel-faders"></div><div id="sim-wheels" class="panel-wheels"></div>
<div id="sim-left-buttons" class="panel-left-buttons"></div><div id="sim-right-buttons" class="panel-right-buttons"></div>
<p id="sim-instruments" class="sim-help"></p>
<div id="sim-keyboard" class="keyboard" aria-label="37 velocity-sensitive keys"></div>
</div></div>
<p class="quiet-note">SMK37 Pro / Elite · 37 keys · 16 pads · 8 encoders · 4 faders. FADER BANK: tracks 1–4 / 5–8, with pickup. SHIFT + ENV: LFO; SHIFT + HOME / SRC: source; SHIFT + SEQ: MIDI channels; SHIFT + Pads: track / mute.</p><div class="panel-caption"><span>Drag or scroll knobs. Click LCD values to edit.</span><a href="#manual-panel">Controls guide</a></div>
<details class="quick-start"><summary>Start with these three steps</summary><ol><li>Play: tap PAD / STEP to enter or leave the Pad instrument. KEY defaults to track 1 / channel 1 and PAD to track 8 / channel 10. K5 and OCT adjust only the instrument being edited.</li><li>Shape a sound: tap EDIT and turn K1–K4. For a different engine, use SHIFT + HOME / SRC, choose with Pads 1–6 or K1, then the 4th button in the left group (after SHIFT, FADER BANK, HOME) to apply.</li><li>Play a song: write a song in the web workbench or import a MIDI file and write it to the device, then press SEQ and EDIT together, choose SONG MODE and press PLAY on the SONG page.</li></ol><p>Pad aftertouch follows the Pad channel; DX7 responds with vibrato. In the browser, hold a Pad and drag upward to preview aftertouch, or press with a pressure-sensitive pen.</p><p>When a fader shows UP TO / DOWN TO, move it through the target to take control without an abrupt volume jump. F1–F4 identify faders; T1–T8 identify their tracks.</p></details>
<p id="sim-status" class="sim-status" role="status" aria-live="polite">Loading…</p>
<small id="sim-storage-warning" role="status" hidden>Browser storage is unavailable. Export your project file to keep your edits.</small>
</div></div>
<p id="sim-record-state" class="sim-record-state" role="status"></p>
<div class="workspace-extras">

<details class="sim-details"><summary>Eight-track status</summary><div id="sim-tracks" class="track-grid" aria-label="Eight-track status"></div></details>
<details class="sim-details"><summary>Files &amp; MIDI</summary><div class="sim-file-row"><button id="sim-project-export" data-sim disabled>Export project file</button><button id="sim-timbre-export" data-sim disabled>Export track sound</button><button id="sim-patch-export" data-sim disabled>Export DX7 patch</button><button id="sim-midi" data-sim disabled>Connect MIDI input</button><select id="sim-midi-port" hidden aria-label="Simulator MIDI input"></select></div><div class="sim-file-row"><input id="sim-file" type="file" accept=".fm1,.fm1t,.syx" data-sim disabled aria-label="Import a project or sound into the simulator"><select id="sim-voice" hidden aria-label="Select a patch from the bank"></select><button id="sim-file-apply" data-sim disabled>Import into browser</button></div><div class="sim-file-row"><button id="sim-clear" data-sim disabled>Clear browser saves</button></div><p class="sim-help">Export files to back up on your computer. Browser and device projects are saved separately.</p><p id="sample-bank-note" class="sim-help" hidden>This preview uses synthesized demo samples, only for the SAMPLER source that the simulator still offers. The device has no sampler, and project files do not contain sample audio.</p></details>
</div>
</section>
<section id="tab-update" role="tabpanel" aria-labelledby="mode-update" hidden>
<h2>Update firmware</h2><p id="update-intro">Checking the included firmware. Connect the SMK37 OPEN USB-MIDI port.</p>
<dl><dt>Firmware</dt><dd id="profile">Verifying…</dd><dt>Version</dt><dd id="firmware-version"></dd></dl>
<details class="technical-details"><summary>Firmware details</summary><dl><dt>File size</dt><dd id="size"></dd><dt>Build ID</dt><dd><code id="version"></code></dd><dt>Open base version</dt><dd id="base-version"></dd></dl></details>
<label class="update-choice"><input id="backup" type="checkbox"> I have backed up the sounds, projects and songs I want to keep</label>
<details id="update-options" class="library-group"><summary>Migration, factory restore and forced updates</summary><p><label class="update-choice"><input id="force-update" type="checkbox"> Force flash (migrate from other firmware)</label></p>
<button id="stock-restore" disabled>Restore factory V16</button><button id="open-firmware" hidden>Switch to Open firmware</button></details>
<p id="stock-warning" role="alert" hidden>Restores factory V16 firmware and sound resources for this model. Open projects and samples cannot be used by factory firmware and may be overwritten. Back them up separately first. Power-cycle the device when finished.</p>
<p id="force-warning" role="alert" hidden>Warning: the bundled firmware may be incompatible with this device. Force flashing may erase data, prevent startup and require a recovery tool. Connect only the target SMK37 OPEN. Firmware without the USB-MIDI update protocol cannot be flashed from this page.</p>
<p id="device-identity"></p>
<p id="port-pick" hidden><label>Choose the device's MIDI port <select id="update-port"><option value="">Automatic (only ports with a matching name)</option></select></label></p>
<button id="connect" disabled>Connect device</button><button id="install" class="primary" disabled>Start update</button>
<p id="update-next" aria-live="polite"></p>
<p id="status" role="status" aria-live="polite">Checking page contents…</p>
<progress id="progress" value="0" max="100" aria-label="Update progress"></progress>
<p id="error" role="alert"></p>
<!-- Task 12 (2026-11-09): the force-activate button stays hidden for good; force flash is only the checkbox in the migration section. -->
<!-- Task 12 A5: when the update loader waits for another build, the build's name and the link to its page. -->
<p id="loader-hint" hidden></p>
<details id="connection-details" hidden><summary>Connection details</summary><p>These are the ports detected by this browser for this attempt. This information stays on this page.</p><p><strong>MIDI IN</strong></p><ul id="connection-inputs"></ul><p><strong>MIDI OUT</strong></p><ul id="connection-outputs"></ul><p><strong>Identity reported by the device</strong></p><ul id="connection-identities"></ul><p><strong>Expected device identity</strong></p><ul id="connection-expected"></ul><ul id="connection-attempts"></ul></details>
<small>Keep power and USB connected. If interrupted, retry with the same version of this page.</small><p><a href="#manual-update">Update help</a></p>
</section>
<section id="tab-library" role="tabpanel" aria-labelledby="mode-library" hidden>
<h2 id="library-title">Projects &amp; sounds</h2>
<p>Manage device projects, songs and sounds. Backup files stay on this computer.</p>
<button id="library-connect" disabled>Connect project library</button><button id="library-refresh" data-library disabled>Refresh list</button>
<p id="library-status" class="library-message" role="status" aria-live="polite">Waiting for a device with project-library support.</p>
<details class="library-group" id="radio-group" hidden><summary>Bluetooth settings</summary>
<p class="sim-help">The device's Bluetooth page is gone; changes here are written to the device and saved at once. The clock source is on the device's SYNC / MIDI page (press SEQ).</p>
<div class="field-row"><label><input id="radio-on" type="checkbox" data-library disabled> Bluetooth on</label><label><input id="radio-audio" type="checkbox" data-library disabled> Bluetooth audio</label></div>
<div class="field-row"><label>BLE MIDI role <select id="radio-role" data-library disabled><option value="0">DEVICE</option><option value="1">HOST</option></select></label><label>&nbsp;<button id="radio-forget" data-library disabled>Forget MIDI pairs</button></label></div>
<p id="radio-message" class="library-message" role="status" aria-live="polite"></p></details>
<details class="library-group" id="backup-group"><summary>Full backup and restore (Classic Tabby)</summary>
<p class="sim-help">One file holds everything on the device: the 16 project slots (slot 16 carries the device settings), the unsaved workspace and the current slot, the device and session settings (MIDI configuration, track roles, input channels, panel preferences: on the diagnostic build and later), the Bluetooth switches, every song record and block, and the firmware's build ID and layout. Your "My rig" profile from this browser goes in too. Not in the file: Bluetooth pairings, the built-in rig profiles (they come with the workbench). Stop song playback first. A backup loads each project slot in turn and puts your workspace back at the end. Format: docs/BACKUP-FORMAT.md (version 1).</p>
<button id="backup-make" data-library disabled>Full backup</button>
<label>Backup file <input id="backup-file" type="file" accept=".json,application/json" data-library disabled></label>
<button id="backup-restore" data-library disabled>Full restore</button><button id="backup-verify" data-library disabled>Verify against file</button>
<div class="field-row"><label><input id="backup-rig" type="checkbox" checked data-library disabled> Also put the file's "My rig" into this browser</label></div>
<p id="backup-message" class="library-message" role="status" aria-live="polite"></p>
<ul id="backup-notes" class="sim-help"></ul></details>
<details class="library-group" id="diag-group" hidden><summary>Diagnostics (timing counters and control-loop profile)</summary>
<p class="sim-help">Timing counters and the control-loop profile (every build from tabby-v04.0; docs/BUILD.md 24.6 and 26.4). Reset, play for the time the measurement needs, then Read. Each section of the profile is the time per control pass spent in that part of the app, mean and longest; "SDK between the hooks" is the rest of the pass. Times in milliseconds; the counter runs at 24 MHz. Reading is allowed while the device plays.</p>
<button id="diag-read" data-library disabled>Read counters</button><button id="diag-reset" data-library disabled>Reset counters</button><button id="diag-copy" data-library disabled>Copy as text</button>
<pre id="diag-output" class="sim-help"></pre></details>
<details class="library-group" open><summary>Device projects</summary>
<div class="field-row"><label>Device project slot <select id="project-slot" data-library disabled></select></label>
<label>Current project name (up to 12 ASCII letters, digits or symbols)<input id="project-name" type="text" maxlength="12" placeholder="UNTITLED" data-library disabled></label></div>
<button id="project-rename" data-library disabled>Rename current project</button>
<button id="project-save" data-library disabled>Save to this slot</button><button id="project-load" data-library disabled>Load this slot</button>
<button id="project-export" data-library disabled>Back up current project</button>
<label>Restore project file <input id="project-file" type="file" accept=".fm1" data-library disabled></label>
<button id="project-import" data-library disabled>Restore to workspace</button>
<small>Loading or restoring replaces the unsaved workspace. Restoring a file does not write a device slot automatically; save it when ready.</small>
</details>
<details class="library-group"><summary>Track sounds</summary>
<div class="field-row"><label>Target track <select id="timbre-track" data-library disabled></select></label>
<label>Sound file <input id="timbre-file" type="file" accept=".fm1t" data-library disabled></label></div>
<button id="timbre-import" data-library disabled>Import track sound</button><button id="timbre-export" data-library disabled>Export track sound</button>
<small>Includes the engine, sound parameters and level, without steps. Switching between drum and melodic engines clears incompatible steps on this track. HOME + the 4th button in the left group (after SHIFT, FADER BANK, HOME) undoes the import on the panel.</small>
</details>
<details class="library-group"><summary>Standard DX7 patches</summary>
<div class="field-row"><label>Target track <select id="patch-track" data-library disabled></select></label>
<label>Sound file <input id="patch-file" type="file" accept=".syx" data-library disabled></label></div>
<label>Patch in file <select id="patch-choice" data-library disabled><option>Choose a .syx file first</option></select></label>
<button id="patch-import" data-library disabled>Import to this track</button><button id="patch-export" data-library disabled>Export this track patch</button>
<small>Supports DX7 single-voice and 32-voice bank SysEx; extension parameters are not handled. Set the target track to DX7 first. After importing, save the project for PROJECT tracks; for LIVE tracks, export a timbre file or save the voice to the independent DX7 library.</small>
</details>
<details class="library-group"><summary>Rig setup (Classic Tabby)</summary>
<p class="sim-help">Tells the workbench which device sits on each MIDI channel (definitions in web/devices/: program numbering, banks, named CCs, the gap a device needs). The row event editor then picks presets by name. The profile is saved in this browser, exportable as JSON; a song can carry its own copy. The panel is in English.</p>
<div id="rig-setup" class="rig-setup"></div>
</details>
<details class="library-group"><summary>Song mode (Classic Tabby)</summary>
<p class="sim-help">A song is a sequence of rows; each row assigns one block (64 steps, up to 4 notes per step) to each of the 8 tracks. Songs live in the device's song storage and play from the panel's ACTIONS &gt; SONG MODE. File format: docs/tasks/TASK-03-step1-assessment.md section 9.</p>
<p class="sim-help">Independent track launching (Task 06): on the device's SONG page, SCL opens the TRACK LAUNCH page. A track's pattern N is its block in row N, looping over that row's step count; pads 1-16 are rows 1-16 of the current page (OCT pages); a pad launches its pattern at the next bar, pressing the playing pattern's pad stops it at the next bar; SHIFT + pads 1-8 select the track; ENV sends the selected track back to the song, SHIFT + ENV every track; a scene jump (SONG page) overrides every track queue. A device's "Lead ms" makes its program change leave before the bar.</p>
<div class="field-row"><label>Target <select id="song-target"><option value="device">Device (project library)</option><option value="sim">Browser simulator</option></select></label>
<label>Song slot <select id="song-slot"></select></label></div>
<button id="song-read">Read song</button><button id="song-new">New song</button><button id="song-write">Write song</button><button id="song-delete">Delete song</button>
<button id="song-export">Export .tabby</button><label>Import .tabby <input id="song-file" type="file" accept=".tabby"></label><button id="song-status">Storage status</button>
<p id="song-message" class="library-message" role="status" aria-live="polite"></p>
<!-- Task 12 A1: shown when the device's song storage reports OLD DATA (state 2). -->
<div id="song-old-data" class="library-message" role="alert" hidden><p>Song storage holds OLD DATA: flash that is not in the song format (left by V01, V16, the storage move or an interrupted write). Songs cannot be written or played until it is erased. Projects, tunings and device settings are not touched. If you have not made a Full backup yet, make one first.</p><button id="song-erase-old">Erase old data…</button></div>
<div id="song-editor" hidden>
<div class="field-row"><label>Name <input id="song-name" type="text" maxlength="12"></label><label>Project slot <select id="song-project"></select></label>
<label>BPM (0 = project tempo) <input id="song-tempo" type="number" min="0" max="300" step="1"></label></div>
<div class="field-row"><label><input id="song-loop" type="checkbox"> Loop the song</label><label><input id="song-swing" type="checkbox"> Swing follows the project setting</label><label>Loop start row <input id="song-loop-row" type="number" min="1" max="128" step="1"></label>
<label>Jumps land at <select id="song-jump"><option value="0">Next bar</option><option value="1">End of row</option></select></label></div>
<label>Output channels (per track, 0 = device setting)</label><div id="song-channels" class="sim-file-row"></div>
<label>Rows = patterns (pad N of the track launch page is row N; block ids per track 1–8; 0 = that track silent)</label>
<div class="device-scroll"><table id="song-rows"><thead><tr><th>Row</th><th>T1</th><th>T2</th><th>T3</th><th>T4</th><th>T5</th><th>T6</th><th>T7</th><th>T8</th><th>Repeat</th><th>Steps</th><th>Loop here</th></tr></thead><tbody></tbody></table></div>
<button id="song-row-add">Add row</button><button id="song-row-remove">Remove last row</button>
<p id="song-patterns" class="sim-help"></p>
<label>Row events (Task 04: Program Change / Bank Select / CC sent at the row start, addressed to a MIDI channel)</label>
<div id="song-events" class="song-events" hidden></div>
<div class="field-row"><label>Block id <input id="song-block-id" type="number" min="1" max="65535" step="1" value="1"></label></div>
<button id="song-block-load">Load block</button><button id="song-block-store">Store block</button><button id="song-block-remove">Remove block</button>
<p class="sim-help">Per step: pitch:velocity:length[r], several notes separated by spaces; r = retrigger, @n = probability n/8, ! = alt tuning (example: 60:100:2 64:100:2r @4). Lengths are in 16th steps.</p>
<div id="song-steps" class="track-grid"></div>
<p class="sim-help">Step text: pitch:velocity:length/offset; length in steps (decimals allowed, 1/480 step resolution), offset in signed units (1 unit = 1/480 step), r = retrigger, @n = probability n/8, ! = alt tuning. Steps with an offset or a fractional length carry an orange mark on the left; click a step to edit its notes in the inspector below.</p>
<div id="song-inspector" class="song-inspector" hidden></div>
<button id="song-quantize-starts">Quantize starts to 16ths</button><button id="song-quantize-ends">Quantize starts and ends to 16ths</button>
<p id="song-blocks" class="sim-help"></p>
</div>
<small>Write song stores the song record first, then every block in the editor in batches (up to 8 sectors per batch, one commit each; old copies are reclaimed by ACTIONS &gt; COMPACT SONG STORAGE on the device), then verifies the record by read-back. Device audio pauses briefly while it writes. Restoring factory V16 overwrites the last 40 KB of song storage (block sectors 70 to 79 of the 80, flash 0xF4000 to 0xFDFFF): export your songs first.</small>
</details>
<details class="library-group"><summary>Import MIDI file (Classic Tabby)</summary>
<p class="sim-help">Converts a standard MIDI file (.mid, type 0/1, Renoise exports included) into a song: preview the parts, assign tracks and output channels, pick a bar range, then write to the device or the browser simulator (the target follows the Song mode target above; an occupied song slot is deleted first). The panel is in English.</p>
<div id="midi-import" class="midi-import"></div>
</details>
</details>
</section>
<section id="tab-manual" role="tabpanel" aria-labelledby="mode-manual" tabindex="0" hidden>
<div class="manual-heading"><div><h2>Classic Tabby manual</h2><p>Chapter 00 lists what changed in tabby-v04. Chapters 01–12 cover Classic Tabby’s features; chapters 13–21 carry over the SMK37 OPEN manual.</p><p class="manual-guide-link"><a href="https://seattleuser0.github.io/classic-tabby/guide/" target="_blank" rel="noopener">Testing and user guide</a>: set-up, device steps in order, and a numbered test checklist.</p></div><button id="manual-print">Print / Save as PDF</button></div>
<div class="manual-layout">
<aside class="manual-index" aria-label="Manual contents"><label for="manual-search">Find an operation</label><input id="manual-search" type="search" placeholder="e.g. LAUNCH, save, K8" autocomplete="off" aria-controls="manual-body"><p id="manual-count" class="manual-count" role="status" aria-live="polite">22 chapters</p><button id="manual-clear" hidden>Show all chapters</button><ol>
<li><a href="#manual-tabby-changes">00 · What changed in tabby-v04</a></li><li><a href="#manual-tabby-about">01 · What Classic Tabby is</a></li><li><a href="#manual-tabby-start">02 · Getting started</a></li><li><a href="#manual-tabby-songs">03 · Songs</a></li><li><a href="#manual-tabby-scenes">04 · Scene changes</a></li><li><a href="#manual-tabby-launch">05 · Track launching</a></li><li><a href="#manual-tabby-import">06 · Importing MIDI files</a></li><li><a href="#manual-tabby-timing">07 · Timed notes</a></li><li><a href="#manual-tabby-events">08 · Program changes and CCs</a></li><li><a href="#manual-tabby-preview">09 · FM6 preview</a></li><li><a href="#manual-tabby-bluetooth">10 · Bluetooth settings</a></li><li><a href="#manual-tabby-storage">11 · Storage</a></li><li><a href="#manual-tabby-quickref">12 · Quick reference</a></li>
<li><a href="#manual-start">13 · Get started (synth)</a></li><li><a href="#manual-panel">14 · Panel &amp; shortcuts</a></li><li><a href="#manual-sequence">15 · Sync &amp; MIDI</a></li><li><a href="#manual-sound">16 · Five sound engines</a></li><li><a href="#manual-mix">17 · Volume &amp; mixing</a></li><li><a href="#manual-project">18 · Saving &amp; files</a></li><li><a href="#manual-connect">19 · MIDI, Bluetooth &amp; clock</a></li><li><a href="#manual-update">20 · Firmware updates</a></li><li><a href="#manual-help">21 · Troubleshooting</a></li>
</ol></aside>
<div id="manual-body" class="manual-body">
<p id="manual-empty" class="manual-empty" hidden>No matching chapters. Try “LAUNCH”, “save” or “MIDI”, or click “Show all chapters”.</p>
<article id="manual-tabby-changes" class="manual-chapter" tabindex="-1" data-removed-ok><h3>00 · What changed in tabby-v04</h3>
<p>This chapter lists what tabby-v04.0, tabby-v04.1, tabby-v04.2 and tabby-v04.3 changed compared with tabby-v03.x. The chapters after it have the details. The page you are on is tabby-v04.3. The <a href="https://seattleuser0.github.io/classic-tabby/guide/" target="_blank" rel="noopener">testing and user guide</a> has set-up, the device steps in order and a numbered test checklist.</p>
<ul>
<li><strong>The storage move. </strong>User storage went from 536576 to 471040 bytes: 16 project slots plus 97 song-region sectors (80 of them block sectors). Installing tabby-v04.0 over v03.x once clears the project slots, the device settings and the songs, so restore them from a Full backup; Bluetooth pairings are lost too. Later updates, tabby-v04.1 included, do not move storage again. See chapter 11.</li>
<li><strong>The device has no step editing or recording. </strong>The STEP DETAILS, LOCKS and RHYTHM/REC pages, REC recording, the count-in, the metronome, pad-step mode and the copy, paste, clear, repeat and undo menu entries are gone. Patterns already in a project still load, save and play. The metronome and count-in are planned for a later version.</li>
<li><strong>The SYNC / MIDI page. </strong>Press SEQ on any page: K1 CLOCK, K2 CLK IN, K3 SWING, K4 SEQ OUT, K7 KEY OUT. SHIFT + SEQ opens MIDI TRACK and SEQ + EDIT together open ACTIONS. Tempo is set only with K4 on HOME; HOME + SEQ taps it.</li>
<li><strong>STOP TO SAVE. </strong>While a song or a pattern plays, the device writes nothing to flash: saving shows STOP TO SAVE, and erase and compaction show STOP TO ERASE / COMPACT. The workbench refuses writes too and says the device is playing and nothing was written. Stop playback, then try again.</li>
<li><strong>OLD DATA and erasing. </strong>If song storage still holds old data after an install, the device shows OLD DATA IN SONG STORAGE: press SEQ and EDIT together to open ACTIONS, choose ERASE OLD DATA and confirm twice with the 4th button in the left group (after SHIFT, FADER BANK, HOME). The workbench button for erasing old data does the same. Projects, tunings and settings are not touched.</li>
<li><strong>The timing counters. </strong>Every build carries the control-loop and flash timing counters, which the workbench and the diagnostic tools can read. tabby-v04.1 cuts the screen drawing and transfer work in each 10 ms control pass into slices, always sends song notes and MIDI first, and adds busy-time and lost-tick counters. CPU GUARD - VOICES ADAPTED on the screen is the sound engine’s CPU budget guard; it only lowers the internal voice count and does not change what is sent on MIDI.</li>
<li><strong>Fast MIDI (tabby-v04.2). </strong>Notes of a song used to wait for the next 10 ms control pass before they left the MIDI out. tabby-v04.2 asks for that pass at once from the audio engine, so a single line leaves about 3.7 ms after it is due instead of about 12 ms (measured on a device, DIN out). Eight lines at the same step leave within about 6.5 ms. It is on at power-up. ACTIONS has an entry, A2 FAST MIDI: ON or OFF, that switches it for this session only. The Diagnostics counters show it: how many requests it made, what each call cost and how often a call was repeated.</li>
<li><strong>Remote control over USB (tabby-v04.2). </strong>The workbench transfer link has a command to read the screen page and the song state, select a song, start or stop it, jump to a row, switch fast MIDI and press, hold or release a named panel control, so tests can run without anyone at the panel. It writes nothing to flash, and it refuses the 4th button in the left group (SAVE). A control it holds is released by itself after 5 seconds without a command.</li>
<li><strong>External clock in song mode (tabby-v04.3). </strong>With CLOCK set to MIDI (SEQ, K1) and a song chosen on the SONG page, PLAY arms the song: the page shows ARMED: START? The master then runs it. Each clock pulse moves the song; Start begins at the first pulse; Continue resumes where it stopped; Stop stops at once and releases all notes, and always wins; Song Position Pointer moves the song, running or stopped. If clock pulses stop for about three pulses the song holds and releases its notes (HOLD: NO CLOCK); if they return within 2 seconds it carries on from where it held; after 2 seconds it shows LOST - CONTINUE and only Continue or Start restarts it, never the pulses alone. The clock comes in over USB or Bluetooth; the TRS jack is output only. At the end of the song it arms again for the next Start.</li>
<li><strong>Recovery pages. </strong>Every published build has a permanent page under builds/, and the builds/ page lists them all. If an install is interrupted, the device’s update loader accepts only the build it was receiving: close this page, power-cycle the device, then open the page of that build. Never force flash; the Enable force flash and reconnect button is gone.</li>
<li><strong>Control names. </strong>Knobs are called K1 to K8 by their printed numbers, from the left; the firmware’s SELECT is K5, PAGE is K6, PRESETS is K7 and MASTER is K8. The button the firmware calls SAVE is called the 4th button in the left group (after SHIFT, FADER BANK, HOME) in the manual. HOME / SRC is the 7th button in the right group (after ARP, PAD / STEP, SCL, ENV, MIX, BT); SHIFT + HOME / SRC opens the sound source page. The HOME button in the left group does not.</li>
</ul></article>
<article id="manual-tabby-about" class="manual-chapter" tabindex="-1"><h3>01 · What Classic Tabby is</h3>
<p>Classic Tabby is a performance MIDI sequencer firmware for the M-VAVE SMK-37 Pro. It is a fork of SMK37 Open V01. It plays songs made of rows and blocks, keeps the exact timing of imported MIDI files, changes scenes on the bar, launches patterns per track, and sends program changes and control changes to the gear on each MIDI channel.</p>
<h4>What it does</h4>
<ul>
<li>Plays up to 16 songs from the device. A song has up to 128 rows. Each row gives every one of the 8 tracks one block of up to 64 steps, with up to 4 notes per step.</li>
<li>Keeps note starts and lengths to 1/480 of a 16th step, so a nudged kick stays nudged.</li>
<li>Queues a jump to any row from the pads. The jump lands on the next bar or at the end of the row.</li>
<li>Launches any pattern of a track on its own loop, on the next bar, while the other tracks keep following the song.</li>
<li>Sends program changes, bank selects and control changes when a row starts, with the gaps your gear needs and a lead before the bar.</li>
<li>Is the clock master. It sends MIDI Clock, Start, Stop and Song Position Pointer to the gear on the cable.</li>
</ul>
<h4>What it does not do</h4>
<ul>
<li>No sampler. The SAMPLER sound source cannot be chosen. A project that had a sampler track loads with the 808 kit on that track.</li>
<li>No DX7 operator editing on the device. The DX7 quick page stays (preset, bank, ALGORITHM, FEEDBACK, TRANSPOSE, LEVEL). Voices are edited and imported in the workbench. Pressing <kbd>EDIT</kbd> on another sound source, or <kbd>SCL</kbd>, <kbd>ENV</kbd> or <kbd>SHIFT</kbd>+<kbd>ENV</kbd> outside the song pages, shows VOICE EDIT MOVED TO WORKBENCH.</li>
<li>No Bluetooth page and no project NAME page on the device. Both moved to the workbench.</li>
<li>No factory scenes. The HOME list shows the 16 USER project slots only.</li>
</ul>
<h4>The built-in synth is a preview</h4>
<p>The SMK-37 keeps five sound sources: DX7 FM (called FM6 in the documentation), BASS 303, DRUM 808, PSG and PLUCK. In a song they are there to audition a part before it goes to external gear, or to play a part when no gear is on that channel. Which tracks sound inside and which go out is set per track with the SEQ setting on the MIDI TRACK page. Chapter 09 explains it.</p>
<h4>Where to see the installed version</h4>
<ul>
<li>Boot screen: the line under OFFICIAL OPEN shows the version, for example TABBY-V03.1. The screen font has capitals only.</li>
<li>Workbench: the badge next to the title shows the same version.</li>
<li>Device update tab: the Version line shows it. Firmware details also show the build ID and the Open base version, which stays V01.</li>
</ul>
</article>
<article id="manual-tabby-start" class="manual-chapter" tabindex="-1"><h3>02 · Getting started</h3>
<h4>Back up first</h4>
<p>Before you install, keep what you want to keep. In Projects &amp; sounds, under Device projects, load each slot you care about and click Back up current project. Under Song mode, read each song and click Export .tabby. Songs are the one thing a factory V16 restore overwrites in part, so keep the .tabby files.</p>
<h4>Install</h4>
<ol>
<li>Open the Classic Tabby workbench in desktop Chrome or Edge. Use the hosted page or the SMK37-Open-Source.html file from the release.</li>
<li>Open the Device update tab. The page shows Firmware SMK37 Pro Open and the version. Check that the version is the one you downloaded.</li>
<li>Connect the SMK-37 Pro by USB. Tick the back-up box. Click Connect device and allow MIDI with SysEx.</li>
<li>Read the identity line. SMK-37 Pro_8000001 is an Open firmware. SMK-37 Pro_016 is the factory firmware. Anything else is not this device, so stop.</li>
<li>From an Open firmware, click Start update. From the factory firmware, open Migration, factory restore and forced updates, tick Force flash, wait for the page to reconnect, confirm the warning, then Start update. If the device does not answer, power-cycle it and connect again; never use force flash on an Open firmware.</li>
<li>Keep power and USB connected until the page reports the restart and the version check.</li>
</ol>
<p class="manual-note">Songs written by tabby-v02.0 keep playing as before, including swing. Reflashing from tabby-v03.0 to tabby-v03.1 is optional. Both have the same sequencer.</p>
<h4>First boot</h4>
<p>The boot screen shows SMK37, OFFICIAL OPEN and the version. When song storage holds data that is not in the song format (V01's sample bank or DX7 library, or what the tabby-v04.0 storage move left), the device shows OLD DATA IN SONG STORAGE - SEE ACTIONS for six seconds. Until it is erased, the SONG page says OLD DATA IN SONG STORAGE and no song can be written or played. The workbench says the same when it connects the project library.</p>
<p>To erase it: press <kbd>SEQ</kbd> and <kbd>EDIT</kbd> together to open the ACTIONS menu, turn <kbd>K5</kbd> or <kbd>K1</kbd> to ERASE OLD DATA and press the 4th button in the left group (after <kbd>SHIFT</kbd>, <kbd>FADER BANK</kbd>, <kbd>HOME</kbd>); the screen asks ERASE OLD DATA? and a second the 4th button in the left group (after <kbd>SHIFT</kbd>, <kbd>FADER BANK</kbd>, <kbd>HOME</kbd>) confirms (<kbd>HOME</kbd> cancels). The workbench's Erase old data… does the same after its own confirmation. The erase runs one sector per control cycle and dips the audio briefly if something plays. Projects, tunings and settings are not touched. Afterwards the SONG page says NO SONG HERE - UPLOAD FROM THE WEB WORKBENCH and the storage status reports 326080 bytes free.</p>

<h4>Connect the workbench</h4>
<p>Open Projects &amp; sounds and click Connect project library. The page reads the device's capabilities. The Song mode group becomes usable with the device as the target, and the Bluetooth settings group appears. Everything in this tab talks to the device over USB MIDI. Close other MIDI software first if the connection fails.</p>
<p>The Play &amp; edit tab has shortcuts into the simulator's pages. Song mode opens the SONG page and Track launch opens the TRACK LAUNCH page in the browser simulator, which runs the same firmware code.</p>
</article>
<article id="manual-tabby-songs" class="manual-chapter" tabindex="-1"><h3>03 · Songs</h3>
<h4>Rows, blocks, repeats, step lengths</h4>
<p>A song is a list of rows. A row names one block per track, eight ids in all. A block is a pattern of up to 64 steps with up to 4 notes per step. Block id 0 means the track is silent in that row. One block can appear in many rows and on many tracks, so a drum pattern used in 20 rows is stored once.</p>
<p>Each row also has a repeat count from 1 to 64, a step length of 16, 32, 48 or 64 steps, and a Loop here flag. A row of 16 steps is one bar. The song plays the row's blocks for the row's length, then plays the row again for each repeat, then moves to the next row. A row with Loop here repeats until you jump away.</p>
<p>The song header holds the name (12 characters), a tempo override (0 keeps the project tempo), the Loop the song flag with its Loop start row, the jump landing rule (next bar or end of row), the swing flag, and an output channel per track (0 keeps the device OUT CH of that track).</p>
<h4>What a song stores and what the project slot stores</h4>
<p>The song stores notes, rows, row events, output channels and the tempo override. The project stores sounds, mixer levels, swing, the clock source and the per-track MIDI settings (IN CH, OUT CH, SEQ, OUT PORT). A song plays with whatever project is loaded on the device. The song's project slot field is only a note of the project it was made for. The device does not load that project for you. Load the project on HOME first, then start the song.</p>
<p>The device holds 16 songs in its song storage, the flash area that used to hold samples. The workbench's Song mode group reads, writes, deletes and exports them. The device itself never edits a song.</p>
<h4>Playing a song on the device</h4>
<ol>
<li>Press <kbd>SEQ</kbd> and <kbd>EDIT</kbd> together to open ACTIONS.</li>
<li>Turn <kbd>K5</kbd> or <kbd>K1</kbd> to SONG MODE and press the 4th button in the left group (after <kbd>SHIFT</kbd>, <kbd>FADER BANK</kbd>, <kbd>HOME</kbd>). The SONG page opens.</li>
<li>Turn <kbd>K5</kbd> or <kbd>K7</kbd> to choose song 1 to 16. This works while the song is stopped. The bottom line of the page says K5/K7 SONG.</li>
<li>Press <kbd>PLAY</kbd>. The song starts at row 1. If the project's pattern sequencer was running it stops. Press <kbd>PLAY</kbd> again to stop. Every note is released and MIDI Stop is sent once.</li>
<li><kbd>HOME</kbd> leaves the page. The song keeps playing.</li>
</ol>
<p>In the browser simulator the Song mode shortcut on the Play &amp; edit tab opens the same page.</p>
<h4>Every line on the SONG page</h4>
<div class="manual-table"><table><thead><tr><th scope="col">Line</th><th scope="col">Meaning</th></tr></thead><tbody>
<tr><td>SONG n name</td><td>The selected song slot and its name. (EMPTY) means the slot holds no song.</td></tr>
<tr><td>OLD SAMPLE/DX7 DATA IN FLASH</td><td>Song storage is blocked by V01 data. Erase it from ACTIONS. Also possible: SONG STORAGE ERROR, COMPACTING STORAGE..., SCANNING STORAGE...</td></tr>
<tr><td>ROW r / total</td><td>The row playing and the number of rows in the song.</td></tr>
<tr><td>X pass / repeat</td><td>Which pass of the row is playing and how many the row has.</td></tr>
<tr><td>BAR b / bars</td><td>The bar inside the row and how many bars the row has (its step length divided by 16).</td></tr>
<tr><td>PLAYING, STOPPING, STOPPED - PLAY STARTS</td><td>The transport state. STOPPING lasts while held notes are released.</td></tr>
<tr><td>JUMP TO ROW n</td><td>In amber: a jump is queued and lands at the next bar or the end of the row.</td></tr>
<tr><td>NEXT ROW n, LOOPING ROW, LAST ROW</td><td>What follows the current row when nothing is queued: the next row, the same row (Loop here), or nothing because the song ends. With Loop the song on, the last row is followed by the loop start row.</td></tr>
<tr><td>T1 to T8 with a number or -</td><td>The block id each track plays in the shown row. - is silence.</td></tr>
<tr><td>PADS ROW a - b</td><td>The rows the 16 pads reach on the current pad page. <kbd>OCT−</kbd> and <kbd>OCT+</kbd> turn the page in steps of 16 rows.</td></tr>
<tr><td>JUMP: NEXT BAR or JUMP: ROW END</td><td>Where a queued jump lands. <kbd>K4</kbd> switches it, and the choice is saved in the song.</td></tr>
<tr><td>TOO MANY BLOCKS, BLOCK READ ERROR, ROW DECODE LATE</td><td>In amber: the song has more than 2048 blocks and will not play; a block could not be read, so that track is silent in that row; a row was not decoded in time and the previous one played again.</td></tr>
<tr><td>BPM n</td><td>Shown when the song overrides the project tempo.</td></tr>
<tr><td>EVENTS n</td><td>Row events in the song. Shown only when the song has events.</td></tr>
<tr><td>LATE m</td><td>In amber, next to EVENTS: row entries whose events or notes came after the bar line since PLAY. Chapter 05 and chapter 08 say when that happens.</td></tr>
<tr><td>NO SONG HERE - UPLOAD FROM THE WEB WORKBENCH</td><td>The slot is empty. Write a song from the workbench.</td></tr>
</tbody></table></div>
<p>The bottom lines are the key help: K5/K7 SONG, PADS JUMP, OCT PAD PAGE, PLAY START/STOP, K4 JUMP MODE, SCL TRACK LAUNCH, HOME BACK. Notices such as NO SUCH ROW / NOT PLAYING appear in the same place for a moment.</p>
<h4>How the song ends</h4>
<p>With Loop the song off, the song stops after the last row, releases every note and sends MIDI Stop. With Loop the song on it continues from the Loop start row. When tracks are detached by a launch (chapter 05) the song does not stop at its end. The following tracks go silent, the page shows SONG OVER, the launched tracks keep looping and the clock keeps running until you press <kbd>PLAY</kbd>.</p>
<h4>The song editor in the workbench</h4>
<p>In Projects &amp; sounds, open Song mode (Classic Tabby). Choose the Target: Device (project library) or Browser simulator. Choose the Song slot. Read song loads the slot into the editor. New song starts an empty one. The editor shows the name, project slot, BPM, the loop boxes, the loop start row, where jumps land, the output channels, the row table (one line per row with the eight block ids, Repeat, Steps and Loop here), Add row and Remove last row, the row events, and the block editor. Write song writes the song record first, then every block in the editor in batches, then reads the record back and compares. Delete song clears the slot. Storage status asks the device how much room is left.</p>
<p class="manual-note">Writing to a slot that already holds a song deletes the old song first. The page says so and suggests an Export .tabby of the old song before you confirm.</p>
</article>
<article id="manual-tabby-scenes" class="manual-chapter" tabindex="-1"><h3>04 · Scene changes</h3>
<p>A scene change is a jump to another row while the song plays. You queue it from the pads of the SONG page.</p>
<ol>
<li>On the SONG page, read PADS ROW a - b. Pad 1 is row a, pad 16 is row b. <kbd>OCT−</kbd> and <kbd>OCT+</kbd> move the window by 16 rows, up to row 128.</li>
<li>Press the pad of the row you want. The page shows JUMP TO ROW n in amber at once.</li>
<li>The jump lands on the next bar when JUMP: NEXT BAR is shown, or when the current row has played all its repeats when JUMP: ROW END is shown. <kbd>K4</kbd> switches between the two. The setting is saved in the song as Jumps land at.</li>
<li>At the landing the page shows ROW n and X 1, every track starts the new row's blocks together, and the new row's events have been sent before its first notes.</li>
</ol>
<h4>What to expect</h4>
<ul>
<li>Press several pads inside one bar and only the last one lands. Press the same pad ten times and one jump lands.</li>
<li>A pad with no row behind it, or a press while the song is stopped, shows NO SUCH ROW / NOT PLAYING and queues nothing.</li>
<li>A jump cancels every pending track launch, stop and return (chapter 05) and brings every launched or stopped track back to the song at the landing. Notes of launched tracks are released at the landing.</li>
<li>A jump queued inside the last half step before the bar can land with its notes and events a little late. LATE counts up by one on the page.</li>
<li>The pads do not light differently on the SONG page. The screen is the feedback.</li>
<li>A row with Loop here never moves on by itself. Use a jump to leave it.</li>
</ul>
</article>
<article id="manual-tabby-launch" class="manual-chapter" tabindex="-1"><h3>05 · Track launching</h3>
<p>Track launching lets one track leave the song and loop one of its patterns while the others keep following the rows. A track's pattern N is simply the block that track has in row N, played for row N's step length. Nothing extra is stored.</p>
<h4>The TRACK LAUNCH page</h4>
<p>Start the song on the SONG page, then press <kbd>SCL</kbd>. The TRACK LAUNCH page opens and the SCL lamp lights. <kbd>SCL</kbd> again returns to the SONG page. <kbd>HOME</kbd> leaves to the overview. The page shows:</p>
<ul>
<li>LAUNCH, the selected track in its colour, and BAR n, the bar counter since PLAY. This counter never resets while the song runs.</li>
<li>One column per track: the pattern row it plays or -, then a word. FOLLOW means it follows the song. PLAY in green means it loops a launched pattern. STOP means it is stopped. Q n in amber means pattern n is queued. &gt;STOP means a stop is queued. &gt;SONG means it returns to the song at the next bar.</li>
<li>PATTERNS a - b with OCT PAGE, and 16 cells for the pads. A numbered cell is a pattern the selected track has on that row. A green cell is the one playing, an amber cell the one queued, an empty cell no pattern.</li>
<li>ROW n, the song's current row, then SONG OVER when the song has ended with detached tracks, and LATE n.</li>
<li>STOPPED - PLAY STARTS THE SONG when the song is not running. <kbd>PLAY</kbd> starts and stops the song here as on the SONG page.</li>
</ul>
<h4>Selecting a track</h4>
<p>Hold <kbd>SHIFT</kbd> and press pad 1 to 8. The pads show the track colours while <kbd>SHIFT</kbd> is held: dim for a track at rest, bright for a track with a pattern playing, flashing for a track with something queued, and one level brighter for the selected track. Pads 9 to 16 keep their usual mute function under <kbd>SHIFT</kbd>.</p>
<h4>Queuing a pattern</h4>
<p>Press the pad of a pattern. The pad flashes green, the column shows Q n and the notice says LAUNCH AT NEXT BAR. On beat 1 of the next bar the pattern starts, the pad turns steady green and the column shows PLAY. If the track was playing another pattern, that pattern's notes are released at the bar. A second press inside the same bar replaces the queued pattern. The launched pattern loops with its own length, so a 48-step pattern against 16-step rows lines up again every three bars.</p>
<h4>Stopping a track</h4>
<p>Press the green pad, the pattern that plays. It flashes red, the column shows &gt;STOP and the notice says STOP AT NEXT BAR. At the bar every note of the track gets its note-off on the channel it was sent on, the pad goes dim and the column shows STOP. A stopped track stays silent until you launch a pattern or send it back to the song. Stopping every track never stops the transport, the clock or the Song Position Pointer.</p>
<h4>Back to song</h4>
<p><kbd>ENV</kbd> queues the selected track back to the song: the column shows &gt;SONG and the notice TRACK BACK TO SONG AT BAR. At the next bar the track joins the row the song is in at that moment and shows FOLLOW. <kbd>SHIFT</kbd>+<kbd>ENV</kbd> does it for every track at once (ALL TRACKS BACK TO SONG AT BAR). With the song stopped the notice says NOT PLAYING.</p>
<h4>Paging and messages</h4>
<p><kbd>OCT−</kbd> and <kbd>OCT+</kbd> turn the pad page in steps of 16 rows. The messages are: PLAY STARTS THE SONG FIRST when the song is stopped, NO PATTERN ON THIS PAD when the row has no block for the selected track, LAUNCH AT NEXT BAR and STOP AT NEXT BAR when a queue was taken.</p>
<h4>Pad colours and flashing</h4>
<div class="manual-table"><table><thead><tr><th scope="col">Pad</th><th scope="col">Meaning</th></tr></thead><tbody>
<tr><td>Off</td><td>No pattern for the selected track on that row.</td></tr>
<tr><td>Dim white</td><td>A pattern that is not playing.</td></tr>
<tr><td>Steady green</td><td>The pattern that plays.</td></tr>
<tr><td>Flashing green</td><td>The pattern queued to start at the next bar.</td></tr>
<tr><td>Flashing red</td><td>The playing pattern, with a stop queued.</td></tr>
<tr><td>Track colours (with <kbd>SHIFT</kbd>)</td><td>Pads 1 to 8 are the tracks. Dim at rest, bright while a pattern plays, flashing while something is queued, brighter for the selected track.</td></tr>
</tbody></table></div>
<p>While the song runs the flashing follows the master clock, one change per eighth note. With the song stopped the pads flash every quarter second.</p>
<h4>Scenes and launched tracks</h4>
<ul>
<li>A scene change on the SONG page overrides everything queued on the TRACK LAUNCH page and brings every track back to the song at the landing.</li>
<li>A launched or stopped track ignores row changes until it returns.</li>
<li>When the song's last row ends and no track is detached, the usual song end applies. When a track is detached, the following tracks go silent, SONG OVER appears, the detached tracks keep looping and the clock keeps running. <kbd>PLAY</kbd> stops everything and sends MIDI Stop.</li>
<li>Every launch, stop and return lands on beat 1 of the next bar of the master clock, 16 steps long, whatever the row lengths.</li>
<li>A press inside the last control cycle before the bar cannot be served on that bar. The pattern enters at the next cycle in phase, its downbeat skipped, and LATE counts up by one.</li>
<li>A launch sends the program change of the pattern's row for the track's channel, Lead ms before the bar (chapter 08).</li>
</ul>
</article>
<article id="manual-tabby-import" class="manual-chapter" tabindex="-1"><h3>06 · Importing MIDI files</h3>
<p>The panel Import MIDI file (Classic Tabby) in Projects &amp; sounds turns a Standard MIDI File (type 0 or 1, including Renoise exports and mf2t text) into a song. Everything happens in the browser. Nothing is sent until step 6.</p>
<h4>Step by step</h4>
<ol>
<li><strong>1. MIDI file.</strong> Choose the .mid file. The summary shows the format, ticks per quarter note, tracks, parts, bars, the meter and the tempo. File warnings appear under it.</li>
<li><strong>2. Parts to Classic Tabby tracks.</strong> Every MIDI track and channel is a part. The table shows its name, channel, note count, range, bars and the program changes it contains. Assign each part to track 1 to 8 or skip it. Several parts may share a track; the 4-notes-per-step limit then applies to the mix. Drum parts on channel 10 are marked. Under the table, OUT CH per track sets the output channel written into the song header; device keeps the device's OUT CH for that track.</li>
<li><strong>3. Options.</strong> Bars from and to cut the range. Bars per row offers only lengths that stay on bar lines. Row events chooses the pre-roll for program changes and CCs (one beat before, at the row start only, or up to one bar before). Quantize is off by default (exact timing); it can snap note starts, or starts and ends, to 16ths, and then Note ends picks the rounding rule. More than 4 notes on a step keeps the 4 loudest, highest or lowest. Then the song name, the project slot, loop the whole song, and loose block matching with its velocity tolerance.</li>
<li><strong>4. Resulting song.</strong> The statistics line and the row table, then Dropped or changed: the warning list.</li>
<li><strong>5. Browser song.</strong> Save song (JSON) keeps the model on your computer. Export .tabby file writes the device file format. Load song JSON brings a saved model back.</li>
<li><strong>6. Write to the device or the simulator.</strong> Choose the Song slot, read what the slot holds, click Write song… and confirm. The target follows the Target choice of the Song mode group above (device or browser simulator). The panel then shows the batch plan and the time taken.</li>
</ol>
<h4>Track assignment and output channels</h4>
<p>The first eight non-empty parts are pre-assigned to tracks 1 to 8. A part's notes are stored in the row and step where they start. A note is anchored to the nearest 16th step and keeps its offset and length, so a part keeps its feel. OUT CH per track decides which channel the device sends that track on while the song plays. Set it to the channel of the gear that should play the part, or leave device to use the SEQ page setting.</p>
<h4>Exact timing and the quantize option</h4>
<p>Timing is kept to 1/480 of a 16th step. Files with 96, 120, 192, 240, 384, 480, 960 or 1920 ticks per quarter note convert exactly. Other resolutions round to the nearest unit and the panel reports the largest rounding. Quantize snaps starts to the grid, or starts and ends, and only then the rules for note ends apply.</p>
<h4>The warnings and what each one means</h4>
<div class="manual-table"><table><thead><tr><th scope="col">Warning</th><th scope="col">Meaning</th></tr></thead><tbody>
<tr><td>The file has no tempo event; 120 BPM is used</td><td>The song tempo is 120.</td></tr>
<tr><td>Tempo … rounded, Tempo … clamped</td><td>The first tempo became an integer BPM, or was limited to 30 to 300.</td></tr>
<tr><td>Tempo changes ignored</td><td>Later tempo events are dropped. The song keeps the first tempo.</td></tr>
<tr><td>Time signature changes ignored</td><td>Rows follow the first signature.</td></tr>
<tr><td>No row length of 16/32/48/64 steps holds whole bars of …</td><td>Meters such as 5/4 or 7/8 do not fit a row length. Rows are 64 steps and bar lines fall inside rows.</td></tr>
<tr><td>Note starts moved to the 16th grid, Note lengths rounded to whole steps</td><td>Only with Quantize on.</td></tr>
<tr><td>Notes shorter than a step got length 1</td><td>Only with Quantize on. With exact timing short notes keep their length.</td></tr>
<tr><td>Notes outside bars …, Notes ending after bar …</td><td>Notes outside the bar range were dropped or clipped at its end.</td></tr>
<tr><td>Notes longer than … , Notes longer than 136 steps are stored to within the exponent scale</td><td>Very long notes are clipped, or stored with a coarser length step.</td></tr>
<tr><td>The file's … ticks per quarter note do not divide 1920</td><td>Note times were rounded to the nearest 1/480 step. The largest rounding is given in units and milliseconds.</td></tr>
<tr><td>Same pitch twice on one step on one track; the quieter note was dropped</td><td>Two notes of the same pitch cannot share a step on a track.</td></tr>
<tr><td>Same pitch overlapping on one track; the earlier note was shortened</td><td>A repeated pitch ends where the next one starts.</td></tr>
<tr><td>More than 4 notes on one step on one track; kept the 4 …</td><td>The overflow rule chose which four stay.</td></tr>
<tr><td>Blocks merged by loose matching</td><td>Loose matching reused a block whose velocities differ within the tolerance.</td></tr>
<tr><td>Program / bank / control change event(s) at row starts became row events</td><td>They fire when the row starts. Everything else of that kind is listed as dropped.</td></tr>
<tr><td>More than 32 events at one row start</td><td>The extra events were dropped.</td></tr>
<tr><td>Bank select without a following program change dropped</td><td>A bank select needs a program change after it.</td></tr>
<tr><td>… control change, pitch bend, aftertouch, SysEx, other meta event(s) ignored</td><td>Counted and dropped. Sustain pedal is counted separately and not applied.</td></tr>
<tr><td>MIDI parts not assigned to a track were skipped</td><td>Parts set to skip in step 2.</td></tr>
</tbody></table></div>
<p>Each warning shows a count and, where it applies, a positions list with the track and the bar.</p>
<h4>Deduplication</h4>
<p>Identical cells (the same notes, velocities, offsets and lengths) become one block id. Rows that repeat the same eight ids merge into one row with a repeat count. The merge loses nothing. Loose block matching also merges cells whose only difference is velocity, within the tolerance you set, and lists every merge.</p>
<h4>Writing and replacing a song</h4>
<p>Writing uses the song editor's path: an occupied slot is deleted first, then the song record goes, then the blocks in batches, then the record is read back and compared. The old song's blocks are reclaimed at the next compaction. Export a .tabby of the old song first if you want to keep it. Projects are never changed by a song write.</p>
</article>
<article id="manual-tabby-timing" class="manual-chapter" tabindex="-1"><h3>07 · Timed notes</h3>
<h4>Offsets and lengths</h4>
<p>Every note in a block carries a start offset and a length in units of 1/480 of a 16th step. The offset says how far before or after its step the note starts, from −240 to +240 units, which is half a step either way. A note belongs to the step nearest its start. The length is exact up to 65535 units, which is 8.5 bars of 4/4. The units are musical, so they scale with the tempo. At 120 BPM one unit is about 0.26 ms and one step is 125 ms.</p>
<h4>Reading them in the song editor</h4>
<p>In the block editor each step is a text field: pitch:velocity:length/offset. The length is in steps and may have decimals. The offset is in signed units. A trailing r means retrigger, @n a probability of n out of 8, and ! the alternate tuning. For example 60:100:1.5/-20 is a C4 at velocity 100, one and a half steps long, starting 20 units early. A step with an offset or a fractional length has an orange mark on its left.</p>
<h4>Editing them</h4>
<p>Click a step to open the inspector under the grid. It lists each note with its pitch, velocity, retrigger, offset (in units, with the fraction of a step and the milliseconds at the song's tempo) and length (steps and units). Change a value and the readouts follow. Quantize starts to 16ths clears every offset in the block. Quantize starts and ends to 16ths also rounds every length to whole steps. Store block keeps the edited block in the editor and Write song sends it to the device.</p>
<h4>Swing and old songs</h4>
<p>Songs written by tabby-v02.0 keep playing exactly as before, project swing included. When you write such a song again from the workbench it is stored in the new format and plays straight, whatever the project swing. Tick Swing follows the project setting in the song editor and write it again to make it swing. The swing itself is the project's SWING setting on the SYNC / MIDI page (<kbd>SEQ</kbd>, K3).</p>
</article>
<article id="manual-tabby-events" class="manual-chapter" tabindex="-1"><h3>08 · Program changes and CCs</h3>
<p>A row can carry events: program changes, bank selects and control changes. They fire when the row is entered, before the row's first notes, on every MIDI out port, addressed to a MIDI channel. The gear on that channel is described in the rig setup, so the editor can show preset names instead of numbers.</p>
<h4>The rig setup table</h4>
<p>In Projects &amp; sounds open Rig setup (Classic Tabby). The table has one line per MIDI channel: Device (from the device library), Name (your name for it), Gap ms, Lead ms, Numbering (how the device counts programs and banks) and Names… for your own program names. Profile name, Export rig (.json), Import rig and Reset are above the table. The profile is saved in this browser. A song can carry its own copy of the rig; the row event editor has a box for that, and the copy travels in the .tabby file.</p>
<ul>
<li><strong>Gap ms</strong> is the pause the device needs after a program change or bank select. Blank uses the device definition. The gap becomes gap events in the song when it is written, so the device pre-fires the stream early enough for the last message to leave before the bar.</li>
<li><strong>Lead ms</strong> makes the program change leave that long before the bar. It applies to track launches and scene changes alike. 0 sends it with the downbeat. Use it for gear that takes time to switch.</li>
</ul>
<h4>The device library</h4>
<p>The library has definitions for the E-MU Proteus/2 XR, Eventide H90 Harmonizer, Zoom MS-70CDR+, Waldorf Blofeld, Waldorf Pulse 2, Dirtywave M8 Tracker Model:02, Korg volca fm2, Instruo Seashell and the M-VAVE FM-1 under the Skiff, Melodee and Orange Cat firmwares. Each one gives the program numbering, the bank scheme, named controllers and the preset names the manufacturer publishes. Unverified fields are marked and shown in the editor.</p>
<h4>Row events in the song editor</h4>
<p>Below the row table of the song editor, the Row selector picks a row. Row 1 is marked SEND SETUP because its events are the set-up list. The list shows each event with its channel, the device on it and the event in words. Arrows move an event, ✕ deletes it. Add on channel and type add a Program (from the preset list, with a bank where the device has banks, or a raw number), a Control change (named or raw, with the value meaning where known) or a Gap in ms. A row holds up to 32 events and a song up to 292. Gaps read back from the device are shown greyed and regenerated from the rig at the next write.</p>
<h4>SEND SETUP</h4>
<p>With the song loaded and stopped, open ACTIONS, choose SEND SETUP and press the 4th button in the left group (after <kbd>SHIFT</kbd>, <kbd>FADER BANK</kbd>, <kbd>HOME</kbd>). Row 1's events go out at once and the notice says SETUP SENT - ROW 1 EVENTS. Use it before a set, after a power-up, and before PLAY on a song whose first row has gaps. With the song playing it says STOP THE SONG FIRST. With no song loaded it says NO SONG LOADED.</p>
<h4>What goes out when</h4>
<ul>
<li>A row change or a scene change sends the new row's events for every channel, with their gaps, pre-fired so the last message leaves before the bar.</li>
<li>A track launch or a return to the song sends only the events of the pattern's row that address that track's channel, Lead ms before the bar. Two tracks on one channel each send their own.</li>
<li>LATE on the SONG page counts rows whose stream ended after the bar line, for example PLAY on a row with gaps without SEND SETUP first, or a jump queued with less time left than the gaps need.</li>
<li>Events reach external gear only. The SMK-37's own presets are set by the project, not by events.</li>
</ul>
<h4>Device setup checklist</h4>
<p>Without these settings on the gear itself, row events do nothing.</p>
<div class="manual-table"><table><thead><tr><th scope="col">Device</th><th scope="col">Set on the device</th></tr></thead><tbody>
<tr><td>E-MU Proteus/2 XR</td><td>Master menu MIDI MODE = Multi. Per channel, MIDI ENABLE on and PRESET CHANGE on for every channel a song addresses. MIDI PROG&gt;PRESET map: identity for presets 0 to 127, and an explicit mapping for any preset above 127, because the Proteus has no bank select. Leave the Edit menu, where program changes are ignored. Run SEND SETUP before PLAY.</td></tr>
<tr><td>Eventide H90</td><td>System &gt; MIDI: the channel (15) or Receive Omni. PC Offset 0 or 1, and the rig profile set to match. The Playlist is the User List the program numbers refer to. Assign the CC numbers for bypass, HotSwitch and tap in Global Control and enter them in the rig. On firmware 1.8.6 to 1.9.x put the device gap after the program change.</td></tr>
<tr><td>Zoom MS-70CDR+</td><td>MENU &gt; USB MIDI CH = 16 or OMNI. USB host powered and connected before the set. Patches 001 to 100 by program change only. Send PC 0 and PC 1 once and note which patch the display shows, to settle the base.</td></tr>
<tr><td>Waldorf Blofeld</td><td>Global MIDI Channel, or the part channel in Multi mode with the part's Prg Change filter on receive. Ctrl Receive = on, or no CC changes anything. Banks by CC 32 = 0 to 7 (A to H). Avoid channel 10 in Multi mode. Allow a gap after a program change.</td></tr>
<tr><td>Waldorf Pulse 2</td><td>Global MIDI Channel. Banks by CC 32 = 0 to 4. PC is clamped to 0 to 99 inside the bank. Program 500 is the random patch.</td></tr>
<tr><td>Dirtywave M8 Model:02</td><td>MIDI Settings: track channels, PG CHANGE = on. A program change selects the track's instrument (INST 00 to 7F). These settings are stored in the M8 song file.</td></tr>
<tr><td>Korg volca fm2</td><td>MIDI channel (hold MEMORY at power-on, key 1 to 16). Global 7 MIDI ShortMessage = on. No program change at all; a song can only send its CCs.</td></tr>
<tr><td>Instruo Seashell</td><td>MIDI channel in the Seashell Controller app. No program change in firmware 1.0.x; parameters by MIDI Learn only.</td></tr>
</tbody></table></div>
</article>
<article id="manual-tabby-preview" class="manual-chapter" tabindex="-1"><h3>09 · FM6 preview</h3>
<p>Each track decides where its notes go. The setting lives on the MIDI TRACK page, opened with <kbd>SHIFT</kbd>+<kbd>SEQ</kbd> from any page. <kbd>K5</kbd> picks the track.</p>
<div class="manual-table"><table><thead><tr><th scope="col">Knob</th><th scope="col">Setting</th></tr></thead><tbody>
<tr><td>K1 IN CH</td><td>The channel the track listens to from USB or Bluetooth MIDI.</td></tr>
<tr><td>K2 OUT CH</td><td>The channel the track sends on. A song's output channel for the track overrides it while the song plays and is withdrawn when playback stops.</td></tr>
<tr><td>K3 SEQ</td><td>LOCAL: the track's notes play the built-in sound only. BOTH: the built-in sound and MIDI out. MIDI: MIDI out only.</td></tr>
<tr><td>K4 OUT PORT</td><td>ALL sends on every port (USB, Bluetooth, DIN). OFF sends nothing from this track.</td></tr>
</tbody></table></div>
<p>The SYNC / MIDI page (<kbd>SEQ</kbd> from any page) holds the global switches: K4 SEQ OUT (OFF, ON, CLOCK) and <kbd>K7</kbd> KEY OUT. Song notes follow the same rules as pattern notes. Keep SEQ OUT on ON for notes and clock, or CLOCK for the clock alone.</p>
<h4>Audition a part, then hand it to the gear</h4>
<ol>
<li>Give the track a built-in sound: FM6 (DX7 FM) or one of the others, chosen with <kbd>SHIFT</kbd>+<kbd>HOME / SRC</kbd>, <kbd>K1</kbd> or a pad, then the 4th button in the left group (after <kbd>SHIFT</kbd>, <kbd>FADER BANK</kbd>, <kbd>HOME</kbd>).</li>
<li>Set its SEQ to LOCAL or BOTH and play the song. You hear the part on the SMK-37.</li>
<li>Set OUT CH to the channel of the external synth, or set the song's output channel for the track in the song editor.</li>
<li>Set SEQ to MIDI. The part now plays on the gear only. Set it back to BOTH to hear both.</li>
</ol>
<p>Timing: MIDI out leaves in the audio block that holds the note's time. The built-in engine is one block looser, about 3 ms. The MIDI TRACK page's OUT CH readout shows the device setting even while a song overrides it. The project saves these settings; the song saves only its channel overrides.</p>
</article>
<article id="manual-tabby-bluetooth" class="manual-chapter" tabindex="-1"><h3>10 · Bluetooth settings</h3>
<p>The device no longer has a Bluetooth page. Pressing <kbd>BT</kbd> shows BLUETOOTH: SET IN WORKBENCH. The settings live in Projects &amp; sounds, in the Bluetooth settings group. The group is shown only when a device on tabby-v03.0 or later is connected with Connect project library.</p>
<ul>
<li><strong>Bluetooth on</strong> switches the radio. Off before a gig means no pairing attempts from phones in the room.</li>
<li><strong>Bluetooth audio</strong> switches the audio profile.</li>
<li><strong>BLE MIDI role</strong>: DEVICE lets a computer or tablet connect to the SMK-37. HOST makes the SMK-37 connect to a BLE MIDI device. The old scan list is gone; a HOST pairing is made by the other device.</li>
<li><strong>Forget MIDI pairs</strong> clears the saved pairings on the device after a confirmation. Remove the pairing on the computer or tablet as well, then pair again.</li>
</ul>
<p>Every change is written to the device at once and saved there. The message under the group confirms it. Bluetooth MIDI itself still works as before, with the same per-track input channels as USB MIDI. The clock source stays on the device: the SYNC / MIDI page (<kbd>SEQ</kbd>), K2 CLK IN (AUTO, USB, BLE; DIN receives nothing on the Pro and Elite).</p>
<p class="manual-note">Cables are the better choice for notes and clock. Bluetooth MIDI adds delay and jitter that a wired MIDI OUT or USB does not. For a locked M8 and for the timing described in chapter 07, use the cable.</p>
</article>
<article id="manual-tabby-storage" class="manual-chapter" tabindex="-1"><h3>11 · Storage</h3>
<h4>The song pool</h4>
<p>Song storage is the flash area that held the sample bank and the DX7 user library on V01. It holds 16 song records and a pool of 80 block sectors (96 before tabby-v04.0 moved the storage). Blocks of every song share the pool. A freshly erased area reports 326080 bytes free. Storage status in the Song mode group shows the free bytes, the reclaimable bytes, and the state of the loaded song: its event count, the late count and every track's state.</p>
<h4>Compaction</h4>
<p>Writing a song again, or deleting one, leaves its old blocks in the pool as garbage. They keep their bytes until a compaction. Storage status shows them as reclaimable. To reclaim them, open ACTIONS, choose COMPACT SONG STORAGE and press the 4th button in the left group (after <kbd>SHIFT</kbd>, <kbd>FADER BANK</kbd>, <kbd>HOME</kbd>); the screen asks COMPACT SONG STORAGE? and a second the 4th button in the left group (after <kbd>SHIFT</kbd>, <kbd>FADER BANK</kbd>, <kbd>HOME</kbd>) confirms. The SONG page shows COMPACTING STORAGE... for a few seconds. One sector is rewritten per control cycle, with a short audio dip per sector if something plays. The action is refused while a song plays. When the pool is full during a write, the device compacts the most rewarding sector by itself.</p>
<h4>Exporting and importing .tabby files</h4>
<p>Export .tabby in the song editor saves the song as one file: the song record and every block, plus the song's own rig copy when it has one. Import .tabby loads such a file into the editor; click Write song to put it on the device. The MIDI importer's Export .tabby file writes the same format. Files from tabby-v02.0 load and are written back in the current format.</p>
<h4>Writing pauses audio briefly</h4>
<p>Every flash erase and write silences the audio for a moment. A song write makes a few pauses at the end of each batch of blocks. Write songs before the set, not during it.</p>
<p class="manual-note">Restore factory V16 overwrites the last 40 KB of song storage: block sectors 70 to 79 of the 80 (flash 0xF4000 to 0xFDFFF). A device still on the old 536576 layout loses block sectors 86 to 95 of 96 instead. Export every song as a .tabby file before you restore the factory firmware. Projects are stored elsewhere and are not affected by songs at all.</p>
</article>
<article id="manual-tabby-quickref" class="manual-chapter manual-quickref" tabindex="-1"><h3>12 · Quick reference</h3>
<div class="manual-table"><table><thead><tr><th scope="col">Page</th><th scope="col">Control</th><th scope="col">Action</th></tr></thead><tbody>
<tr><td>Any page</td><td><kbd>SEQ</kbd>+<kbd>EDIT</kbd> together</td><td>Open ACTIONS (COPY TIMBRE, PASTE TIMBRE, STOP ALL / REWIND, ERASE OLD DATA, SONG MODE, COMPACT SONG STORAGE, SEND SETUP).</td></tr>
<tr><td>Any page</td><td><kbd>SEQ</kbd></td><td>SYNC / MIDI: K1 CLOCK (INT, MIDI), K2 CLK IN (AUTO, USB, BLE; DIN receives nothing on the Pro and Elite), K3 SWING, K4 SEQ OUT (OFF, ON, CLOCK), <kbd>K7</kbd> KEY OUT. Songs need INT.</td></tr>
<tr><td>Any page</td><td><kbd>HOME</kbd>+<kbd>SEQ</kbd></td><td>Tap the tempo.</td></tr>
<tr><td>HOME</td><td><kbd>K4</kbd></td><td>BPM (the only tempo control; read only with MIDI clock).</td></tr>
<tr><td>Any page, while playing</td><td>the 4th button in the left group (after <kbd>SHIFT</kbd>, <kbd>FADER BANK</kbd>, <kbd>HOME</kbd>), ERASE OLD DATA, COMPACT</td><td>Nothing is written to flash while a song or the pattern plays: the screen says STOP TO SAVE (or STOP TO ERASE / COMPACT), the workbench says the device is playing and sends nothing. Setting changes made while playing are kept and saved after the stop.</td></tr>
<tr><td>Any page</td><td><kbd>BT</kbd></td><td>Shows BLUETOOTH: SET IN WORKBENCH. Settings are in the workbench.</td></tr>
<tr><td>Any page</td><td><kbd>SHIFT</kbd>+pad 1 to 8 / 9 to 16</td><td>Select track / toggle mute.</td></tr>
<tr><td>Any page</td><td><kbd>SHIFT</kbd>+<kbd>SEQ</kbd></td><td>MIDI TRACK: K1 IN CH, K2 OUT CH, K3 SEQ (LOCAL, BOTH, MIDI), K4 OUT PORT.</td></tr>
<tr><td>Any page</td><td><kbd>SHIFT</kbd>+<kbd>HOME / SRC</kbd></td><td>SOUND SOURCE: K1 or pads choose, K2 TRACK mode, the 4th button in the left group (after SHIFT, FADER BANK, HOME) applies.</td></tr>
<tr><td>Any page</td><td><kbd>HOME</kbd>+<kbd>PLAY</kbd></td><td>Stop all sound and rewind.</td></tr>
<tr><td>ACTIONS</td><td><kbd>K5</kbd> or <kbd>K1</kbd>, the 4th button in the left group (after <kbd>SHIFT</kbd>, <kbd>FADER BANK</kbd>, <kbd>HOME</kbd>), <kbd>HOME</kbd></td><td>Choose the entry, run it, cancel. SONG MODE opens the SONG page.</td></tr>
<tr><td>SONG</td><td><kbd>K5</kbd> or <kbd>K7</kbd></td><td>Choose song 1 to 16 (stopped only).</td></tr>
<tr><td>SONG</td><td><kbd>PLAY</kbd></td><td>Start at row 1 / stop and send MIDI Stop.</td></tr>
<tr><td>SONG</td><td>Pad 1 to 16</td><td>Queue a jump to that row of the pad page.</td></tr>
<tr><td>SONG</td><td><kbd>OCT−</kbd> / <kbd>OCT+</kbd></td><td>Pad page down / up by 16 rows.</td></tr>
<tr><td>SONG</td><td><kbd>K4</kbd></td><td>JUMP: NEXT BAR / JUMP: ROW END.</td></tr>
<tr><td>SONG</td><td><kbd>SCL</kbd></td><td>Open TRACK LAUNCH.</td></tr>
<tr><td>SONG</td><td><kbd>HOME</kbd></td><td>Back to the overview; the song keeps playing.</td></tr>
<tr><td>TRACK LAUNCH</td><td><kbd>SHIFT</kbd>+pad 1 to 8</td><td>Select the track.</td></tr>
<tr><td>TRACK LAUNCH</td><td>Pad (dim white)</td><td>Queue that pattern for the selected track, next bar.</td></tr>
<tr><td>TRACK LAUNCH</td><td>Pad (green)</td><td>Queue a stop of the playing pattern, next bar.</td></tr>
<tr><td>TRACK LAUNCH</td><td><kbd>ENV</kbd> / <kbd>SHIFT</kbd>+<kbd>ENV</kbd></td><td>Selected track / every track back to the song, next bar.</td></tr>
<tr><td>TRACK LAUNCH</td><td><kbd>OCT−</kbd> / <kbd>OCT+</kbd></td><td>Pattern page down / up by 16 rows.</td></tr>
<tr><td>TRACK LAUNCH</td><td><kbd>SCL</kbd> / <kbd>PLAY</kbd> / <kbd>HOME</kbd></td><td>Back to SONG / start or stop the song / overview.</td></tr>
<tr><td>DX7 track</td><td><kbd>EDIT</kbd></td><td>DX7 QUICK EDIT: K7 voice, K6 bank A to D, K1 to K4 ALGORITHM, FEEDBACK, TRANSPOSE, LEVEL.</td></tr>
<tr><td>Workbench, Play &amp; edit</td><td>Song mode / Track launch</td><td>Open page 19 / page 20 in the browser simulator.</td></tr>
<tr><td>Workbench, Projects &amp; sounds</td><td>Connect project library</td><td>Then Song mode, Import MIDI file, Rig setup, Bluetooth settings.</td></tr>
<tr><td>Workbench, Device update</td><td>Connect device, Start update</td><td>Install the firmware. Version and build ID on the tab.</td></tr>
</tbody></table></div>
</article>
<article id="manual-start" class="manual-chapter" tabindex="-1"><h3>13 · Get started (synth)</h3>
<p>The version shows at the top of the web page and on the device's boot screen; HOME shows whether KEY or PAD has the playing focus. The boot animation takes about 1 s; any key or knob skips it. Nothing plays by itself at boot.</p>
<p>Classic Tabby has <strong>8 tracks, 5 engines and 16 user project slots</strong>. Each track’s pattern is 16, 32, 48 or 64 steps long, as set by the project. This version does not edit steps on the device; songs and detailed editing are in the web workbench.</p>
<ol><li><strong>Prepare to listen. </strong>Set device MASTER to a moderate level. In the browser, press a key or Play to hear sound; no extra switch is needed.</li><li><strong>Try a preset. </strong>On HOME, turn K7 to change the whole project and press PLAY. You can also press HOME for the list, load with K7 / K5, or press PLAY to load and play. The 4th button in the left group (after SHIFT, FADER BANK, HOME) opens project saving; pads 1–16 select directly.</li><li><strong>Shape the sound. </strong>On the overview, K5 chooses a track. On a DX7 track a short EDIT press opens the quick page: turn K7 to change the voice, K6 for banks A–D, K1–K4 for algorithm, feedback, transpose and level; press EDIT again to return. Sounds of the other engines are edited in the workbench. To change engines, turn K6 or K2 on the overview, then press the 4th button in the left group (after SHIFT, FADER BANK, HOME).</li><li><strong>Set the clock. </strong>Press SEQ to open SYNC / MIDI: K1 chooses the INT or MIDI clock, K3 sets SWING and K4 sets SEQ OUT. Tempo is K4 on HOME. Rhythm and notes are written in the web workbench, in songs and projects.</li><li><strong>Balance the mix. </strong>Press MIX. Pads 1–8 mute and 9–16 solo. K5 chooses a track; K1–K4 adjust four track levels. Press MIX or HOME to return.</li><li><strong>Save your work. </strong>Press the 4th button in the left group (after SHIFT, FADER BANK, HOME), choose a USER slot with K5, then press the 4th button in the left group (after SHIFT, FADER BANK, HOME) again. Replacing another occupied slot asks for confirmation. The panel returns after saving.</li></ol>
<p class="manual-note">“Save to device” at the top writes a chosen device slot. “Save in this browser” stores a browser copy; “Export project file” makes a computer backup. On the device, the 4th button in the left group (after SHIFT, FADER BANK, HOME) writes a device slot.</p></article>
<article id="manual-panel" class="manual-chapter" tabindex="-1"><h3>14 · Panel &amp; shortcuts</h3>
<div class="manual-table"><table><thead><tr><th scope="col">Control</th><th scope="col">What it does</th></tr></thead><tbody>
<tr><td>HOME</td><td>Return from editing to the eight-track overview. From the overview, open the preset list; press again to cancel.</td></tr>
<tr><td>K5</td><td>Selects the track on the overview, DX7 quick page, SYNC / MIDI, MIDI TRACK and mixer; selects the entry in menus; selects the song on SONG.</td></tr>
<tr><td>K7</td><td>On HOME, change the complete project preset; on the DX7 quick page, the track voice; in the preset browser, the project; on the save page, the slot; on the SONG page, the song.</td></tr>
<tr><td>K6</td><td>On HOME, preview a sound engine, then the 4th button in the left group (after SHIFT, FADER BANK, HOME) to apply or HOME to cancel. K6 changes parameter pages in ARP / FX and switches banks A–D on the DX7 quick page.</td></tr>
<tr><td>K1 / K2 / K3 / K4</td><td>HOME: K1 level, K2 engine, K4 tempo. SYNC / MIDI: K1 CLOCK, K2 CLK IN, K3 SWING, K4 SEQ OUT. On other pages, follow the bottom labels.</td></tr>
<tr><td>EDIT: tap / hold</td><td>On a DX7 track, tap to enter or leave the quick page (K7 selects the voice, K6 the bank, K1–K4 algorithm, feedback, transpose and level). On other engines EDIT shows VOICE EDIT MOVED TO WORKBENCH; those sounds are edited in the workbench.</td></tr>
<tr><td>SEQ: tap, or with EDIT</td><td>Tap on any page to open SYNC / MIDI; SHIFT + SEQ opens MIDI TRACK; SEQ + EDIT pressed together open the ACTIONS menu; HOME + SEQ taps the tempo.</td></tr>
<tr><td>MIX</td><td>Tap to enter or leave the mixer. Pads 1–8 mute and 9–16 solo. You do not need to keep MIX held.</td></tr>
<tr><td>PLAY / REC</td><td>Play, pause, continue. REC does not record in this version (the screen says NO REC IN THIS VERSION). On the preset page PLAY loads and plays; changing presets asks nothing.</td></tr>
<tr><td>The 4th button in the left group (after SHIFT, FADER BANK, HOME)</td><td>Open the save page, then press again to save. Execute / confirm in menus. HOME cancels.</td></tr>
<tr><td>OCT− / OCT+</td><td>Transpose the playing octave down or up; on SONG and TRACK LAUNCH, page the pads.</td></tr>
<tr><td>ENV / SHIFT + ENV / FX / SCL</td><td>FX edits track reverb and delay. SCL switches between the SONG and TRACK LAUNCH pages; ENV sends the selected track back to the song, SHIFT + ENV every track. On other pages SCL, ENV and SHIFT + ENV only say that voice editing moved to the workbench.</td></tr>
<tr><td>ARP</td><td>Tap to toggle the current track arpeggiator / drum repeats; hold for about 0.6 seconds for settings. K5 chooses a track; K6 switches between rate / direction / range / gate and Swing / Hold.</td></tr>
</tbody></table></div>
<p>The 37 velocity keys always play notes. Tap PAD / STEP to switch KEY/PAD editing focus (there is no pad-step mode in this version). Pads select items in menus. Encoders are K1–K8 from the left (the firmware calls K5 SELECT, K6 PAGE, K7 PRESETS and K8 MASTER). Four faders control track levels; FADER BANK selects tracks 1–4 or 5–8. A fader takes over after crossing the stored value. BT reminds you that Bluetooth settings moved to the web workbench; SHIFT + HOME / SRC opens sources. Pitch, modulation and sustain follow KEY; Pad aftertouch follows PAD.</p>
<p>On the overview, K4 sets the tempo; HOME + SEQ taps it. This version has no recording and no step editing on the device; songs are written in the web workbench.</p>
<p>Mute and solo are mutually exclusive on each track: enabling solo clears that track’s mute, and enabling mute clears its solo. Other tracks keep their settings.</p>
<h4>Web controls</h4><p>Choose a preset and press Play. Read &amp; save contains device reading and browser saves. Files &amp; MIDI imports and exports projects and sounds.</p><p>The main buttons open sound, SYNC / MIDI, mixer and effects; other controls are in More editing. Drag or scroll knobs, or click LCD values. Play with Z, S, X, D…; Space plays and Esc stops notes. Typing and menu actions do not play notes.</p>
<p>The top row of buttons works on every page: FX, EDIT (DX7 track), MIX and SEQ open their pages; SCL, ENV and LFO act only on the song pages (chapter 05); ARP toggles with a tap and opens its settings when held; PLAY controls playback. The 4th button in the left group (after SHIFT, FADER BANK, HOME) opens the project save page or confirms the prompt on screen; OCT− / OCT+ change the octave. Leaving a confirmation page runs nothing.</p>
<h4>Edit LCD values directly</h4><p>Hover over an LCD value: a highlight means it is editable with the mouse wheel. Each step uses the parameter's smallest increment, without scroll-speed acceleration. Click to open a larger value display, then use the wheel, + / − or arrow keys; Esc closes it. Editable values include bottom parameters, top BPM, overview track levels, the DX7 quick page's rows and the effect rows. Mixer mute / solo cells are also editable. Status, meters and unsupported engine parameters remain read-only; external MIDI clock controls BPM. Changing tracks or parameter pages closes the old editor to prevent editing the wrong value. Adjusting another track's small level on the overview does not change your selected track.</p>
<p>Tap MIX (less than 0.6 seconds) to enter or leave the mixer. Hold for 0.6 seconds for a momentary mixer view; release to return. A progress bar appears at the top while holding MIX, EDIT, SEQ or ARP.</p>
<p>SHIFT + Pads 1–8 select tracks; SHIFT + Pads 9–16 toggle their mute. The upper half highlights the selected track; orange in the lower half means muted. Release SHIFT to restore the pads.</p><p>SHIFT + SEQ opens MIDI TRACK: K1 IN CH selects the input channel, K2 OUT CH selects the output channel, K3 SEQ selects LOCAL / BOTH / MIDI, and K4 OUT PORT selects ALL / OFF. Input and output channels are independent; several tracks can share an input channel.</p><p>K2 TRACK on SHIFT + HOME / SRC immediately selects PROJECT / LIVE / OFF: PROJECT follows the project, LIVE retains its sound and held notes across project changes, and OFF frees instrument memory. Existing NORMAL / PLAY preferences map to PROJECT / LIVE. Export LIVE timbres separately; projects store the arrangement. Mode and input-channel preferences are remembered. Release notes before changing them. K1 still previews a source, the 4th button in the left group (after SHIFT, FADER BANK, HOME) applies it, and HOME returns.</p><h4>Button combinations</h4><p>HOME+PLAY stops all sound and returns to the start; HOME + the 4th button in the left group (after SHIFT, FADER BANK, HOME) toggles undo / redo of the last change; SEQ+EDIT opens the ACTIONS menu, . To lock a button in the web panel, Shift-click or right-click it, then click to release; daily use does not need this.</p></article>
<article id="manual-sequence" class="manual-chapter" tabindex="-1"><h3>15 · Sync &amp; MIDI</h3>
<p>The 128 DX7-format presets are arranged in banks A–D of 32 voices each. The workbench imports a standard DX7 single-voice or 32-voice SysEx file to a track; extended parameters are not supported. The device no longer has a DX7 user library.</p>
<p>Press SEQ on any page to open SYNC / MIDI: K1 CLOCK chooses INT or MIDI, K2 CLK IN the clock source (AUTO, USB or BLE; DIN receives nothing on the Pro and Elite, do not choose it), K3 SWING, K4 SEQ OUT chooses OFF, ON or CLOCK, K7 switches KEY OUT. The tempo is set only on HOME K4; with external MIDI clock the source sets it. SEQ + EDIT together open ACTIONS.</p>
<p>Changing the clock stops playback. MIDI mode needs an external Start or Continue and Clock; while waiting the screen says WAIT MIDI CLOCK. The external BPM is read only. Song mode needs the INT clock.</p>
<p>On first use the 8 tracks' SEQ is BOTH, KEY OUT is ON, OUT PORT is ALL and SEQ OUT is ON; saved output modes and the KEY OUT choice are kept. MIDI TRACK page (SHIFT + SEQ): K1 IN CH the input channel, K2 OUT CH the send channel, K3 SEQ LOCAL / BOTH / MIDI, K4 OUT PORT ALL / OFF. SYNC / MIDI page: K4 SEQ OUT OFF (no sequencer notes and no master clock) / ON (sequencer notes and the internal clock with Start and Stop) / CLOCK (only the internal clock with Start and Stop); K7 switches KEY OUT. SEQ mode and SEQ OUT do not affect ARP: ARP is always BOTH (built-in sound and MIDI out) and sends on the track's OUT CH and the common OUT PORT. Changing SEQ settings does not interrupt ARP, and switching ARP does not release sequencer notes. ARP page 2 keeps only SWING, HOLD and OUT CH; K3 does nothing. To send the clock alone, switch off KEY OUT and every track's ARP. For per-track output over USB-C set OUT CH per track and use BOTH or MIDI, ALL and SEQ OUT ON; changing IN CH alone does not change the output channel. After an update local playing always works and Thru is off; an old port combination with any output becomes ALL, OFF stays. These preferences are independent of the project; the web page only previews them, set them on the device.</p>
<h4>Arpeggiator: rate, direction, Swing and Hold</h4><p>Tap ARP and hold notes; hold ARP to open settings. K6 switches two pages: page 1 has K1 rate (1/4, 1/8, 1/16, 1/32), K2 direction, K3 range (1–4 octaves), K4 gate (25%–100%); page 2 has K1 Swing (0%–50%) and K2 Hold. Hold keeps a released chord; release all keys and play a new chord to replace it. Turning Hold off, Stop or Panic releases latched notes. K5 chooses a track; settings are independent per track. K4 on HOME changes BPM. External clock needs Start / Continue and Clock; Swing follows 24 PPQN resolution.</p><p>808 supports rate, direction, Swing and Hold. Range and gate show “--”; drum parts are not transposed. ARP enable and all six settings are saved with the project; held or latched notes are not.</p>
<h4 data-removed-ok>Device editing removed in this version</h4><p data-removed-ok>tabby-v04.0 removes the step editing on the device: the STEP DETAILS, LOCKS and RHYTHM/REC pages, REC recording (step entry while stopped and recording while playing), the count-in, the metronome, pad-step mode, and copying, pasting, clearing and repeating steps with their ACTIONS entries. The patterns already in a project still load, save and play with it. SWING, the clock, the clock source and the output switches moved to the SYNC / MIDI page; the tempo is on HOME K4. The metronome and the count-in are planned to return in a later version (Phase 5).</p>
</article>
<article id="manual-sound" class="manual-chapter" tabindex="-1"><h3>16 · Five sound engines</h3>
<p>Every track can use any of the sources, and several tracks of one type each keep their own parameters. A new source starts with its type's defaults; swapping drums and melody clears the steps that do not fit, and HOME + the 4th button in the left group (after SHIFT, FADER BANK, HOME) undoes it.</p>
<div class="manual-table"><table><thead><tr><th scope="col">Engine</th><th scope="col">How to edit</th></tr></thead><tbody>
<tr><td>DX7 · FM</td><td>Tap EDIT for the quick page: K7 selects voices 1–128, K6 switches banks A–D, and K1–K4 adjust algorithm, feedback, transpose and level. Tap again to return. Operator-level editing and .syx import happen in the workbench.</td></tr>
<tr><td>303 · Acid bass</td><td>Parameters are edited in the workbench: Cutoff / Reso / EnvMod / Decay; Accent / Wave / Tune / Volume; Drive / DrvTyp / Slide / AccDec; Mono / Poly selects monophonic slide or four-voice polyphony. Program Change 0 / 1 switches saw / square.</td></tr>
<tr><td>808 · Synthesized drums</td><td>The parameters of the 11 drum parts and KIT are edited in the workbench; available parameters depend on the part, and KIT adjusts the whole kit. On the device, a key or pad auditions and selects the part.</td></tr>
<tr><td>PSG · Chip sounds</td><td>Edited in the workbench: MODE (YM / AY / NOISE / MIX), NOISE, TUNE and RELEASE. NOISE has no effect in a pure square-wave mode.</td></tr>
<tr><td>PLUCK · Plucked strings</td><td>Edited in the workbench: DECAY, BRIGHT, TUNE and RELEASE. DECAY is the natural decay; RELEASE is decay after key release. A held note still decays naturally. Brightness changes apply to the next pluck.</td></tr>
</tbody></table></div>
<h4>Envelopes &amp; LFO</h4><p>The device's ENV and LFO pages moved to the workbench with voice editing. Each engine's envelope (FM ADSR, 303 EnvMod / Decay / AccDec, PSG and Pluck Release and so on) and the track LFO of the non-FM engines (rate, depth, tremolo / pan, waveform) are edited in the browser and saved with the project and the track sound. The LFO acts on the whole track, including its effect sends. Effects use FX.</p>
<h4>DX7 patch names</h4><p>The device's DX7 PATCH NAME page is gone. Patch names come with the .syx voices imported in the workbench and are saved with the project. Switching a built-in DX7 voice replaces the current edit.</p>
<h4>Track effects</h4><p>Press FX and select a track with K5. K1 sets reverb send, K2 delay send; 0 disables that track send. All five engines are supported. K3 is track volume and K4 is the shared effects return. Turn K7 to the second page for shared reverb time, delay time, feedback and return. Track sends are saved with projects and sounds. Shared effect settings are saved only with the project. Muting stops new sends while existing tails decay.</p>
</article>
<article id="manual-mix" class="manual-chapter" tabindex="-1"><h3>17 · Volume &amp; mixing</h3>
<p><strong>MASTER controls the final output level. </strong>The physical knob controls the final synthesizer, USB and Bluetooth input output, including USB recording. Minimum mutes. Its position remains in effect when changing projects and is not saved per project. Turning it briefly displays a MASTER percentage or MASTER MUTED.</p><p><strong>Track LEVEL is the mix level saved in a project. </strong>On HOME, K1 adjusts track level. The 303 Volume and 808 part Level balance sounds within the engine.</p>
<ol><li>Tap MIX for the mixer; pads 1–8 toggle track mute.</li><li>Tap MIX for the mixer; pads 9–16 toggle track solo.</li><li>In the mixer, K5 chooses a track; K1–K4 adjust its group of four tracks (1–4 or 5–8).</li></ol>
<p>Multiple tracks can be soloed; a track cannot be muted and soloed at the same time.</p><p>Browser Mute silences monitoring while editing and sequencing continue. Use HOME+PLAY or Panic / Stop all to stop and return to the start.</p>
</article>
<article id="manual-project" class="manual-chapter" tabindex="-1"><h3>18 · Saving &amp; files</h3>
<p class="manual-note"><strong>The workspace is not a saved project. </strong>Unsaved device edits exist only in memory and are lost on restart or when loading another project. Browser and device saves are separate. “Save to device” transfers, writes the slot and reads it back to verify it.</p>
<h4>Switching presets and saving are separate</h4><p>PROJECT timbre edits are saved with projects. For LIVE timbre edits, export a track sound file. Project backups do not include songs; back up each song with Export .tabby.</p><p><strong>Switch directly: </strong>On HOME, turn K7 to change the whole preset. The screen shows the current project name. Playback continues if running, or stays stopped. Changes apply immediately without a save prompt. Use K7 on EDIT for single-track sounds.</p><p><strong>Browse the list: </strong>Press HOME on the overview to open the user project list (16 user slots). K7 / K5 loads the selected number immediately. PLAY loads and plays; the 4th button in the left group (after SHIFT, FADER BANK, HOME) opens project saving. Pads 1–16 select directly and preserve playback state. An empty USER slot displays a message and keeps the current project.</p><p>Switching projects replaces the workspace, including unsaved edits. Press the 4th button in the left group (after SHIFT, FADER BANK, HOME) first when you want to keep changes.</p><p><strong>Save: </strong>Press the 4th button in the left group (after SHIFT, FADER BANK, HOME), select a USER slot with K5 / K7, choose a name character with K1 and change it with K2. Press the 4th button in the left group (after SHIFT, FADER BANK, HOME) to write. Replacing another occupied slot requires a second press of the 4th button in the left group (after SHIFT, FADER BANK, HOME). After success, the previous page returns; HOME cancels. The current slot updates directly. An asterisk in the title indicates unsaved changes.</p>
<p>The top status bar distinguishes browser preview, device connection and browser edits not yet written. Connecting does not read or sync automatically. Read device project in the main controls replaces the browser workspace; HOME + the 4th button in the left group (after SHIFT, FADER BANK, HOME) can undo it. Written status requires matching read-back; saving in the browser does not write SMK37 OPEN. Read again after editing on the device.</p><p>Projects save each track’s ARP settings.</p>
<h4>Put your browser project on SMK37 OPEN</h4><ol><li>Connect SMK37 OPEN with a USB data cable. Finish editing in the browser, then click “Save to device”.</li><li>Allow MIDI / SysEx, choose the target slot and click “Save and verify”. Existing content in that slot will be replaced.</li><li>Wait for the read-back verification message before disconnecting. After restarting, load the slot from USER. You do not need to press the 4th button in the left group (after SHIFT, FADER BANK, HOME) on the device again.</li></ol>
<p>“Read device project” brings the device workspace into the browser. “Restore to workspace” does not overwrite a device slot automatically. The browser panel's 4th button in the left group (after SHIFT, FADER BANK, HOME) writes a local browser slot. Clearing browser data removes those saves, so export important work.</p>
<div class="manual-table"><table><thead><tr><th scope="col">File</th><th scope="col">Contents</th></tr></thead><tbody><tr><td>.fm1</td><td>A complete eight-track project: engines, parameters, track levels, loop lengths, steps and more. Does not include songs.</td></tr><tr><td>.fm1t</td><td>One track’s engine, sound parameters and level, without steps. Supports all five engines.</td></tr><tr><td>.syx</td><td>Standard DX7 single patches and 32-patch banks. The target device track must use DX7.</td></tr><tr><td>.tabby</td><td>One song: the song record and all of its blocks, with the song's own rig copy when it has one. See chapter 11.</td></tr></tbody></table></div>
<p>If the project list cannot be read, load, save and import remain disabled. Click Refresh list to retry. Operations become available only after the full list has been read; a valid selected slot is preserved when retrying.</p></article>
<article id="manual-connect" class="manual-chapter" tabindex="-1"><h3>19 · MIDI, Bluetooth &amp; clock</h3>
<h4>USB &amp; browser connection</h4><p>Download the complete HTML for offline play and editing. Device transfer needs desktop Chrome / Edge with Web MIDI, a USB data cable and permission for MIDI / SysEx. If connection fails, close other pages or apps using MIDI, then reconnect. For external performance, use the target track's input channel; press SHIFT + SEQ and use K2 to view or change it.</p><p>“Connect MIDI input” lets an external keyboard play the browser instrument. The project-library connection transfers projects and sounds to the device. Choose USB audio input / output in your computer or music software settings.</p>
<p>USB MIDI receives at startup; Bluetooth MIDI is controlled from the workbench (Projects &amp; sounds → Bluetooth settings). Both use the track input-channel settings. The TRS jack of the Pro and Elite only outputs MIDI and cannot be a MIDI input (the firmware has no DIN receive, so CLK IN set to DIN receives nothing on the SYNC / MIDI page); bring external clock and notes in over USB or Bluetooth.</p>
<h4>Channels and receive rules</h4><p>By default, CH1–7 address tracks 1–7 and CH10 addresses track 8. Press SHIFT + SEQ and use K2 to assign each track an input channel from 1 to 16. Notes, pitch bend, modulation and controllers follow these settings regardless of the selected screen track. Several tracks can share a channel to layer sounds. Messages on unassigned channels are ignored. Changing engines does not change channels; USB MIDI and BLE MIDI use the same rules.</p><p>With the default settings, keyboard CH2 controls track 2. Set track 3's input to CH2 as well to play both tracks together.</p>
<div class="manual-table"><table><thead><tr><th scope="col">Received message</th><th scope="col">Action and scope</th></tr></thead><tbody>
<tr><td>Note On / Off</td><td>All engines receive Note On / Off and velocity; zero-velocity Note On is Note Off. The 808 uses drum notes to select parts.</td></tr>
<tr><td>Pitch Bend</td><td>FM, 303, PSG and Pluck receive 14-bit pitch bend, centered at 8192, with a ±2-semitone range. It affects held and subsequent notes. Use each part’s TUNE for 808 pitch.</td></tr>
<tr><td>CC1 · Mod Wheel</td><td>FM: pitch vibrato, with a basic wheel response even when patch PMS is 0. 303: EnvMod. PSG, Pluck and 808: track LFO depth, defaulting to volume tremolo when no LFO is configured.</td></tr>
<tr><td>CC7 / CC10 / CC11 / CC91</td><td>All engines: CC7 track volume; CC10 pan (0 left, 64 center, 127 right); CC11 expression (0 silent, 127 full level); CC91 reverb send.</td></tr>
<tr><td>CC64 / Channel Pressure / CC2 / CC4</td><td>FM, 303, PSG and Pluck: CC64 sustain, 64–127 down and 0–63 up. FM also receives channel pressure for vibrato and CC2 / CC4 for amplitude control, subject to patch amplitude sensitivity.</td></tr>
<tr><td>CC120 / CC121 / CC123</td><td>CC120 stops the track’s voices; CC123 releases its external notes (sustain still applies); CC121 resets live bend, expression, pan, modulation and sustain without changing sound parameters.</td></tr>
<tr><td>Program Change</td><td>Program Change uses SMK37 OPEN sounds: FM cycles through 0–15; 303 uses 0 / 1 for saw / square; PSG uses 0–3 for YM / AY / NOISE / MIX. Other engines ignore it. Some software displays numbers starting at 1.</td></tr>
<tr><td>Engine CC</td><td>303 also receives CC5 slide time, CC71 resonance, CC74 cutoff and CC75 decay. PSG receives CC74 noise and CC72 release. Pluck receives CC74 brightness, CC75 decay and CC72 release.</td></tr>
</tbody></table></div><p>CC7, CC91, program changes and sound parameter edits can be saved in projects. Bend, expression, pan and live modulation are not stored. CC121 does not undo edited 303 EnvMod. SMK37 OPEN retains its own sound system and does not provide the GM 128-program sound set.</p>
<h4>Synchronization and transport</h4>
<p>Clock, Start, Continue, Stop, Song Position and MMC are not MIDI channel messages: they control the whole device. With MIDI clock selected, external Clock synchronizes at 24 pulses per quarter note. Clock alone does not start playback. Start begins from the start, Continue resumes at the current position, and Stop stops playback and releases sequence / arpeggiator notes.</p><p>Song Position Pointer (F2) locates in MIDI clock mode. Each unit is one sixteenth note, wrapped to each track’s loop length. In song mode (an armed or following song) the pointer moves the song: through its rows and repeats, running or stopped. Follow it with Continue and Clock. Start returns to the beginning. System Reset (FF) stops, rewinds and releases all notes.</p><p>MMC: Stop (01), Play (02), Deferred Play (03), Record Strobe (06), Record Exit (07) and Pause (09), for device ID 00 or the broadcast 7F. Play, Deferred Play and Record Strobe continue from the current position, Record Exit does nothing (no recording in this version), Stop and Pause stop. In MIDI clock mode an external Clock is still needed.</p><p>Examples: F0 7F 7F 06 01 F7 is MMC Stop; F0 7F 7F 06 02 F7 is MMC Play. Numbers are hexadecimal.</p><p>When several MIDI devices are connected, use only one clock and transport master to avoid duplicate pulses. MTC time code, MMC time-code locate / fast-forward / rewind, RPN / NRPN, polyphonic pressure, GM Reset, Bank Select, Active Sensing timeout monitoring and unlisted controllers are not implemented and are ignored.</p>
<h4>Bluetooth settings</h4><p>The device has no Bluetooth page (to free flash for independent track launching); the BT button only tells you to use the workbench. Bluetooth settings live in the workbench under Projects &amp; sounds → Bluetooth settings: with the library connected you can switch Bluetooth and Bluetooth audio on or off, choose the BLE MIDI DEVICE / HOST role and forget MIDI pairs; every change is written to the device and saved at once. MIDI is available whenever Bluetooth is on. Factory defaults are Bluetooth and audio on, DEVICE role. The clock source is chosen on the SYNC / MIDI page (press SEQ). The HOST-mode device scan and connection list are no longer offered.</p>
<h4>INT &amp; MIDI clock</h4><p><strong>INT:</strong>SMK37 OPEN uses its internal tempo; K4 sets 30–300 BPM. <strong>MIDI:</strong>SMK37 OPEN follows external MIDI Clock and waits for Start / Continue. The tempo knob does not change the external tempo. After about two seconds without clock, the screen shows LOST. Check that the external device is sending clock, or return to INT.</p>
</article>
<article id="manual-update" class="manual-chapter" tabindex="-1"><h3>20 · Firmware updates</h3><p>Download the Pro workbench for your device. Connect USB, export project and song (.tabby) backups, then connect in Device update, confirm your backup and update. Updating from one tabby firmware to another never needs force flash. Only for the first migration from the same model’s factory firmware, tick Force flash by hand under Migration, factory restore and forced updates. The page verifies the model and the build hash afterward. Pro and Elite firmware are not interchangeable.</p>
<p>Choose Restore factory V16 under Migration, factory restore and forced updates. Check the model, back up your data and confirm. After firmware installation and resource read-back finish, power-cycle the device. To return to Open, choose Switch to Open firmware, reconnect and update, then restore projects and songs from their separate backups.</p><ol><li>In Projects &amp; sounds, back up the current project, then load and back up any other project slots you need; back up each song with Export .tabby. Export LIVE timbre edits separately as track sounds.</li><li>Open Device update in the latest workbench and connect SMK37 OPEN by USB. Firmware is included.</li><li>Check “I have backed up the sounds, projects and songs I want to keep”, click “Connect device” and allow MIDI / SysEx.</li><li>Check the device information, click “Start update” and maintain power and USB until completion.</li><li>Wait for restart and version verification. After the first install of tabby-v04.0 or later, if the device reports OLD DATA, choose ERASE OLD DATA in ACTIONS (see chapter 02 and "What changed in tabby-v04").</li></ol>
<p>A successfully completed update using the same storage layout preserves valid project slots and the song storage. Still back up projects, voices and songs separately before flashing. Unsaved memory edits are not restored after restart. Updating firmware does not transfer the browser project to the device automatically.</p><p>If the update is interrupted or the device stays in update mode: <strong>close this page, power-cycle the SMK-37, then open the page the loader asks for</strong> (the page shows its name and link; the list of every build is under builds/). Never force flash. Firmware without the USB-MIDI update protocol requires its matching recovery tool. Migration may erase projects and songs; back up first.</p>
<p>After reconnecting USB, click Connect again; old device information is cleared. Reconnect when switching between firmware update and the project library.</p><p>If connection fails, open Connection details to see the MIDI IN / OUT ports detected for this attempt. Missing ports, unpaired ports and no identity reply are different problems. Close other MIDI apps and updater tabs, then power-cycle, reconnect USB and connect again. Force flash cannot skip the device handshake.</p></article>
<article id="manual-help" class="manual-chapter" tabindex="-1"><h3>21 · Troubleshooting</h3>
<h4>No sound, or MASTER seems unresponsive</h4><p>In the browser, check Mute, output level and system volume. On SMK37 OPEN, check K8, track LEVEL, mute/solo and output connections. K8 at minimum mutes the output.</p>
<h4>PLAY does not advance</h4><p>Press SEQ for SYNC / MIDI and check whether K1 CLOCK is INT or MIDI; without an external clock switch back to INT. If playback runs but makes no sound, check that the track is not muted and its level is not zero.</p>
<h4>A knob does something unexpected</h4><p>Check the current page and bottom labels. K7 changes complete presets on HOME, track sounds or drum parts on EDIT, and KEY OUT on SYNC / MIDI. K1–K4 follow the bottom parameter page.</p>
<h4>Edits disappear after restart, or browser and device differ</h4><p>Save workspace edits to a USER slot. The browser panel's 4th button in the left group (after SHIFT, FADER BANK, HOME) stores only a browser copy. The device receives the project after “Save to device” completes.</p>
<h4>Stuck notes or held buttons</h4><p>On the device, press HOME+PLAY. In the browser, press Esc or “Panic / Stop all” and release any latched buttons. Stop playing, then close other MIDI input sources.</p>
<h4>The page cannot connect or buttons are unavailable</h4><p>The page never turns force flash on by itself. If it cannot connect, check that the device is powered and connected with a USB data cable, close other MIDI apps and workbench tabs, power-cycle the device if needed, then click Connect device.</p><p>Open the website link or full HTML in desktop Chrome / Edge, not an attachment preview that blocks scripts. Check MIDI / SysEx permission, the USB data cable and device connection. Close apps using the port. For secure-context errors, open the page over HTTPS or localhost.</p>
<p>The Play button, panel PLAY and Space enable sound before starting playback. If sound cannot start, playback stays stopped; resolve the browser audio issue and try again. Panic / Stop all or changing panel pages cancels pending playback while sound is starting.</p><p>Tap Tempo: hold HOME and tap SEQ on any page, or click TAP on the web page. Two taps start detection; up to four intervals are averaged over 30–300 BPM. In FX, turn K7 to DELAY: K1 toggles SYNC, K2 sets division or milliseconds, K3 sets internal BPM and K4 sets feedback. New projects default to synchronized eighth notes. With SYNC off, FREE holds a fixed time of about 30–2040 ms. Switching modes selects the nearest available time. T means triplet and D means dotted. Delay follows internal or external MIDI BPM and retains its last interval if clock is lost. Old projects keep their manual delay; projects using synchronized divisions or extended fixed times require updated firmware.</p></article>
</div></div>
</section>
<dialog id="about-dialog" class="save-dialog about-dialog" aria-labelledby="about-title"><h2 id="about-title">M-VAVE SMK37 OPEN</h2><p>© 2026 M-VAVE. APP: GPLv3 with an SDK linking exception; modification and redistribution are permitted under its terms. No warranty except as required by law or agreed in writing. See below for SDK and third-party terms.</p><p><a href="/*FM1_SOURCE_URL*/" target="_blank" rel="noopener noreferrer">Source + SDK</a> · <a href="https://forum.m-vave.com" target="_blank" rel="noopener noreferrer">Official forum</a></p><details><summary>Copyright and license notices</summary><pre>/*FM1_NOTICES*/</pre></details><form method="dialog"><button>Close</button></form></dialog>
</main>
<script>
/*FM1_I18N*/
/*FM1_PAYLOAD*/
/*FM1_SCRIPT*/
/*FM1_DEVICES*/
/*FM1_RIG_PROFILES*/
/*FM1_GUIDE_TEMPLATE*/
/*FM1_RIG_SCRIPT*/
/*FM1_IMPORT_SCRIPT*/
/*FM1_SIMULATOR*/
(() => {
  const $=id=>document.getElementById(id);
  // Task 08: the badge shows the Classic Tabby display version (the git tag); the Open label is the fallback.
  $('release-version').textContent=FM1_SIMULATOR.display_version||FM1_PACKAGE?.display_version||FM1_SIMULATOR.release_version||FM1_PACKAGE?.release_version||'';
  const pages=['sim','library','update','manual'];
  function showPage(name){
    for(const page of pages){const active=page===name;$('tab-'+page).hidden=!active;$('mode-'+page).setAttribute('aria-selected',String(active));$('mode-'+page).tabIndex=active?0:-1;}
    document.dispatchEvent(new Event('fm1-view-change'));
  }
  for(const name of pages){
    $('mode-'+name).addEventListener('click',()=>showPage(name));
    $('mode-'+name).addEventListener('keydown',event=>{
      let i=pages.indexOf(name);
      if(event.key==='ArrowRight')i=(i+1)%pages.length;
      else if(event.key==='ArrowLeft')i=(i+pages.length-1)%pages.length;
      else if(event.key==='Home')i=0;
      else if(event.key==='End')i=pages.length-1;
      else return;
      event.preventDefault();showPage(pages[i]);$('mode-'+pages[i]).focus();
    });
  }
  const chapters=[...document.querySelectorAll('.manual-chapter')];
  const chapterText=chapters.map(node=>node.textContent.toLocaleLowerCase());
  const chapterLinks=[...document.querySelectorAll('.manual-index a')];
  function searchManual(){
    const terms=$('manual-search').value.trim().toLocaleLowerCase().split(/\s+/).filter(Boolean);let count=0;
    chapters.forEach((node,i)=>{const match=terms.every(term=>(chapterText[i]+' '+node.textContent.toLocaleLowerCase()).includes(term));node.hidden=!match;chapterLinks[i].parentElement.hidden=!match;if(match)count++;});
    FM1I18n.text($('manual-count'),terms.length?'Found '+count+' / '+chapters.length+' chapters':chapters.length+' chapters');
    $('manual-empty').hidden=count!==0;$('manual-clear').hidden=!terms.length;
  }
  $('manual-search').addEventListener('input',searchManual);
  $('manual-clear').addEventListener('click',()=>{$('manual-search').value='';searchManual();$('manual-search').focus();});
  $('manual-print').addEventListener('click',()=>window.print());
  function openChapter(id){
    const chapter=chapters.find(node=>node.id===id);if(!chapter)return;
    if(chapter.hidden){$('manual-search').value='';searchManual();}
    showPage('manual');chapter.focus({preventScroll:true});chapter.scrollIntoView({block:'start'});
  }
  document.querySelectorAll('a[href^="#manual-"]').forEach(link=>link.addEventListener('click',event=>{
    event.preventDefault();const id=link.getAttribute('href').slice(1);
    history.replaceState(null,'','#'+id);openChapter(id);
  }));
  window.addEventListener('hashchange',()=>openChapter(location.hash.slice(1)));
  openChapter(location.hash.slice(1));
  let pkg,openPkg,stockPkg,updater,library,voices=[],projectBytes,timbreBytes,libraryReady=false,connected=false,busy=false,writing=false,finishingUpdate=false,same=false,migration=false,forceSuggested=false,updateResult='',watchedAccess,midiRequest;
  let connecting;
  function beginConnection(){
    const controller=new AbortController();
    const timer=setTimeout(()=>controller.abort(Error('Connection timed out. Check USB and MIDI permissions, then retry.')),12000);
    connecting={controller,timer};enable();return connecting;
  }
  async function endConnection(attempt){
    clearTimeout(attempt.timer);
    if(attempt.controller.signal.aborted){
      libraryReady=false;connected=false;
      await Promise.allSettled([library?.disconnect(),updater?.disconnect()]);
    }
    if(library?.link)library.link.signal=undefined;
    if(updater?.link)updater.link.signal=undefined;
    if(connecting===attempt)connecting=undefined;
  }
  function cancelConnection(){connecting?.controller.abort(Error('Connection cancelled.'));}
  async function requestMidiAccess(report=status,signal) {
    signal?.throwIfAborted();
    if(!navigator.requestMIDIAccess)throw Error('This browser does not support Web MIDI. Use desktop Chrome or Edge');
    let finished=false;
    report('Requesting MIDI access and initializing ports. If prompted, allow MIDI / SysEx.');
    navigator.permissions?.query({name:'midi',sysex:true}).then(result=>{
      if(!finished&&result.state==='granted')report('MIDI permission is allowed. Waiting for the browser to initialize device ports…');
    }).catch(()=>{});
    if(!midiRequest){
      const pending=navigator.requestMIDIAccess({sysex:true}).then(access=>{
        if(!access.sysexEnabled)throw Error('Allow MIDI / SysEx in your browser');return access;
      });
      midiRequest=pending;
      pending.catch(()=>{if(midiRequest===pending)midiRequest=undefined;});
    }
    const request=midiRequest;
    try {
      const access=await FM1Web.abortable(request,signal);
      report('Searching for SMK37 OPEN and connecting…');return access;
    } catch(error){if(midiRequest===request)midiRequest=undefined;throw error;}
    finally {finished=true;}
  }
  const patchTarget=(id='patch-track')=>{const select=$(id),node=select.selectedOptions[0],track=Number(select.value);return node&&!node.disabled&&select.value!==''&&Number.isInteger(track)&&track>=0&&track<8?track:-1;};
  let deviceState={mode:'offline',epoch:0,busy:false},statusLink,connectionNotice;
  function createLibrary(access){
    const next=new FM1Web.Library(access);
    next.onProjectChange=()=>document.dispatchEvent(new Event('fm1-device-project-change'));
    return next;
  }
  const enable=()=>{
    const locked=busy||finishingUpdate||SMK37Boot.blocked;
    $('connect').disabled=locked||!pkg||!navigator.requestMIDIAccess; $('install').disabled=locked||!connected||migration||!updater?.link||updater.link.lost||same||!$('backup').checked; $('backup').disabled=locked||!pkg;
    $('force-update').disabled=locked||!pkg||pkg.kind==='stock';
    $('stock-restore').disabled=locked||!openPkg||!FM1_PACKAGE?.stock;
    $('stock-restore').hidden=pkg?.kind==='stock';$('open-firmware').hidden=pkg?.kind!=='stock';
    $('open-firmware').disabled=locked;$('stock-warning').hidden=pkg?.kind!=='stock';
    /* Task 14: the force-activate button is gone from the page; force flash is only the checkbox in the migration section. */
    FM1I18n.text($('update-next'),SMK37Boot.blocked?'Page resources are incomplete. Reload the page.':!pkg?'':finishingUpdate?'Firmware updated. Verifying the version…':busy?'Device operation in progress. Please wait.':updateResult==='stock'?'Factory firmware and resources restored; resource read-back passed. Power-cycle the device before use.':updateResult==='ready'?
      'Update complete. Your SMK37 OPEN is ready to use; no further flashing is needed.':!connected||migration?
      (forceSuggested?'Different firmware detected. To migrate, tick Force flash by hand under Migration, factory restore and forced updates.':'Next: connect the device.'):
      same?'This firmware is already installed; no need to flash again.':!$('backup').checked?'Next: confirm that your work is backed up before flashing.':pkg.kind==='stock'?'Next: restore factory V16 for this model. Confirm to start writing.':$('force-update').checked?
      'Next: click Force flash, then read and confirm the compatibility risks.':'Next: click Start update.');
    FM1I18n.text($('install'),pkg?.kind==='stock'?'Install factory V16':$('force-update').checked?'Force flash':'Start update');
    $('library-connect').disabled=locked||!navigator.requestMIDIAccess;
    $('quick-connect').disabled=!connecting&&(locked||!navigator.requestMIDIAccess||(!$('tab-update').hidden&&!pkg));
    FM1I18n.text($('quick-connect'),connecting?'Cancel connection':'Connect device');
    const disconnected=!library?.link||library.link.lost;
    const unavailable=locked||disconnected||!libraryReady;
    for(const control of document.querySelectorAll('[data-library]'))control.disabled=unavailable;
    $('library-refresh').disabled=locked||disconnected;
    $('patch-import').disabled=unavailable||patchTarget()<0||!voices.length;
    $('patch-export').disabled=unavailable||patchTarget()<0;
    $('project-import').disabled=unavailable||!projectBytes;
    $('timbre-import').disabled=unavailable||!timbreBytes;
    const link=!disconnected?library.link:connected&&!updater?.link?.lost?updater?.link:undefined;
    const mode=!disconnected?'library':link?'update':'offline';
    deviceState={mode,epoch:deviceState.epoch+(statusLink!==link?1:0),busy:locked,connection:connectionNotice};statusLink=link;
    document.dispatchEvent(new CustomEvent('fm1-device-state',{detail:deviceState}));
  };
  document.addEventListener('fm1-view-change',enable);
  document.addEventListener('smk37-script-error',enable);
  const status=(text,progress)=>{ FM1I18n.text($('status'),text); if(progress===null)$('progress').removeAttribute('value');else if(progress!==undefined)$('progress').value=progress; };
  function clearUpdateConnection(text){
    connected=false;same=false;migration=false;forceSuggested=false;updateResult='';
    $('device-identity').textContent='';FM1I18n.text($('error'),'');status(text,0);
    showLoaderHint(null);   /* Task 12 A5 */
  }
  /* Task 12 A5: the builds index (builds/index.json) is looked up only when a loader reports another
     build's tag. The candidates cover the main page (./builds/), a builds/<tag>/ page (../) and the
     probe64/ or recover/ pages (../builds/); file:// pages find none and the message says so. */
  const buildsLookup=FM1Web.buildsLookup(['./builds/index.json','../index.json','../builds/index.json'].map(u=>{try{return new URL(u,location.href).href;}catch(_){return u;}}));
  function showLoaderHint(error){
    const box=$('loader-hint');box.replaceChildren();box.hidden=!(error&&error.code==='LOADER_MISMATCH');
    if(box.hidden)return;
    const label=document.createElement('strong');
    if(error.build&&error.build.url){
      FM1I18n.text(label,'That build\'s page:');
      const link=document.createElement('a');link.href=error.build.url;link.target='_blank';link.rel='noopener noreferrer';
      link.textContent=(error.build.tag||'')+' — '+error.build.url;box.append(label,' ',link);
    }else if(error.indexUrl){
      FM1I18n.text(label,'The list of published builds:');
      const link=document.createElement('a');link.href=new URL('./',error.indexUrl).href;link.target='_blank';link.rel='noopener noreferrer';
      link.textContent=link.href;box.append(label,' ',link);
    }else{FM1I18n.text(label,'Disconnect any other SMK-37 before connecting.');box.append(label);}
  }
  function connectionChanged(){
    if(busy||finishingUpdate)return;
    connectionNotice=undefined;
    if(connected&&updater?.link?.lost)clearUpdateConnection('Device disconnected. Please reconnect.');
    if(library?.link?.lost){libraryReady=false;message('Device disconnected. Reconnect the project library.');}
    enable();
  }
  function watch(access){if(watchedAccess)watchedAccess.removeEventListener('statechange',connectionChanged);watchedAccess=access;access.addEventListener('statechange',connectionChanged);}
  $('backup').addEventListener('change',enable);
  async function setForceMode(value,reconnect=connected||!!(updater?.link&&!updater.link.lost)){
    if(busy||finishingUpdate)return false;
    busy=true;clearUpdateConnection('Flashing mode changed. Reconnect the device.');
    $('force-update').checked=value;$('force-warning').hidden=!value;enable();
    try{
      if(updater)await updater.disconnect();
    }catch(error){FM1I18n.text($('error'),error.message);return false;}
    finally{busy=false;enable();}
    if(reconnect)await connectDevice();
    return true;
  }
  $('force-update').addEventListener('change',()=>setForceMode($('force-update').checked));
  $('patch-track').addEventListener('change',enable);
  window.addEventListener('beforeunload',event=>{if(writing){event.preventDefault();event.returnValue='';}});
  /* Task 11B: when no port is named like the SMK-37, or several answered, the updater sends
     nothing more and the user picks the device's input here; the next Connect uses only it. */
  function showPortChoices(choices=[]){
    const select=$('update-port'),keep=select.value;
    while(select.options.length>1)select.remove(1);
    for(const choice of choices){const option=document.createElement('option');option.value=choice.id;
      option.textContent=choice.name+(choice.identity?' — '+choice.identity:'');select.append(option);}
    select.value=choices.some(choice=>choice.id===keep)?keep:'';$('port-pick').hidden=!choices.length;
  }
  function showConnectionDetails(diagnostics){
    const box=$('connection-details');box.hidden=!diagnostics;box.open=!!diagnostics;
    for(const kind of ['inputs','outputs','identities','expected','attempts']){
      const list=$('connection-'+kind);list.replaceChildren();
      const entries=diagnostics?.[kind]||[];
      if(!entries.length){const item=document.createElement('li');FM1I18n.text(item,'None');list.append(item);}
      for(const entry of entries){
        const item=document.createElement('li');
        if(kind==='attempts'){
          item.append(document.createTextNode(entry.input+' → '+entry.output+': '));
          const reason=document.createElement('span');FM1I18n.text(reason,entry.error);item.append(reason);
        }else item.textContent=entry;
        list.append(item);
      }
    }
  }
  async function connectDevice(){
    if(busy||finishingUpdate||SMK37Boot.blocked||!pkg)return;
    busy=true;clearUpdateConnection('Searching for SMK37 OPEN and connecting…');showConnectionDetails(null);
    const report=text=>{status(text);connectionNotice={message:text,failed:false};enable();};
    report('Searching for SMK37 OPEN and connecting…');
    let attemptUpdater;const attempt=beginConnection(),signal=attempt.controller.signal;
    try {
      if(library){libraryReady=false;await library.disconnect();message('Switched to firmware update. Reconnect to use the project library.');}
      if(updater)await updater.disconnect();
      const access=await requestMidiAccess(report,signal);
      watch(access);
      updater=new FM1Web.Updater(access,pkg,(text,value)=>status(
        pkg.kind!=='stock'&&value===100?'Firmware written. Verifying the version…':text,
        pkg.kind!=='stock'&&typeof value==='number'?value*0.8:value),{},{builds:buildsLookup});   /* Task 12 A5 */
      attemptUpdater=updater;
      /* Task 11B: the port the user picked from #update-port, if any (CHOOSE_PORT below). */
      const device=await updater.connect({force:$('force-update').checked,signal,pick:$('update-port').value||null}); connected=true;same=!!device.same;migration=!!device.migration;forceSuggested=migration;
      $('device-identity').textContent=device.identity;
      status(migration?'Device and current firmware recognized (not Open firmware). To migrate, open Migration, factory restore and forced updates, tick Force flash by hand, then connect again.':same?'This version is already installed. No update is needed.':device.resume?'Loader connected; hardware model unverified. Check the device label before writing.':pkg.kind==='stock'?'Device connected; ready to restore factory V16.':$('force-update').checked?'Connected. Confirm the device and compatibility risks before force flashing.':'SMK37 OPEN connected. Ready to update');
      connectionNotice=undefined;
    }catch(error){connectionNotice={message:error.message,failed:true};showConnectionDetails(attemptUpdater?.diagnostics);forceSuggested=false;   /* Task 12 (2026-11-09): an error never suggests force */if(error.code==='CHOOSE_PORT')showPortChoices(error.choices);FM1I18n.text($('error'),error.message);showLoaderHint(error);status('Not connected');if(error.identity)$('device-identity').textContent=error.identity;}
    finally{await endConnection(attempt);busy=false;enable();}
  }
  $('connect').addEventListener('click',connectDevice);
  /* Task 12 (2026-11-09): the "Enable force flash and reconnect" button is gone (it was offered after a query timeout on 2026-11-09). */
  function packageDetails(){
    FM1I18n.text($('update-intro'),pkg.kind==='stock'?'Connect this model, confirm your backup, then click Install factory V16.':'Connect SMK37 OPEN, confirm your backup, then click Start update.');
    FM1I18n.text($('profile'),'SMK37 '+(pkg.model==='elite'?'Elite':'Pro')+(pkg.kind==='stock'?' Factory V16':' Open'));
    $('firmware-version').textContent=pkg.display_version||pkg.release_version||'—';   // Task 08: the display version
    $('base-version').textContent=pkg.release_version||'—';                              // the Open label stays in the details
    FM1I18n.text($('version'),pkg.build_id.slice(0,16));$('version').title=pkg.build_id;
    FM1I18n.text($('size'),(pkg.bytes/1024).toFixed(1)+' KiB');
  }
  async function chooseFirmware(stock){
    if(busy||finishingUpdate||!openPkg)return;
    const reconnect=connected;busy=true;clearUpdateConnection('Firmware target changed. Check the version and your backup.');enable();
    try{
      if(updater)await updater.disconnect();
      if(library){libraryReady=false;await library.disconnect();}
      if(stock&&!stockPkg){status('Loading factory firmware…');stockPkg=await FM1Web.prepare(FM1_PACKAGE.stock);}
      pkg=stock?stockPkg:openPkg;$('backup').checked=false;$('force-update').checked=stock;
      $('force-warning').hidden=true;packageDetails();status('Firmware verified. Waiting for device connection');
    }catch(error){FM1I18n.text($('error'),error.message);return;}
    finally{busy=false;enable();}
    if(reconnect)await connectDevice();
  }
  $('stock-restore').onclick=()=>chooseFirmware(true);
  $('open-firmware').onclick=()=>chooseFirmware(false);
  const message=text=>{FM1I18n.text($('library-status'),text);if($('device-save-dialog').open)FM1I18n.text($('device-save-status'),text);};
  const perform=async(action)=>{
    if(busy||finishingUpdate||SMK37Boot.blocked)return;busy=true;connectionNotice=undefined;enable();
    try{await action();}catch(error){message(error.message);}finally{busy=false;enable();}
  };
  const option=(value,text)=>{const node=document.createElement('option');node.value=String(value);FM1I18n.text(node,text);return node;};
  async function deviceProject(action,refresh=false,duringUpdate=false,signal) {
    signal?.throwIfAborted();
    if(SMK37Boot.blocked)throw Error('Page resources are incomplete. Reload the page.');
    if(busy||(finishingUpdate&&!duringUpdate))throw Error('A device operation is already in progress');busy=true;connectionNotice=undefined;enable();
    try {
      if(connected){clearUpdateConnection('Switched to the project library. Reconnect before updating firmware.');if(updater)await updater.disconnect();}
      if(!library?.link||library.link.lost){
        const attempt=beginConnection(),abort=()=>attempt.controller.abort(signal.reason);
        signal?.addEventListener('abort',abort,{once:true});
        try {
          signal?.throwIfAborted();
          libraryReady=false;if(library)await library.disconnect();const access=await requestMidiAccess(message,attempt.controller.signal);
          watch(access);library=createLibrary(access);await library.connect({signal:attempt.controller.signal});
        } finally {signal?.removeEventListener('abort',abort);await endConnection(attempt);}
      }
      signal?.throwIfAborted();
      const result=await action(library);
      if(refresh)await refreshLibrary(true);
      message('Device operation completed.');return result;
    } finally {busy=false;enable();}
  }
  const saveDialog=$('device-save-dialog');let saveBytes,saveRunning=false,saveOpening=false,saveReturnFocus;
  function saveStatus(text){FM1I18n.text($('device-save-status'),text);}
  async function openSave(bytes){
    if(busy||finishingUpdate||saveOpening||saveRunning)throw Error('A device operation is already in progress');
    saveOpening=true;saveBytes=bytes?.slice();saveReturnFocus=document.activeElement;
    const selected=!bytes?$('project-slot').value:'';
    FM1I18n.text($('device-save-source'),bytes?'Write the current browser project to SMK37 OPEN, replacing the device workspace.':'Save the current SMK37 OPEN workspace to the selected device project slot.');
    $('device-save-confirm').disabled=true;$('device-save-slot').disabled=true;
    $('device-save-slot').replaceChildren();saveStatus('Connecting and reading device project slots…');saveDialog.showModal();
    try{
      await deviceProject(async()=>{},true);
      if(!saveDialog.open)return;
      for(const node of $('project-slot').options)$('device-save-slot').append(option(node.value,node.textContent));
      $('device-save-slot').value=selected||$('project-slot').value;
      $('device-save-confirm').disabled=false;$('device-save-slot').disabled=false;
      saveStatus('Choose a save location. Its existing content will be replaced.');$('device-save-slot').focus();
    }catch(error){saveStatus(error.message);}finally{saveOpening=false;}
  }
  function closeSave(){if(saveRunning)return;if(saveOpening)cancelConnection();saveDialog.close();saveBytes=undefined;saveReturnFocus?.focus();}
  $('device-save-cancel').onclick=closeSave;
  saveDialog.addEventListener('cancel',event=>{event.preventDefault();closeSave();});
  $('device-save-confirm').onclick=async()=>{
    if(saveRunning||busy||finishingUpdate)return;const slot=Number($('device-save-slot').value);
    saveRunning=true;writing=true;$('device-save-confirm').disabled=true;
    $('device-save-slot').disabled=true;$('device-save-cancel').disabled=true;
    saveStatus('Writing and verifying by reading back. Keep the device connected…');
    try{
      const saved=await deviceProject(l=>l.saveProject(slot,saveBytes));
      document.dispatchEvent(new CustomEvent('fm1-device-project-saved',{detail:{bytes:saved}}));
      saveStatus('Saved to device slot '+(slot+1)+'; read-back verification passed.');
      message('Saved to device slot '+(slot+1)+'; read-back verification passed.');
      saveBytes=undefined;FM1I18n.text($('device-save-cancel'),'Done');
    }catch(error){saveStatus('Save could not be confirmed: '+error.message);$('device-save-confirm').disabled=false;$('device-save-slot').disabled=false;}
    finally{saveRunning=false;writing=false;$('device-save-cancel').disabled=false;}
  };
  saveDialog.addEventListener('close',()=>{FM1I18n.text($('device-save-cancel'),'Cancel');});
  $('quick-connect').addEventListener('click',()=>connecting?cancelConnection():$('tab-update').hidden?connectLibrary():connectDevice());
  $('about-open').onclick=()=>$('about-dialog').showModal();
  // Classic Tabby Task 11: a package whose USER size is not the stock 536576 (the probe) or a
  // diagnostic build says so at the top of the update tab and in the page title.
  // Task 12 A1: 471040 is the normal layout from tabby-v04.0. A package with it says plainly that
  // installing it over tabby-v03.x (or V01 / V16) moves the storage; a 536576 package (the old
  // layout, the way back) says the reverse. Neither is a test build any more; the title changes
  // only for a diagnostic build.
  if(typeof FM1_PACKAGE==='object'&&FM1_PACKAGE&&(FM1_PACKAGE.user_bytes||FM1_PACKAGE.diag)){
    const w=$('layout-warning'),size=FM1_PACKAGE.user_bytes,notes=[];
    if(size===471040)notes.push('This release moves the device storage (USER 471040 bytes; tabby-v03.x, V01 and V16 use 536576). Coming from one of those: make a Full backup first (Projects & sounds tab) and keep it. After the install your projects, device settings and songs are gone until you run Full restore and Verify. Bluetooth pairings are lost once. If ACTIONS shows OLD DATA, erase it (with confirmation) before restoring. Going back to tabby-v03.x moves the storage back the same way: back up, install, restore.');
    else if(size&&size!==471040)notes.push('This build uses the older storage layout (USER '+size+' bytes; tabby-v04.0 and later use 471040). Installing it over tabby-v04.0 or later moves the storage back: make a Full backup first, then Full restore and Verify after the install.');
    if(FM1_PACKAGE.diag)notes.push('Diagnostic build: adds command 26, the remote ACTIONS / song commands for unattended hardware runs. The timing counters are in every build.');
    if(notes.length){w.textContent=notes.join(' ');w.hidden=false;}
    if(FM1_PACKAGE.diag)document.title='DIAGNOSTIC BUILD · '+document.title;
  }
  /* Classic Tabby (Task 03 a): no sample bank on the device. The post-update sample check
     is a no-op that reports the firmware as ready. */
  globalThis.FM1Workbench={state:()=>deviceState,read:()=>deviceProject(l=>l.download(0)),write:bytes=>deviceProject(l=>l.upload(0,0,bytes)),save:openSave};
  async function checkDeviceSamples(afterUpdate=false){
    if(busy||finishingUpdate&&!afterUpdate)return;
    updateResult=afterUpdate?'ready':'checked';
    status(afterUpdate?'Firmware ready.':'Device ready.',100);enable();
  }
  async function refreshLibrary(initial=false) {
    libraryReady=false;
    const info=await library.query(0);
    if(info.length!==14||info[1]!==16||info[2]>=16||!((info[0]===3&&info[3]===208&&info[4]===15)||(info[0]===4&&info[3]===224&&info[4]===15))||info.slice(6).some(source=>source>5))throw Error('Invalid device project-library information');
    const previous=Number($('project-slot').value),selected=initial||$('project-slot').value===''||!Number.isInteger(previous)||previous<0||previous>=16?info[2]:previous;
    const slots=[];
    for(let slot=0;slot<info[1];slot++){
      const name=await library.query(9,[slot],true);
      slots.push(option(slot,(slot+1)+' · '+String.fromCharCode(...name).trim()));
    }
    const working=await library.download(0);
    if(working.length!==(library.tuningBytes||(info[3]|info[4]<<8)))throw Error('Invalid device file length');
    FM1Web.projectVersion(working);
    // Task 06 (a): the Bluetooth settings panel replaces the device's BLE page.
    $('radio-group').hidden=!library.radioSettings;
    $('diag-group').hidden=!library.diagCounters;   // Task 11: the counters; every build from tabby-v04.0 (Task 12 A4)
    if(library.radioSettings){const r=await library.radioRead();$('radio-on').checked=r.on;$('radio-audio').checked=r.audio;$('radio-role').value=r.host?'1':'0';}
    // Publish a complete snapshot only after every query succeeds. A partial
    // list must never enable load/save/import with an empty selection.
    $('project-slot').replaceChildren(...slots);
    $('project-slot').value=String(selected);
    const sources=['DX7','303','808','PSG','Pluck','Sampler'];
    const toneTrack=$('timbre-track').value||'0';$('timbre-track').replaceChildren();
    for(let i=0;i<8;i++)$('timbre-track').append(option(i,'Track '+(i+1)+' · '+(sources[info[6+i]]||'Unknown')));
    $('timbre-track').value=toneTrack;
    const first=Array.from(info.slice(6)).findIndex(type=>type===0);
    for(const id of ['patch-track']){
      const track=Number($(id).value||0);$(id).replaceChildren();
      for(let i=0;i<8;i++){
        const node=option(i,'Track '+(i+1)+' · '+(sources[info[6+i]]||'Unknown'));node.disabled=info[6+i]!==0;$(id).append(node);
      }
      $(id).value=String(info[6+track]===0?track:first);
    }
    $('project-name').value=String.fromCharCode(...working.slice(3836,3848)).trimEnd();
    libraryReady=true;
  }
  function saveFile(bytes,name) {
    const url=URL.createObjectURL(new Blob([bytes],{type:'application/octet-stream'})),a=document.createElement('a');
    a.href=url;a.download=name;document.body.append(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(url),1000);
  }
  function connectLibrary(){return perform(async()=>{
    const report=text=>{message(text);connectionNotice={message:text,failed:false};enable();};
    report('Searching for SMK37 OPEN and connecting…');
    const attempt=beginConnection(),signal=attempt.controller.signal;
    try{
      libraryReady=false;clearUpdateConnection('Switched to the project library. Reconnect before updating firmware.');if(updater)await updater.disconnect();if(library)await library.disconnect();
      const access=await requestMidiAccess(report,signal);
      watch(access);
      library=createLibrary(access);await library.connect({signal});await refreshLibrary(true);message('Project library connected.');connectionNotice=undefined;
      await songOldDataCheck().catch(()=>{});   /* Task 12 A1 */
    }catch(error){connectionNotice={message:error.message,failed:true};
      /* Task 11C: no matching port (NO_PORT) or a failed probe: list the ports the browser sees. */
      showConnectionDetails(library?.diagnostics||error.ports||null);throw error;}
    finally{await endConnection(attempt);}
  });}
  $('library-connect').addEventListener('click',connectLibrary);
  // Task 06 (a): Bluetooth settings (transfer command 24). Each change is written at once.
  const radioMessage=text=>{$('radio-message').textContent=text?FM1I18n.t(text):'';};
  const radioWrite=async()=>{try{await library.radioWrite({on:$('radio-on').checked,audio:$('radio-audio').checked,host:$('radio-role').value==='1'});radioMessage('Bluetooth settings written to the device.');}catch(error){radioMessage(error.message);}};
  for(const id of ['radio-on','radio-audio','radio-role'])$(id).addEventListener('change',radioWrite);
  $('radio-forget').addEventListener('click',async()=>{if(!confirm(FM1I18n.t('Forget the BLE MIDI pairs stored on the device?')))return;try{await library.radioForget();radioMessage('MIDI pairs forgotten; remove the pairing on the computer or tablet too, then pair again.');}catch(error){radioMessage(error.message);}});
  $('library-refresh').addEventListener('click',()=>perform(async()=>{await refreshLibrary();message('Project and track lists refreshed.');}));
  // Classic Tabby Task 11 (Step 2): full backup, restore and verify (FM1Web Library.fullBackup /
  // fullRestore / fullVerify; docs/BACKUP-FORMAT.md). Restore validates the whole file before it
  // writes anything and writes only through the transfer commands.
  const backupMessage=text=>{$('backup-message').textContent=text||'';};
  const backupNotes=list=>{$('backup-notes').replaceChildren(...(list||[]).map(t=>{const li=document.createElement('li');li.textContent=t;return li;}));};
  let backupText=null;
  const backupProgress=label=>value=>backupMessage(label+' '+Math.round(value*100)+' %');
  $('backup-make').addEventListener('click',()=>perform(async()=>{
    backupNotes([]);
    const rig=globalThis.TabbyRig?TabbyRig.rigLoad():null;
    const file=await library.fullBackup(backupProgress('Reading the device…'),{workbench:FM1_SIMULATOR&&FM1_SIMULATOR.display_version||null,rig});
    const stamp=file.created.replace(/[:]/g,'-').replace(/\..*/,'');
    saveFile(new TextEncoder().encode(JSON.stringify(file)),'classic-tabby-backup-'+stamp+'.json');
    backupMessage('Full backup saved: '+file.counts.projects+' projects, '+file.counts.songs+' songs, '+file.counts.blocks+' blocks (USER '+file.device.user_bytes+'). Keep this file.');
    backupNotes(['Not in the file:'].concat(file.not_included));
    await refreshLibrary();
  }));
  $('backup-file').addEventListener('change',async()=>{
    backupText=null;backupNotes([]);const file=$('backup-file').files[0];if(!file)return;
    try{const text=await file.text();const b=FM1Web.backupParse(text);backupText=text;
      backupMessage('File checked: '+b.file.counts.projects+' projects, '+b.file.counts.songs+' songs, '+b.file.counts.blocks+' blocks, made '+b.file.created+' on USER '+b.device.user_bytes+(b.device.build_id?' (build '+b.device.build_id.slice(0,12)+')':'')+'.');}
    catch(error){backupMessage('Refused: '+error.message);}
  });
  $('backup-restore').addEventListener('click',()=>perform(async()=>{
    if(!backupText)throw Error('Choose a full backup file first.');
    const b=FM1Web.backupParse(backupText);
    const plan='Replace the device contents with this backup?\n\n- Project slots written: '+b.projects.filter(p=>p.bytes).map(p=>p.slot+1).join(', ')+
      '\n- Songs written: '+(b.songs.filter(s=>!s.empty).map(s=>s.slot+1).join(', ')||'none')+'; song slots empty in the file are deleted on the device'+
      '\n- Device settings: '+(b.settings.kind8?'yes':'not in the file')+'\n\nThe file was made on USER '+b.device.user_bytes+'; this device runs USER '+library.userBytes+'.';
    if(!confirm(plan))return;
    const result=await library.fullRestore(b,backupProgress('Restoring…'));
    if($('backup-rig').checked&&b.rig&&globalThis.TabbyRig){try{TabbyRig.rigSave(TabbyRig.rigNormalize(b.rig));result.notes.push('"My rig" from the file is saved in this browser; reload the page to see it in the rig panel.');}catch(error){result.notes.push('The file\'s rig could not be read: '+error.message);}}
    backupMessage('Restore written. Verifying…');
    const v=await library.fullVerify(b,backupProgress('Verifying…'));
    backupMessage(v.pass?'Verify PASS: '+v.checked+' items identical to the file.':'Verify FAIL: '+v.difference);
    backupNotes(result.notes.concat(v.notes));
    await refreshLibrary();
  }));
  $('backup-verify').addEventListener('click',()=>perform(async()=>{
    if(!backupText)throw Error('Choose a full backup file first.');
    const v=await library.fullVerify(backupText,backupProgress('Verifying…'));
    backupMessage(v.pass?'Verify PASS: '+v.checked+' items identical to the file.':'Verify FAIL: '+v.difference);backupNotes(v.notes);
    await refreshLibrary();
  }));
  // Task 11 (Step 3): the diagnostic build's counters (transfer command 25).
  let diagText='';
  const diagShow=d=>{diagText=FM1Web.diagText(d);$('diag-output').textContent=diagText;};
  $('diag-read').addEventListener('click',()=>perform(async()=>{diagShow(await library.diagRead(false));}));
  $('diag-reset').addEventListener('click',()=>perform(async()=>{diagShow(await library.diagRead(true));message('Counters reset.');}));
  $('diag-copy').addEventListener('click',()=>{if(diagText&&navigator.clipboard)navigator.clipboard.writeText(diagText).catch(()=>{});});

  $('project-rename').addEventListener('click',()=>perform(async()=>{
    const name=$('project-name').value;if(!/^[\x20-\x7e]{1,12}$/.test(name))throw Error('Use 1–12 printable ASCII characters for the name');
    await library.query(10,Array.from(name.padEnd(12),c=>c.charCodeAt(0)));message('Name changed. Save the project to keep it.');
  }));
  $('project-save').addEventListener('click',()=>openSave().catch(error=>message(error.message)));
  $('project-load').addEventListener('click',()=>perform(async()=>{
    const slot=Number($('project-slot').value);
    await library.query(8,[slot]);await refreshLibrary();message('Project loaded.');
  }));
  $('project-export').addEventListener('click',()=>perform(async()=>{
    const data=await library.download(0);saveFile(FM1Web.projectFile(data),'SMK37 OPEN-project.fm1');message('Current project exported as a backup file.');
  }));
  $('project-file').addEventListener('change',()=>perform(async()=>{
    projectBytes=undefined;const file=$('project-file').files[0];if(!file)return;
    if(file.size>4280)throw Error('Project backup file is too large');projectBytes=FM1Web.readProjectFile(new Uint8Array(await file.arrayBuffer()));message('Backup verified. Ready to restore to the workspace.');
  }));
  $('project-import').addEventListener('click',()=>perform(async()=>{
    if(!projectBytes||!confirm(FM1I18n.t('Replace the unsaved workspace with this backup? Device project slots will not be overwritten automatically.')))return;
    await library.upload(0,0,projectBytes);await refreshLibrary();message('Project restored to the workspace. Choose a slot and save it.');
  }));
  $('timbre-file').addEventListener('change',()=>perform(async()=>{
    timbreBytes=undefined;const file=$('timbre-file').files[0];if(!file)return;
    if(file.size!==239)throw Error('Choose a .fm1t sound exported by this version');
    timbreBytes=FM1Web.readTimbreFile(new Uint8Array(await file.arrayBuffer()));message('Sound verified. Ready to import to the selected track.');
  }));
  $('timbre-import').addEventListener('click',()=>perform(async()=>{
    if(!timbreBytes)throw Error('Choose a sound file first');
    const track=Number($('timbre-track').value);
    if(!confirm(FM1I18n.t('Replace track '+(track+1)+' engine and sound? Switching between drums and melody clears this track’s steps.')))return;
    await library.upload(2,track,timbreBytes);await refreshLibrary();message('Sound imported. Save the project for PROJECT tracks. For LIVE tracks, export a timbre file, or save DX7 voices to the independent library.');
  }));
  $('timbre-export').addEventListener('click',()=>perform(async()=>{
    const track=Number($('timbre-track').value);
    saveFile(FM1Web.timbreFile(await library.download(2,track)),'SMK37 OPEN-track-'+(track+1)+'.fm1t');message('Track sound exported.');
  }));
  $('patch-file').addEventListener('change',()=>perform(async()=>{
    voices=[];$('patch-choice').replaceChildren();const file=$('patch-file').files[0];if(!file)return;
    if(file.size>4104)throw Error('Choose a single-patch or 32-patch DX7 .syx file');
    voices=FM1Web.readVoices(new Uint8Array(await file.arrayBuffer()));
    voices.forEach((p,i)=>$('patch-choice').append(option(i,(i+1)+' · '+String.fromCharCode(...p.slice(145,155)).replace(/[^\x20-\x7e]/g,'?'))));
    message('Verified '+voices.length+' patches. Choose a patch and target DX7 track.');
  }));
  $('patch-import').addEventListener('click',()=>perform(async()=>{
    const track=patchTarget(),patch=voices[Number($('patch-choice').value)];
    if(!patch||track<0)throw Error('Choose a DX7 track and patch');
    if(!confirm(FM1I18n.t('Replace track '+(track+1)+' sound? Notes on this track will stop.')))return;
    await library.upload(1,track,patch);message('Sound imported. Save the project for PROJECT tracks. For LIVE tracks, export a timbre file, or save DX7 voices to the independent library.');
  }));
  $('patch-export').addEventListener('click',()=>perform(async()=>{
    const track=patchTarget();if(track<0)throw Error('Set a track to DX7, then refresh the list');
    const patch=await library.download(1,track);saveFile(FM1Web.voiceFile(patch,track===7?9:track),'SMK37 OPEN-track-'+(track+1)+'.syx');message('Patch exported as a DX7 .syx file.');
  }));

  // ---- Classic Tabby song editor (Task 03 d) --------------------------------------------
  const songEd={song:null,blocks:new Map(),slot:0};
  const songMessage=text=>FM1I18n.text($('song-message'),text);
  const songSim=()=>$('song-target').value==='sim';
  // `progress` (Task 02 Step 4) lets the MIDI importer show the write progress in its own
  // panel; `exists` returns the slot's record image (or null) without downloading blocks.
  const songBackend=(progress=p=>songMessage('Writing song '+Math.round(p*100)+'%'))=>{
    if(songSim()){const sim=globalThis.FM1Simulator;if(!sim||!sim.ready())throw Error('Start the simulator first');
      return {read:song=>sim.request('song-read',{song}).then(d=>d?{record:d.record,blocks:new Map(d.blocks)}:null),
        write:(song,record,blocks)=>sim.request('song-write',{song,record,blocks:[...blocks]}),
        remove:song=>sim.request('song-delete',{song}),status:()=>sim.request('song-status'),
        exists:song=>sim.request('song-read',{song}).then(d=>d?d.record:null)};}
    if(!library||!libraryReady)throw Error('Connect the project library first');
    return {read:song=>library.songRead(song,p=>songMessage('Reading song '+Math.round(p*100)+'%')),write:(song,record,blocks)=>library.songWrite(song,record,blocks,progress),
      remove:song=>library.songDelete(song),status:()=>library.songStatus(),
      exists:song=>library.download(5,song).catch(error=>{if(error.deviceCode===1)return null;throw error;})};
  };
  // Task 04: the rig setup and the row event editor (web/rig/, inlined by build-web.py) edit
  // song.events in place; the write and export paths take the list with the rig's gaps applied.
  // Task 09: the device library is built once and shared with the importer, which maps parts by the rig.
  const deviceLibrary=globalThis.TabbyDevices?TabbyDevices.load(globalThis.FM1_DEVICES||[]):null;
  const rigUI=globalThis.TabbyRigUI&&globalThis.TabbyRig&&deviceLibrary&&$('rig-setup')&&$('song-events')
    ?TabbyRigUI.mount({setup:$('rig-setup'),events:$('song-events'),library:deviceLibrary,onChange:()=>{},message:text=>songMessage(text)}):null;
  // Task 02 Step 4: the MIDI importer (web/import/, inlined by build-web.py) mounts next to the
  // editor and writes through the same backend, so device and simulator targets behave alike.
  // Task 09: it reads the active rig (My rig, or the song's own copy) and the device library.
  if(globalThis.TabbyImportUI&&globalThis.TabbySongTransfer&&$('midi-import'))
    TabbyImportUI.mount($('midi-import'),{transfer:TabbySongTransfer.select({backend:songBackend,name:()=>songSim()?'simulator':'device'}),rig:()=>rigUI?rigUI.rig():null,library:deviceLibrary});
  for(let i=0;i<16;i++){$('song-slot').append(option(i,String(i+1)));$('song-project').append(option(i,String(i+1)));}
  for(let t=0;t<8;t++){const l=document.createElement('label');l.textContent='T'+(t+1)+' ';const i=document.createElement('input');i.type='number';i.min='0';i.max='16';i.step='1';i.dataset.songChannel=t;l.append(i);$('song-channels').append(l);}
  for(let s=0;s<64;s++){const l=document.createElement('label');l.textContent=(s+1)+' ';const i=document.createElement('input');i.type='text';i.dataset.songStep=s;i.placeholder='-';l.append(i);$('song-steps').append(l);
    i.addEventListener('focus',()=>songInspect(s));i.addEventListener('input',()=>{songMark(i);if(songEd.inspecting===s)songInspect(s);});}
  // Task 05: a step with an offset or a fractional length is marked; the inspector edits the focused step's notes.
  const SONG_UNITS=480;
  function songMark(i){let nudged=false;try{nudged=FM1Web.songStepParse(i.value).notes.some(n=>n.offset||n.length%SONG_UNITS);}catch(_){}i.classList.toggle('nudged',nudged);}
  function songInspect(s){
    const box=$('song-inspector'),input=$('song-steps').querySelector('input[data-song-step="'+s+'"]');songEd.inspecting=s;
    let step;try{step=FM1Web.songStepParse(input.value);}catch(error){box.hidden=false;box.textContent=error.message;return;}
    const bpm=Number($('song-tempo').value)||120,msPerUnit=TabbyTimedNote.unitMs(bpm);
    box.hidden=false;box.replaceChildren();
    const t=document.createElement('table'),head=document.createElement('tr');
    for(const h of ['Step '+(s+1),'Pitch','Velocity','Retrigger','Offset (units)','','Length (steps + units)','']){const th=document.createElement('th');th.textContent=h;head.append(th);}t.append(head);
    const write=()=>{input.value=FM1Web.songStepText(step);songMark(input);songInspect(s);};
    step.notes.forEach((n,k)=>{
      const tr=document.createElement('tr');const cell=el=>{const td=document.createElement('td');td.append(el);tr.append(td);return td;};
      const num=(value,min,max,stepv,on)=>{const i=document.createElement('input');i.type='number';i.min=min;i.max=max;i.step=stepv;i.value=value;i.addEventListener('change',()=>{on(Number(i.value));write();});return i;};
      cell(document.createTextNode(String(k+1)));
      cell(num(n.pitch,0,127,1,v=>{n.pitch=Math.max(0,Math.min(127,Math.round(v)));}));
      cell(num(n.velocity,1,127,1,v=>{n.velocity=Math.max(1,Math.min(127,Math.round(v)));}));
      const r=document.createElement('input');r.type='checkbox';r.checked=!!n.retrigger;r.addEventListener('change',()=>{n.retrigger=r.checked;write();});cell(r);
      cell(num(n.offset,-240,240,1,v=>{n.offset=Math.max(-240,Math.min(240,Math.round(v)));}));
      const ro=document.createElement('span');ro.className='readout';ro.textContent=TabbyTimedNote.offsetFraction(n.offset)+' steps · '+(n.offset*msPerUnit>=0?'+':'')+(n.offset*msPerUnit).toFixed(2)+' ms @ '+bpm;cell(ro);
      const steps=Math.floor(n.length/SONG_UNITS),rest=n.length%SONG_UNITS,len=document.createElement('span');
      len.append(num(steps,0,17476,1,v=>{n.length=Math.max(1,Math.max(0,Math.round(v))*SONG_UNITS+(n.length%SONG_UNITS));}),' + ',num(rest,0,479,1,v=>{n.length=Math.max(1,Math.floor(n.length/SONG_UNITS)*SONG_UNITS+Math.max(0,Math.min(479,Math.round(v))));}));cell(len);
      const rl=document.createElement('span');rl.className='readout';rl.textContent=FM1Web.songLengthText(n.length)+' steps · '+(n.length*msPerUnit).toFixed(1)+' ms';cell(rl);
      t.append(tr);});
    box.append(t);
    if(!step.notes.length){const p=document.createElement('p');FM1I18n.text(p,'No note on this step: type one in the box above, for example 60:100:1/-12');box.append(p);}
  }
  const songQuantize=mode=>{let changed=0;for(const i of $('song-steps').querySelectorAll('input')){if(!i.value.trim())continue;let step;try{step=FM1Web.songStepParse(i.value);}catch(_){continue;}
    for(const n of step.notes){const before=n.offset+':'+n.length;if(n.offset)n.offset=0;if(mode==='ends')n.length=Math.max(1,Math.round(n.length/SONG_UNITS))*SONG_UNITS;if(before!==n.offset+':'+n.length)changed++;}
    i.value=FM1Web.songStepText(step);songMark(i);}
    if(songEd.inspecting!==undefined)songInspect(songEd.inspecting);songMessage('Quantized '+changed+' notes (this block in the editor only; click Store block to keep them).');};
  $('song-quantize-starts').addEventListener('click',()=>songQuantize('starts'));
  $('song-quantize-ends').addEventListener('click',()=>songQuantize('ends'));
  const songBlockList=()=>FM1I18n.text($('song-blocks'),songEd.blocks.size?'Blocks in the editor: '+[...songEd.blocks.keys()].sort((a,b)=>a-b).join(', '):'There are no blocks in the editor.');
  function songRowsRender(){
    const body=$('song-rows').querySelector('tbody');body.replaceChildren();
    songEd.song.rows.forEach((row,r)=>{const tr=document.createElement('tr');const th=document.createElement('th');th.textContent=String(r+1);tr.append(th);
      const cell=(value,attrs,cls)=>{const td=document.createElement('td'),i=document.createElement('input');Object.assign(i,attrs);i.value=value;i.dataset.songRow=r;i.dataset.songField=cls;td.append(i);tr.append(td);};
      for(let t=0;t<8;t++)cell(row.block[t],{type:'number',min:'0',max:'65535',step:'1'},'b'+t);
      cell(row.repeat,{type:'number',min:'1',max:'64',step:'1'},'repeat');cell(row.steps,{type:'number',min:'16',max:'64',step:'16'},'steps');
      const td=document.createElement('td'),c=document.createElement('input');c.type='checkbox';c.checked=row.loopHere;c.dataset.songRow=r;c.dataset.songField='loop';td.append(c);tr.append(td);
      body.append(tr);});
    // Task 06: per track, the pattern numbers (rows with a block) the TRACK LAUNCH page offers.
    $('song-patterns').textContent=FM1I18n.t('Patterns per track (row numbers): ')+songEd.song.rows.length?Array.from({length:8},(_,t)=>'T'+(t+1)+' '+(songEd.song.rows.map((row,r)=>row.block[t]?String(r+1):'').filter(Boolean).join(' ')||'-')).join('   '):'';
  }
  function songRender(){
    const s=songEd.song;$('song-editor').hidden=!s;if(!s)return;
    $('song-name').value=s.name;$('song-project').value=String(s.project);$('song-tempo').value=String(s.tempo);$('song-loop').checked=s.loop;
    $('song-loop-row').value=String(s.loopRow+1);$('song-jump').value=s.jumpRow?'1':'0';$('song-swing').checked=!!s.swing;
    for(const i of $('song-channels').querySelectorAll('input'))i.value=String(s.channel[Number(i.dataset.songChannel)]);
    songRowsRender();songBlockList();
    if(rigUI)rigUI.setSong(s);
  }
  function songCollect(){
    const s=songEd.song;if(!s)throw Error('Read or create a song first');
    s.name=$('song-name').value;s.project=Number($('song-project').value);s.tempo=Number($('song-tempo').value)||0;s.loop=$('song-loop').checked;
    s.loopRow=Number($('song-loop-row').value)-1;s.jumpRow=$('song-jump').value==='1';s.swing=$('song-swing').checked;
    for(const i of $('song-channels').querySelectorAll('input'))s.channel[Number(i.dataset.songChannel)]=Number(i.value)||0;
    for(const i of $('song-rows').querySelectorAll('input')){const row=s.rows[Number(i.dataset.songRow)],f=i.dataset.songField;
      if(f==='loop')row.loopHere=i.checked;else if(f==='repeat')row.repeat=Number(i.value);else if(f==='steps')row.steps=Number(i.value);else row.block[Number(f.slice(1))]=Number(i.value)||0;}
    // Task 04: events with the rig's gaps applied; a song with events becomes a version-2 record.
    const record=FM1Web.songRecordBuild({...s,events:rigUI?rigUI.prepareEvents(s):(s.events||[])});
    for(const id of FM1Web.songBlockIds(s))if(!songEd.blocks.has(id))throw Error('Block '+id+' is used by a row but is not in the editor; save that block first');
    return record;
  }
  const songAct=fn=>async()=>{try{await fn();}catch(error){songMessage(error.message);}};
  $('song-target').addEventListener('change',()=>{songEd.song=null;songEd.blocks=new Map();songRender();songMessage('');});
  $('song-new').addEventListener('click',songAct(async()=>{songEd.song=FM1Web.songEmpty();songEd.blocks=new Map();songRender();songMessage('New empty song: fill in rows and blocks, then click Write song.');}));
  $('song-read').addEventListener('click',songAct(async()=>{
    const slot=Number($('song-slot').value),got=await songBackend().read(slot);
    if(!got){songEd.song=null;songEd.blocks=new Map();songRender();songMessage('This song slot is empty.');return;}
    songEd.song=FM1Web.songRecordParse(got.record);songEd.blocks=got.blocks;songRender();songMessage('Song read.');
  }));
  $('song-write').addEventListener('click',songAct(async()=>{
    const slot=Number($('song-slot').value),record=songCollect();
    // Task 03 (f): the shared write path deletes an occupied slot first; say so before writing.
    const old=await songBackend().exists(slot);
    if(!confirm(FM1I18n.t('Write song slot ')+(slot+1)+'?'+(old?'\n\n'+FM1I18n.t('This slot already holds a song: it is deleted before the write and its blocks are reclaimed at the next compaction. To keep the old song, cancel and export a .tabby first.'):'')))return;
    await songBackend().write(slot,record,songEd.blocks);songMessage(old?'Old song deleted; new song written and verified by read-back.':'Song written and verified by read-back.');
  }));
  $('song-delete').addEventListener('click',songAct(async()=>{
    const slot=Number($('song-slot').value);if(!confirm(FM1I18n.t('Delete song slot ')+(slot+1)+'?'))return;
    await songBackend().remove(slot);songMessage('Song deleted.');
  }));
  $('song-export').addEventListener('click',songAct(async()=>{
    const record=songCollect();saveFile(FM1Web.tabbyFile(record,songEd.blocks,rigUI?rigUI.trailer(songEd.song):null),'SMK37 OPEN-'+(songEd.song.name.trim()||'song').replace(/[^A-Za-z0-9-]+/g,'_')+'.tabby');songMessage('Exported the .tabby file.');
  }));
  $('song-file').addEventListener('change',songAct(async()=>{
    const file=$('song-file').files[0];if(!file)return;if(file.size>4096+2048*1608)throw Error('.tabby file too large');
    const got=FM1Web.readTabbyFile(new Uint8Array(await file.arrayBuffer()));songEd.song=FM1Web.songRecordParse(got.record);songEd.blocks=got.blocks;
    if(got.trailer&&got.trailer.rig&&globalThis.TabbyRig){try{songEd.song.rig=TabbyRig.rigNormalize(got.trailer.rig);}catch(_){songEd.song.rig=null;}}   // Task 04: per-song rig override
    songRender();
    songMessage('Imported the .tabby file into the editor; click Write song to upload it.');
  }));
  /* Task 12 A1: after the project library connects, say plainly when song storage holds OLD DATA
     and offer the erase. Nothing is sent until the user confirms the dialog. */
  async function songOldDataCheck(){
    const box=$('song-old-data');box.hidden=true;
    if(!library||!library.songStorage)return;
    const s=await library.songStatus();box.hidden=s.state!==2;
    $('song-erase-old').disabled=!(library.tabbyFlags&2);
    if(s.state===2&&!(library.tabbyFlags&2))songMessage('Song storage holds OLD DATA. This firmware cannot erase it from the web page: on the device, press SEQ and EDIT together for ACTIONS, choose ERASE OLD DATA, press the 4th button in the left group (after SHIFT, FADER BANK, HOME), then press it again to confirm.');
  }
  $('song-erase-old').addEventListener('click',songAct(async()=>{
    if(!library)throw Error('Connect the project library first');
    if(!confirm('Erase the old data in song storage?\n\nThis erases every song-storage sector that is not in the song format. Projects, tunings and device settings are kept. It cannot be undone. The device must be stopped.'))return;
    await library.eraseOldData();
    songMessage('Erasing old data on the device; this takes a few seconds. Click Storage status to check: it reports READY when done.');
    $('song-old-data').hidden=true;
  }));
  $('song-status').addEventListener('click',songAct(async()=>{
    const s=await songBackend().status();
    const words=['follow','launched','stopped'],queues=['','queued launch','queued stop','queued back to song'];
    const tracks=s.tracks?'; tracks: '+s.tracks.map((t,i)=>'T'+(i+1)+' '+words[t.state]+(t.row!==255?' r'+(t.row+1):'')+(t.queue?' ('+queues[t.queue]+')':'')+(t.waiting?' waiting':'')).join(', '):'';
    songMessage('Song storage: '+s.free+' bytes free, '+s.reclaimable+' bytes reclaimable'+(s.state===2?' (OLD DATA: erase it with Erase old data, or on the device in ACTIONS)':s.state===1?' (busy)':'')+(s.events?'; loaded song: '+s.events+' events, '+s.late+' late':'')+tracks+'.');
  }));
  $('song-row-add').addEventListener('click',songAct(async()=>{if(!songEd.song)throw Error('Read or create a song first');if(songEd.song.rows.length>=128)throw Error('At most 128 rows');
    const last=songEd.song.rows[songEd.song.rows.length-1];songEd.song.rows.push({block:last.block.slice(),repeat:last.repeat,loopHere:false,steps:last.steps});songRowsRender();}));
  $('song-row-remove').addEventListener('click',songAct(async()=>{if(!songEd.song||songEd.song.rows.length<=1)throw Error('Keep at least 1 row');songEd.song.rows.pop();songRowsRender();}));
  $('song-block-load').addEventListener('click',songAct(async()=>{
    const id=Number($('song-block-id').value),payload=songEd.blocks.get(id);
    const steps=payload?FM1Web.songPayloadParse(payload):Array.from({length:64},()=>({probability:0,alt:false,notes:[]}));
    for(const i of $('song-steps').querySelectorAll('input')){i.value=FM1Web.songStepText(steps[Number(i.dataset.songStep)]);songMark(i);}
    $('song-inspector').hidden=true;songEd.inspecting=undefined;
    songMessage(payload?'Block '+id+' loaded into the step editor.':'Block '+id+' does not exist yet: edit it, then click Store block to create it.');
  }));
  $('song-block-store').addEventListener('click',songAct(async()=>{
    const id=Number($('song-block-id').value);if(!(id>=1&&id<=65535))throw Error('Block id must be 1-65535');
    const steps=[];for(const i of $('song-steps').querySelectorAll('input'))steps[Number(i.dataset.songStep)]=FM1Web.songStepParse(i.value);
    songEd.blocks.set(id,FM1Web.songPayloadBuild(steps));songBlockList();songMessage('Block '+id+' saved in the editor; it is uploaded when you write the song.');
  }));
  $('song-block-remove').addEventListener('click',songAct(async()=>{const id=Number($('song-block-id').value);songEd.blocks.delete(id);songBlockList();songMessage('Block '+id+' removed from the editor.');}));
  $('install').addEventListener('click',async()=>{
    if(busy||finishingUpdate||SMK37Boot.blocked||!connected||migration||same||!$('backup').checked)return;
    const force=$('force-update').checked;
    const confirmedModel=updater.mode==='loader'?pkg.model:undefined;
    if(confirmedModel&&!confirm(FM1I18n.t('The loader name does not identify the hardware model. Check the device label and connect only the target device. Confirm that the hardware model is:')+' SMK-37 '+(confirmedModel==='pro'?'Pro':'Elite')+'?'))return;
    if(pkg.kind==='stock'){
      if(!confirm(FM1I18n.t('Restore factory V16? Open projects, voices and samples may be overwritten. Confirm you have backups. Target:')+' '+pkg.product+'\n\n'+FM1I18n.t('Restoring V16 also overwrites the last 40 KB of Classic Tabby song storage (block sectors 70 to 79 of the 80). Export your songs first in Projects & sounds > Song mode.')))return;
    }else if(force&&!confirm(FM1I18n.t('Force flash this device? Current identity: ')+updater.identity+'\n\n'+FM1I18n.t('Warning: incompatibility may cause data loss or prevent startup and require a recovery tool. Continue only if the target is an SMK37 OPEN and you accept these risks.')))return;
    busy=true;writing=true;enable();FM1I18n.text($('error'),'');
    let completed=false;
    try{await updater.install({force,confirmedModel});completed=true;}
    catch(error){FM1I18n.text($('error'),error.message);showLoaderHint(error);status('Update incomplete. Keep this page, check the device connection and retry',0);showConnectionDetails(updater.diagnostics);}
    finally{busy=false;writing=false;connected=false;finishingUpdate=completed;if(completed)$('device-identity').textContent=pkg.product;enable();}
    if(completed){
      if(pkg.kind==='stock'){
        updateResult='stock';finishingUpdate=false;status('Factory firmware and resources restored; resource read-back passed. Power-cycle the device before use.',100);enable();return;
      }
      await checkDeviceSamples(true);
    }
  });
  let firmwareTask;
  function loadFirmware(){
    if(firmwareTask)return firmwareTask;
    firmwareTask=(async()=>{
    try {
      if(!window.isSecureContext||!crypto.subtle)throw Error('Open this page over HTTPS or localhost');
      $('sample-bank-note').hidden=FM1_SIMULATOR.sample_bank!=='synthesized-demo';
      if(!FM1_PACKAGE){
        FM1I18n.text($('update-intro'),'The built-in firmware is missing, so this page cannot update SMK37 OPEN. Download the complete official workbench again.');
        FM1I18n.text($('profile'),'Browser play & edit');$('firmware-version').textContent=FM1_SIMULATOR.display_version||FM1_SIMULATOR.release_version||'—';$('base-version').textContent=FM1_SIMULATOR.release_version||'—';FM1I18n.text($('version'),FM1_SIMULATOR.sha256.slice(0,16));FM1I18n.text($('size'),'No device firmware included');
        status('Built-in firmware is unavailable. Download the complete official workbench again.');
        $('backup').disabled=true;enable();return;
      }
      FM1I18n.text($('error'),'');status('Loading firmware…');
      pkg=openPkg=await FM1Web.prepare(FM1_PACKAGE);
      packageDetails();
      if(!navigator.requestMIDIAccess)throw Error('This browser does not support Web MIDI. Use desktop Chrome or Edge');
      status('Firmware verified. Waiting for device connection');enable();
    }catch(error){firmwareTask=undefined;FM1I18n.text($('error'),error.message);status('Firmware could not be loaded. Reopen Device Update to retry.');}
    finally{enable();}
    })();return firmwareTask;
  }
  document.addEventListener('fm1-view-change',()=>{if(!$('tab-update').hidden)loadFirmware();});
  if(!FM1_PACKAGE||FM1_PACKAGE.data)loadFirmware();
  else {status('Firmware loads when Device Update is opened.');enable();}
})();
</script>
<script>
/*FM1_SIM_SCRIPT*/
</script>
<script>
/*FM1_SAMPLE_SCRIPT*/
</script>
</html>
