 "strip_items": [
  [
   "ARP: UP, DOWN, INCL, EXCL, RAND, ORDER, REPEAT, OCT+, LATCH, GATE+, GATE-, TAP, SWING+, SWING-, TEMPO+, TEMPO-, SYNC",
   "hold ARP, press the key (M-VAVE's manual)",
   "dead: holding ARP opens the ARP settings page; the knobs set rate, direction, range, gate, swing, hold. The key plays its note."
  ],
  [
   "RATE: 1/4, 1/4T, 1/8, 1/8T, 1/16, 1/16T, 1/32, 1/32T",
   "a held button and the key (the manual does not say which)",
   "dead: the arpeggiator's rate is K1 on the ARP page."
  ],
  [
   "GLOB: CHN 1 to CHN 16",
   "hold GLOBE, press the key (by the label; not in the manual)",
   "dead: holding GLOBE shows the mixer (pads mute and solo). Channels are on the MIDI TRACK page (KNOB BANK + SEQ)."
  ],
  [
   "PRE 1 to PRE 8",
   "as CHN",
   "dead: projects are chosen with K7 on the overview."
  ],
  [
   "SC: C, C#, D ... B",
   "a held button and the key (by the label: SCALE)",
   "dead: SCALE switches CLIPS and SCENES; there is no scale lock. The letters are also the names of those twelve keys."
  ],
  [
   "RESET",
   "a held button and the highest key",
   "dead: no key resets anything. Recovery is in the workbench."
  ]
 ],
