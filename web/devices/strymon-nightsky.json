 "midiIn": {
  "connector": "5-pin DIN MIDI IN and OUT, USB mini; optionally the 1/4 inch EXP jack in MIDI mode (Strymon MIDI EXP cable, tip active with an opto-isolator in the cable)",
  "trs": null,
  "note": "Use the DIN MIDI IN from the Thru5 WC: no EXP-jack setting needed. Third-party DIN-to-TRS cables do not work on the EXP jack. Set TRS MIDI Output to OFF when only receiving."
 },
 "clock": {
  "receives": true,
  "syncs": "the sequencer tempo only (no delay or pre-delay sync), enabled per preset",
  "setting": "Live Edit: hold PRESET BUTTONS 1 and 4, turn SPEED to green (RESPOND TO MIDI CLOCK), or CC 63 = 127; save the preset"
 },
 "channelSetting": "Power-up mode: hold INFINITE while connecting power, release when the footswitch LEDs light, turn SPEED until the ON LED blinks blue, send a program change on channel 14, press INFINITE to store. One FAQ says the 4..16 option needs a 1/4 inch MIDI connection to set; the manual does not: if the DIN path does not latch it, set it once over the EXP jack.",
 "channel": {
  "default": 1,
  "note": "Default 1; 1..16 (1..3 by LED colour, 4..16 by the next program change received while blinking blue). Wrong Room: 14."
 },
 "programChange": {
  "supported": true,
